# Parse only_codes option - a comma-delimited list of 5-digit integers:

sub parse_only_codes_option {
  my $value = shift;
  my $result = 0;

  if ( $only_codes ne '' ) {
    print STDERR "\nRedundant ONLY_CODES option\n";
  } else {
    my @parts = split( /,/, $value );
    my $part_count = @parts;
    $result = $part_count > 0;

    if ( ! $result ) {
      print STDERR "\nInvalid ONLY_CODES option\n";
    }

    for ( my $i = 0; $result && $i < $part_count; ++$i ) {
      my $part = $parts[ $i ];

      if ( length( $part ) == 5 && $part =~ m#^[1-9][0-9][0-9][0-9][0-9]$# )
      {
        $result = 1;
      } else {
        $result = 0;
      }

      # Construct only_codes = "88101,88500,88501,88502";

      if ( ! $result ) {
        print STDERR "\nInvalid codes in ONLY_CODES option\n";
      } else {

        if ( $only_codes eq '' ) {
          $only_codes = sprintf( "%d", $part );
        } else {
          $result = index( $only_codes, "$part" ) == -1;

          if ( ! $result ) {
            print STDERR "\nRedundant codes found in ONLY_CODES option\n";
          } else {
            $only_codes .= sprintf( ",%d", $part );
          }
        }
      }
    }
  }

  return $result;
}



# Check that only_codes are a subset of legitimate parameter codes for coverage:

sub only_codes_are_valid_subset {
  my $parameter_codes = shift;
  my $result = 0;
  my @parts = split( /,/, $only_codes );
  my $part_count = @parts;
  $result = $part_count > 0;

  emvl::debug( "checking parts = '@parts'" );

  if ( ! $result ) {
    print STDERR "\nInvalid ONLY_CODES option\n";
  }

  for ( my $i = 0; $result && $i < $part_count; ++$i ) {
    my $part = $parts[ $i ];
    $result = index( $parameter_codes, $part ) != -1;

    if ( ! $result ) {
      emvl::debug( "'$part' not in '$parameter_codes'." );
      print STDERR "\nInvalid codes in ONLY_CODES option\n";
    }
  }

  return $result;
}


# Construct command to run subsetter on local host reading temporary file.

sub construct_command {
  my $bbox = emvl::get_bbox();
  $bbox =~ tr/,/ /;
  my $format = emvl::get_format();
  my $regrid = emvl::get_regrid();
  my $my_format = $format;
  my $my_xdrconvert = '';

  if ( $regrid ne '' || $format eq 'netcdf-coards' ) {
    $my_format = 'xdr';
    my $regrid_args = emvl::xdrconvert_regrid_args( 0 );
    my $xdrconvert_format = emvl::xdrconvert_format();
    $my_xdrconvert = " | $xdrconvert $regrid_args -$xdrconvert_format";
  }

  my $my_compressor = emvl::get_compress() ? " | $compressor" : '';

  my $output_ascii = $format eq 'ascii' && $regrid eq '';

  if ( $output_ascii ) {
    $command =
    "$sort -t , -s -n -k 4 -k 5 -k 6 -k 1 $temp_file_name -o $temp2_file_name";
    my $ok = execute_command( $command );

    if ( $ok ) {
      reformat_temp_file( $temp2_file_name, $temp_file_name );
      $command = "$cat $temp_file_name$my_compressor";
    }
  } else {
    my $filter_command = '';

    # Always filter missing values (introduced by subsetter) from ASCII format:

    if ( $format eq 'ascii' ) {
      $filter_command = " | $grep -v " . "'\\-9.999'";
    }

    my $yyyymmddhh = substr( emvl::get_yyyymmddhhmmss1(), 0, 10 );
    my $hours = emvl::get_hours();

    $command =
      "$subsetter" .
      " -data $temp_file_name" .
      " -$my_format" .
      " -desc https://airnowgateway.org/,reformat_airnow_obs,SiteSubset" .
      " -timestamp $yyyymmddhh -hours $hours" .
      " -domain $bbox " .
       "$my_xdrconvert " .
      $filter_command .
      " $my_compressor ";
  }
}



# Query the external web server and write reformatted rows to a temporary file.
# my $result = query_external_webserver();

sub query_external_webserver {
  my $result = 0;
  my $bdate = emvl::get_yyyymmddhh1() . '00';
  my $edate = emvl::get_yyyymmddhh2() . '59';
  my $minlon = emvl::get_west();
  my $maxlon = emvl::get_east();
  my $minlat = emvl::get_south();
  my $maxlat = emvl::get_north();
  my $units = 'ppb'; # pm25 = 'ug/m3', co = 'ppm', others = 'ppb'.
  my $params = '';
  my $offset = 0; # 32 for temperature, else 0.
  my $scale = 1; # 1 for pm25, 1000 for ozone (to convert ppm to ppb).
  my $variable = lc( emvl::get_coverage() );

  if ( $variable eq 'pm25' ) {
    $units = 'ug/m3';
####$params = '88101';
    $params = '88101,88500,88501,88502';
  } elsif ( $variable eq 'pm10' ) {
    $units = 'ug/m3';
    $params = '81102';
  } elsif ( $variable eq 'ozone' ) {
    $params = '44201';
  } elsif ( $variable eq 'no' ) {
    $params = '42601';
  } elsif ( $variable eq 'no2' ) {
    $params = '42602';
  } elsif ( $variable eq 'nox' ) {
    $params = '42603';
  } elsif ( $variable eq 'so2' ) {
    $params = '42401';
  } elsif ( $variable eq 'co' ) {
    $units = 'ppm';
    $params = '42101';
  } elsif ( $variable eq 'temperature' ) {
    $params = "'62101'"; # Outdoor temperature in F.
    $units = 'C'; # Use offset and sclae to convert to C.
    # HACK: https://aqs.epa.gov/aqsweb/documents/codetables/parameters.html
    # Search: temperature
    # Reads Standard Units = "Degrees Fahrenheit" but the data appears to be
    # degrees C (e.g., July NYC temperature is 29)!
    #$offset = 32;
    #$scale = 0.55555555555;
  } elsif ( $variable eq 'rh' ) {
    $units = '%';
    $params = '62201,62202,68110';
  } elsif ( $variable eq 'pressure' ) {
    $units = 'hPa';
    $params = '64101';
  }

  # Override with user-specified codes:

  if ( $only_codes ne '' ) {

    if ( ! only_codes_are_valid_subset( $params ) ) {
      return 0;
    } else {
      emvl::debug( "replacing parameter_codes $params with only_codes $only_codes" );
      $params = $only_codes;
    }
  }

  my $temp_file = create_temp_file( $temp_file_name, $variable, $units );

  if ( $temp_file >= 0 ) {
    my @parts = split( /,/, $params );
    my $count = @parts;

    for ( my $p = 0; $p < $count; ++$p ) {
      my $param = $parts[ $p ];

      my $wcs_command =
        $curl_command .
        "&param=$param&bdate=$bdate&edate=$edate" .
        "&minlon=$minlon&maxlon=$maxlon&minlat=$minlat&maxlat=$maxlat'" .
        " | $grep '^[0-9]' | $sort -n";

      # Untaint command (match expression is arbitrary as far as -T checks):

      if ( $wcs_command =~ m#^(/[\w-]+/[\w -/.,'|^\[\]:?=&]+)$# )
      {
        $wcs_command = $1; # Re-assign first match to satisfy -T.
        emvl::debug( "executing command = $wcs_command" );
        %ENV = (); # Unset all environment variables prior to popen.
        # Complicated, supposedly safer way to open a readable pipe to command:
        my $the_pipe = 0;
        my $pid = open( the_pipe, "-|" );

        if ( ! defined( $pid ) ) {
          die "Couldn't open pipe to subprocess";
        } elsif ( $pid ) { # Parent process.
          emvl::debug( "reading result rows and processing into $temp_file_name..." );
          my $line = <the_pipe>;

          if ( defined( $line ) ) { # Read and process each resulting line:
            my @previous_row = parse_line( $line, $offset, $scale );

            if ( @previous_row ) {
              my $coincident_row_count = 1;

              while ( $line = <the_pipe> ) {
                emvl::debug( "read line = $line\n" );
                my @row = parse_line( $line, $offset, $scale );
                emvl::debug( "parsed row = @row\n" );
                my $same_station = $row[ 0 ] == $previous_row[ 0 ];
                my $compute_mean = 0;

                if ( $aggregate eq 'all' ) {
                  $compute_mean = $same_station;
                } elsif ( $aggregate eq 'daily' ) {

                  if ( $same_station ) {
                    my $same_day =
                      $row[ 3 ] == $previous_row[ 3 ] &&
                      $row[ 4 ] == $previous_row[ 4 ];
                    $compute_mean = $same_day;
                  }
                } else { # Compute hourly mean if multiple sub-hourly values:

                  if ( $same_station ) {
                    my $same_time =
                      $row[ 3 ] == $previous_row[ 3 ] &&
                      $row[ 4 ] == $previous_row[ 4 ] &&
                      $row[ 5 ] == $previous_row[ 5 ];
                    $compute_mean = $same_time;
                  }
                }

                # Compute mean of coincident non-missing values:

                if ( $compute_mean ) {

                  if ( $row[ 6 ] > -9999.0 ) { # Only consider non-missing.

                    if ( $previous_row[ 6 ] > -9999.0 ) { # Running mean:
                      $coincident_row_count += 1;
                      $previous_row[ 6 ] =
                        ( ( $coincident_row_count - 1 ) * $previous_row[ 6 ] +
                            $row[ 6 ] )
                        / $coincident_row_count;
                    } else { # Replace previous missing value with non-missing:
                      $previous_row[ 6 ] = $row[ 6 ];
                    }
                  }
                } else {
                  write_row( $temp_file, @previous_row );
                  @previous_row = @row;
                  $coincident_row_count = 1;
                }
              }

              write_row( $temp_file, @previous_row );
              $result = 1;
            }
          }
        } else { # Child process.
          exec( $wcs_command ) or die "can't exec program: $!";
        }

        close( the_pipe );
      } else {
        print STDERR "\ncommand contains invalid characters.\n";
      }
    }

    close( $temp_file );
  }

  return $result;
}


# Reformat
# my $temp_file = create_temp_file( $temp_file_name, $variable, $units );

sub create_temp_file {
  my $file_name = shift;
  my $variable  = shift;
  my $units     = shift;
  my $temp_file = undef;
  my @variable_parts = split( /_/, $variable );
  $variable = $variable_parts[ 0 ];
  open $temp_file, '>', $file_name;

  if ( $temp_file >= 0 ) {
    print $temp_file
    "SITE,LATITUDE,LONGITUDE,YEAR,JUL_DAY,UTC_HR,$variable,$units,SITE_NAME\n";
  }

  return $temp_file;
}



# Reformat temp file to output ASCII format.
# 2026-08-06: UGLY
# This function is called only when FORMAT=ascii and REGRID is not specified.
# This avoids usage of SiteSubset which was written long ago assuming that NOTE
# is the same for all data lines for a given STATION.
# But now NOTE has been expanded to include per-measure info such as parameter
# code and qc flag like this: 840120890010;88502;qc:0
# Using SiteSubset uses NOTE from the first data line of a STATION because the
# SITE 1.0 xdr format factors-out station info such as id, longitude, latitude,
# note, therefore it looses actual per-measure info.
# So at least for ASCII non-regridded format, output that format here instead
# of using SiteSubsert, thus preserving per-measure info for applications that
# need this such as ASNAT (which only retrieves ASCII, non-regridded format).

sub reformat_temp_file {
  my ( $input_file_name, $output_file_name ) = @_;

  # Read entire input file into memory:

  if ( open my $input_file, '<', $input_file_name ) {
    emvl::debug( "reading temp file $input_file_name" );
    my @data_lines = <$input_file>;
    close $input_file;
    my $line_count = @data_lines;
    emvl::debug( "read $line_count data lines" );

    if ( $line_count > 1 ) {

      if ( open my $output_file, '>', $output_file_name ) {
        emvl::debug( "opened file $output_file_name" );
        my $coverage_index = emvl::get_coverage_index();
        my $coverage_info = $coverage_metadata[ $coverage_index ];
        my $variable = $coverage_info->{ name };
        my $units    = $coverage_info->{ units };

        # Output mean site measure from different parameter codes:

        my $count = 0;
        my $sum = 0.0;
        my $previous_id = 0;
        my $previous_latitude = 0.0;
        my $previous_longitude = 0.0;
        my $previous_year = 0;
        my $previous_day_of_year = 0;
        my $previous_hour = 0;
        my $notes = '';

        print $output_file
          "Timestamp(UTC)\tLONGITUDE(deg)\tLATITUDE(deg)\tSTATION(-)\t$variable($units)\tSITE_NAME\n";

        for ( my $line_index = 0; $line_index < $line_count; ++$line_index ) {
          my $data_line = $data_lines[ $line_index ];
          emvl::debug( "data_line = $data_line" );
          my @row = split( /,/, $data_line );
          my $columns = @row;

          if ( $columns == 8 ) {

            # Input data line looks like:
            #  7966,  31.57670, -84.10020,2016,239,20.5,          5.20000000,                     840130950007;88101;qc:0

            my $id          = $row[ 0 ];
            my $latitude    = $row[ 1 ];
            my $longitude   = $row[ 2 ];
            my $year        = $row[ 3 ];
            my $day_of_year = $row[ 4 ];
            my $hour        = $row[ 5 ];
            my $measure     = $row[ 6 ];
            my $note        = $row[ 7 ];
            $note =~ s/^\s+|\s+$//g; # Trim leading and trailing spaces.

            if ( $previous_id == 0 ) {
              $count = 1;
              $sum = $measure;
              $previous_id = $id;
              $previous_latitude = $latitude;
              $previous_longitude = $longitude;
              $previous_year = $year;
              $previous_day_of_year = $day_of_year;
              $previous_hour = $hour;
              $notes = $note;
            } elsif ( $id == $previous_id &&
                      $year == $previous_year &&
                      $day_of_year == $previous_day_of_year &&
                      $hour == $previous_hour ) {
              $count += 1;
              $sum += $measure;
              my @note_parts = split( /;/, $note );
              $notes .= ';' . $note_parts[ 1 ] . ';' . $note_parts[ 2 ];
            } else {

              my $yyyyddd = "$previous_year$previous_day_of_year";
              my $yyyymmdd = emvl::convert_yyyyddd( $yyyyddd );
              my $yyyy = int( $yyyymmdd / 10000 );
              my $mm   = int( $yyyymmdd / 100 ) % 100;
              my $dd   =      $yyyymmdd % 100;
              my $hh   = int( $previous_hour );

              printf $output_file "%04d-%02d-%02dT%02d:00:00-0000\t%10.5f\t%10.5f\t%20lld\t%20.12e\t%44s\n",
                     $yyyy, $mm, $dd, $hh, $previous_longitude, $previous_latitude, $previous_id, $sum / $count, $notes;

              $count = 1;
              $sum = $measure;
              $previous_id = $id;
              $previous_latitude = $latitude;
              $previous_longitude = $longitude;
              $previous_year = $year;
              $previous_day_of_year = $day_of_year;
              $previous_hour = $hour;
              $notes = $note;
            }
          }
        }

        if ( $count > 0 ) {
          my $yyyyddd = "$previous_year$previous_day_of_year";
          my $yyyymmdd = emvl::convert_yyyyddd( $yyyyddd );
          my $yyyy = int( $yyyymmdd / 10000 );
          my $mm   = int( $yyyymmdd / 100 ) % 100;
          my $dd   =      $yyyymmdd % 100;
          my $hh   = int( $previous_hour );

          printf $output_file "%04d-%02d-%02dT%02d:00:00-0000\t%10.5f\t%10.5f\t%20lld\t%20.12e\t%44s\n",
                 $yyyy, $mm, $dd, $hh, $previous_longitude, $previous_latitude, $previous_id, $sum / $count, $notes;
        }

        close $output_file;
      }
    }
  }
}



# my @row = parse_line( $line, $offset, $scale );
# Read and process each resulting line (that looks like this):
# 840060890004,0,,20100308T0000,44201,60,0,32.60000,008,0,1,40.549700,-122.379200,,500,,,,,
# into a row that looks like:
# 060890004, 40.5497,-122.379,2010, 68,00.5,    32.6, 840060890004;44201;qc:0

sub parse_line {
  my ( $line, $offset, $scale ) = @_;

  emvl::debug("parsing line = $line");
  emvl::debug("with offset = $offset, scale = $scale");

  my @row = split( /,/, $line );
  my $sid = $row[ 0 ]; # May contain letters such as CK2010001.
  my $site_id = sid_to_id( $sid ); # Convert to integer index of all known sids.
  my $latitude  = $row[ 11 ];
  my $longitude = $row[ 12 ];
  my $timestamp = $row[ 3 ];
  my $parameter_code = $row[ 4 ];
  my $measure = $row[ 7 ];
  my $qc = $row[ 9 ];

  my $yyyy = 0;
  my $ddd  = 0;
  my $hour = 0;
  emvl::convert_timestamp( $timestamp, $yyyy, $ddd, $hour );

  # https://www.airnowtech.org/resources/AIRNow-I_AQCSV-Final.pdf
  # page 28. QC flags:
  # 0 = Valid
  # 1 = Adjusted
  # 2 = Averaged
  # 3 = interpolated
  # 4 = Estimated
  # 5 = Suspect
  # 6 = Suspect (audit failure)
  # 7 = Insufficient data
  # 8 = Missing
  # 9 = Invalid

  my $maximum_qc_flag = $maximum_qc ne '' ? $maximum_qc : $default_maximum_qc;
  my $coverage = emvl::get_coverage();
  my $minimum_valid_value = lc( $coverage ) eq 'temperature' ? -50.0 : 0.0;

  if ( $measure eq '' ||
       $measure < $minimum_valid_value ||
       $qc > $maximum_qc_flag ) {
    $measure = -9999.0;
  } elsif ( $offset != 0 || $scale != 1 ) {
    $measure = ( $measure - $offset ) * $scale
  }

  my $note = "$sid;$parameter_code;qc:$qc";

  my @result =
    ( $site_id, $latitude, $longitude, $yyyy, $ddd, $hour, $measure, $note );

  return @result;
}



# Convert string station name to a unique sequential integer id > 0.
# my $id = sid_to_id( $sid );

sub sid_to_id {
  my $sid = shift;
  my $count = @sids;
  my $result = 0;

  for ( my $index = 0; $index < $count; ++$index ) {

    if ( $sids[ $index ] eq $sid ) {
      $result = $index + 1;
      $index = $count - 1;
    }
  }

  if ( $result == 0 ) {
    print STDERR "\nOmitting Airnow sid $sid missing from $sites_file.\n";
  }

  return $result;
}



# Read $sites_file into @sids:

sub read_site_file {
  emvl::debug( "reading sites file $sites_file" );

  if ( open my $input, '<', $sites_file ) {
    @sids = <$input>;
    #emvl::debug( "sids = @sids" );
    chomp @sids; # Remove newlines from each array entry.
    close $input;
  }

  my $result = @sids;
  emvl::debug( "result = $result" );
  return $result
}



# write_row( $temp_file, @previous_row );

sub write_row {
  my ( $temp_file,
       $site_id, $latitude, $longitude, $year, $day_of_year, $hour,
       $measure, $note ) = @_;

  if ( $site_id > 0 && $site_id < 2147483647 && $measure > -9999.0 ) {

    if ( $aggregate ne '' ) {
      $hour = 0;
    }

    emvl::debug("writing line = $site_id, ... $hour $measure, $note ");

    printf $temp_file "%20s,%10.5f,%10.5f,%04d,%03d,%04.1f,%20.8f,%44s\n",
           $site_id, $latitude, $longitude, $year, $day_of_year, $hour + 0.5,
    $measure, $note;
  }
}



# Execute command and echo its output to STDOUT. E.g., execute_command( 'ls' );

sub execute_command {
  my $command = shift;
  my $result = 0;
  my $the_pipe = 0;

  # -T flag requires untainting $command by matching a minimal regex needed for
  # system commands used by this program.

  if ( $command =~ m#^(/[\w-]+/[\w -/.:;,\\'@|]+)$# )
  {
    $command = $1; # Re-assign first match, which is enough to satisfy -T.
    emvl::debug( "executing command = $command" );
    %ENV = (); # Unset all environment variables prior to popen.
    # Complicated, supposedly safer way to open a readable pipe to command:
    my $pid = open( the_pipe, "-|" );

    if ( ! defined( $pid ) ) {
      die "Couldn't open pipe to subprocess";
    } elsif ( $pid ) { # Parent process.

      while ( <the_pipe> ) {
        print;
      }

      close( the_pipe );
      $result = ! $?;
    } else { # Child process.
      exec( $command ) or die "can't exec program: $!";
    }
  } else {
    print STDERR "\ncommand contains invalid characters.\n";
  }

  return $result;
}


