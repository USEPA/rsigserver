# Restrict PATH and ENV. (But before popen, ENV is cleared!)
delete @ENV{ 'PATH', 'IFS', 'CDPATH', 'ENV', 'BASH_ENV' };

############################## TUNABLE CONSTANTS #############################

# Turn-off debugging during production usage. (More secure.)
# Only enable temporarily while diagnosing a problem.
emvl::set_debugging( 0 ); # 1 = print debug messages to STDERR logs/error_log

my $desc = 'https://www-calipso.larc.nasa.gov/,CALIPSOSubset';

my $temp_directory = '/var/tmp';
my $temp_file_name = "$temp_directory/calipsoserver_temp.$$";

# CALIPSOSubset and XDRConvert are EPA-developed applications for processing
# CALIPSO data.
# Install these on a designated internal server running this PERL-CGI program
# and disk system containing direct/fast-access to the CALIPSO data files.

my $bindir       = '/slocal/sites/cain.larc.nasa.gov/cgi-bin/rsig/code/bin/Linux/';
my $lister       = "$bindir/listfiles_calipso";
my $subsetter    = "$bindir/CALIPSOSubset";
my $xdrconvert   = "$bindir/XDRConvert -tmpdir $temp_directory";
my $compressor   = '/usr/bin/gzip -c -1';
my $tar          = '/usr/bin/tar -zcO';
my $cat          = '/bin/cat';
my $xargs        = '/usr/bin/xargs';

my $curl_command =
  "/usr/bin/curl -4 -k --silent --max-time 3600 --retry 0 -L --tcp-nodelay ";

# Output messages when REQUEST=GetMetadata.
# Print this message first:

my $metadata_content = '
