#!/usr/bin/perl -wT

##############################################################################
# PURPOSE: cmaqserver - Serve CMAQ data, subsetted by date/time range,
#          variable, and longitude-latitude box, in ASCII, XDR, NetCDF-COARDS,
#          NetCDF-IOAPI formats for use by other prograzms (e.g., via wget).
#
# NOTES:   Server is WCS-compliant:
#          https://www.opengeospatial.org/standards/wcs
#          https://datafed.net/xs/OpenGIS/wcs/1.0.0/
#          and modeled after a similar webserver application:
#          https://webapps.datafed.net/ogc_EPA.wsfl
#
#          Launches the C program CMAQSubset which streams the data on STDOUT.
#
#          Example usage:
#
#          curl -k --silent --retry 0 'https://ofmpub.epa.gov/rsig/rsigserver?\
#          SERVICE=wcs&\
#          VERSION=1.0.0&\
#          REQUEST=GetCoverage&\
#          COVERAGE=cmaq.equates.conus.aconc.pm25&\
#          TIME=2002-08-26T00:00:00Z/2002-08-31T23:59:59Z&\
#          BBOX=-90,28,-80,32,1,1&\
#          FORMAT=ascii'
#
# HISTORY: 2006-08-03 plessel.todd@epa.gov 1-919-541-5500
#
# STATUS:  unreviewed tested
##############################################################################

use strict;
#BEGIN { push @INC, '/Users/plessel/projects/rsig/code/perl'; }
BEGIN { push @INC, '/data/Apache/cgi-bin'; }
use emvl; # Local OGC-WCS query string parsing and printing utility functions.
use cmaq; # Use my $coverage_metadata_reference = cmaq::get_coverage_metadata_reference();
pop @INC;

package main;
$| = 1; # Turn off output buffering so messages appear in correct order.
alarm( 3600 ); # Kill process after 1 hour. Legitimate usage could be an hour!
# Restrict PATH and ENV. (But before popen, ENV is cleared!)
delete @ENV{ 'PATH', 'IFS', 'CDPATH', 'ENV', 'BASH_ENV' };

############################## TUNABLE CONSTANTS #############################

emvl::set_debugging( 0 ); # 1 = print debug messages to STDERR logs/error_log
my $valid_oaqps_key = "OAQPSST";

my @pathed_program_parts = split( /\//, $0 );
my $program_name = $pathed_program_parts[ @pathed_program_parts - 1 ];

my $data_source = 'CMAQ';
my $desc = 'https://www.epa.gov/cmaq,CMAQSubset';
my $ellipsoid = '6370000 6370000';
my $temp_directory = '/data/tmp';
my $data_directory = '/data/CMAQ';
my $bindir     = '/rsig/current/code/bin/Linux.x86_64';
my $subsetter  = "$bindir/CMAQSubset";
my $xdrconvert = "$bindir/XDRConvert";
my $compressor = '/usr/bin/gzip -c -1';
my $tar        = '/usr/bin/tar -zcO';


# Output messages when EQUEST=GetMetadata.
# Print this message first:

my $metadata_content = '
US EPA CMAQ modeled atmospheric data accessed using RSIG.
https://www.epa.gov/cmaq
RSIG: https://www.epa.gov/rsig
';

# If FORMAT=original then print this message second:

my $metadata_content_original = '
The list of original data files are shown below.
';

# Else FORMAT!=original then print this message second:

my $metadata_content_processed = '
Data processing was done using the RSIG programs CMAQSubset and XDRConvert.
CMAQSubset is used to subset (by variable, lon-lat box and time range)
and reorganize/reformat and filter the data.
XDRConvert is optionally used to reformat the data to other file formats.
The list of original data files and the RSIG command used to process them
are shown below.
';


################################## VARIABLES #################################

# Parsed from the URL query string:

my $nolonlats = ''; # 1 = omit lonlat variables in XDR output. 0 is default.
my $corners = ''; # 1 = include lonlat corners in output. 0 is default.
my $noelevation = ''; # 1 = omit ELEVATION variable in output. 0 is default.
my $aggregate = ''; # NONE, DAILY_MEAN, DAILY_MAX, DAILY_MAX8. NONE is default.
my $integrate = ''; # 1 = integrate layers. 0 is default.
my $key           = ''; # Key required for retrieval of non-proxy data.
my $just_check_key = 0; # Just check key and output one line result: 0 or 1.

# Derived from the above parsed values:

my $elevation_files = ''; # /data/CMAQ/EQUATES/CONUS/2005/20050826/cro_elevation.ncf
my $data_files      = ''; # /data/CMAQ/EQUATES/CONUS/2017/0101/CONC.ncf
my $gridcro2d_file  = ''; # /data/CMAQ/EQUATES/CONUS/2017/20170101/GRIDCRO2D
my $metcro3d_files  = ''; # /data/CMAQ/EQUATES/CONUS/2017/20170101/METCRO3D
my $wwind_files     = ''; # /data/CMAQ/EQUATES/CONUS/2017/20170101/METCRO3D
my $variables       = ''; # E.g., UWIND, VWIND.

################################## ROUTINES ##################################


main();


sub main {
  my $result = 0;

  # Before calling emvl::parse_url(), specify various options so the default
  # functions work:

  emvl::set_source( $data_source );
  emvl::set_coverage_metadata( cmaq::get_coverage_metadata_reference() );
  emvl::append_parser( 'aggregate', \&parse_aggregate_option );
  emvl::append_parser( 'integrate', \&parse_integrate_option );
  emvl::append_parser( 'nolonlats', \&parse_nolonlats_option );
  emvl::append_parser( 'noelevation', \&parse_noelevation_option );
  emvl::append_parser( 'corners', \&parse_corners_option );
  emvl::append_parser( 'key', \&parse_key_option );
  emvl::append_parser( 'check_key', \&parse_check_key_option );
  emvl::set_required_options_specified( \&required_options_specified );

  if ( ! emvl::parse_url() ) {
    print "Content-type: text/plain; charset=iso-8859-1\n\n"; # For webserver

    if ( $just_check_key ) {
      print "0\n"; # 0 indicates failed to validate key.
    }
  } elsif ( $just_check_key ) {
    print "Content-type: text/plain; charset=iso-8859-1\n\n"; # For webserver
    print "1\n"; # 1 indicates validated key.
  } else {
    my $request = emvl::get_request();
    my $format = emvl::get_format();

    if ( $request eq 'getcapabilities' ) {
      print "Content-type: text/xml; charset=iso-8859-1\n\n"; # For webserver
      emvl::print_capabilities( \&print_coverage_offering_brief );
      $result = 1;
    } elsif ( $request eq 'describecoverage' ) {
      print "Content-type: text/xml; charset=iso-8859-1\n\n"; # For webserver
      emvl::print_coverage_description( \&print_coverage_offering );
      $result = 1;
    } elsif ( $request eq 'getcoverage' ) {
      my $header = emvl::get_content_type_header(); # Based on parsed FORMAT.
      print "$header\n\n";
      my $coverage = emvl::get_coverage();

      if ( ( index( $coverage, 'OAQPS.' ) == 0 ||
             index( $coverage, 'OARINTL.' ) == 0 )
            && $key ne $valid_oaqps_key ) {
        $result = 0;
      } else {

# TEMP HACK to thwart unreasonable concurrent requests 2025-10-23:
#if ( $hours > 168 ) {
#  print "Content-type: text/plain; charset=iso-8859-1\n\n"; # For webserver
#  print "\nFAILED\n";
#  print "Too many concurrent requests for too large data.\n";
#  print "Please contact rsig\@epa.gov for assistance with large data processing requests.\n";
#  exit 88;
#}
        compute_input_files();
        my $command = construct_command();

        if ( $command ne '' ) {
          $result = execute_command( $command );
        }
      }
    } elsif ( $request eq 'getmetadata' ) {
      print "Content-type: text/plain; charset=iso-8859-1\n\n"; # For webserver
      compute_input_files();

      if ( $data_files ne '' ) {
        my $command = construct_command();

        if ( $command ne '' ) {
          print $metadata_content;
          $data_files =~ tr/ /\n/;
          $elevation_files =~ tr/ /\n/;

          if ( $format eq 'original' ) {
            print $metadata_content_original;
            print "$data_files\n";
            print "$elevation_files\n";

            if ( $integrate ) {
              $metcro3d_files =~ tr/ /\n/;
              print "$metcro3d_files\n";
            }

            print "\n";
          } else {
            print $metadata_content_processed;
            print "$data_files\n";
            print "$elevation_files\n";

            if ( $integrate ) {
              $metcro3d_files =~ tr/ /\n/;
              print "$metcro3d_files\n";
            }

            print "\n$command\n\n";
          }

          $result = 1;
        }
      }
    }
  }

  $result = 1 - $result; # UNIX: zero is success, non-zero is failure.
  emvl::debug( "exit result = $result" );

  # Must return some bytes to avoid 30 second timeout delay when unsuccessful:

  if ( $result != 0 ) {
    print STDOUT "\nFAILED\n";
  }

  exit $result;
}



# Print web server coverage offering brief metadata with layer information.
# Called by emvl::print_capabilities();

sub print_coverage_offering_brief {
  my $coverage_metadata_reference = cmaq::get_coverage_metadata_reference();
  my $variable_count = scalar @$coverage_metadata_reference;

  for ( my $variable_index = 0; $variable_index < $variable_count;
        ++$variable_index ) {
    my $this_entry = $coverage_metadata_reference->[ $variable_index ];
    my $this_variable = $this_entry->{ name };
    my $this_units = $this_entry->{ units };
    my $this_description = $this_entry->{ description };
    my $this_west_bound = $this_entry->{ west_bound };
    my $this_east_bound = $this_entry->{ east_bound };
    my $this_south_bound = $this_entry->{ south_bound };
    my $this_north_bound = $this_entry->{ north_bound };
    my $this_layers = $this_entry->{ layers };
    my $this_grid_cell = $this_entry->{ grid_cell } . 'm';
    my @parts = split( /\./, $this_variable );
    my $parts_count = @parts;
    my $this_label = $parts[ $parts_count - 1 ];

    print "        <CoverageOfferingBrief>\n";
    print "            <name>$data_source.$this_variable</name>\n";
    print "            <label>$this_label($this_units)</label>\n";
    print "            <description>$this_layers layer CMAQ modelled $this_grid_cell gridded $this_description</description>\n";
    print '            <lonLatEnvelope srsName="WGS84(DD)">' . "\n";
    print "                <gml:pos>$this_west_bound $this_south_bound</gml:pos>\n";
    print "                <gml:pos>$this_east_bound $this_north_bound</gml:pos>\n";
    print "            </lonLatEnvelope>\n";
    print "        </CoverageOfferingBrief>\n";
  }
}



