  emvl::parse_option( $aggregate, $value, 'AGGREGATE',
                      'none daily_mean daily_max daily_max8 all' );
}



# Parse integrate option.

sub parse_integrate_option {
  my $value = shift;
  my $result = emvl::parse_option( $integrate, $value, 'INTEGRATE', '0 1' );
}



# Parse key option:

sub parse_key_option {
  my $value = shift;
  my $result = 0;

  if ( $key ne '' ) {
    print STDERR "\nRedundant KEY option\n";
  } else {

    if ( $value =~ m#^([\w-]+)$# )
    {
      $key = uc( $value );
      $result = $key eq $valid_oaqps_key;
    }

    if ( ! $result ) {
      print STDERR "\nInvalid KEY option.\n";
      # Ignore invalid key value so Barron's code can use a placeholder value.
      $key = '';
      $result = 1;
    }
  }

  return $result;
}



# Parse check_key option:

sub parse_check_key_option {
  my $value = shift;
  my $result = 0;
  $just_check_key = 1;

  if ( $key ne '' ) {
    print STDERR "\nRedundant CHECK_KEY/KEY option\n";
  } else {

    if ( $value =~ m#^([\w-]+)$# )
    {
      $key = uc( $value );
      $result = $key eq $valid_oaqps_key;
    }
  }

  return $result;
}



# Check that all required 'options' have been specified:

sub required_options_specified {
  my $result = 0;

  if ( $just_check_key ) {
    $result = 1;
  } else {
    $result = emvl::required_options_specified();
  }

  return $result;
}



# Compute list of input data and elevation files.
# Initializes:
#   $elevation_files
#   $data_files
#   $gridcro2d_file
#   $metcro3d_files
#   $wwind_files
#   $variables

sub compute_input_files {

  $data_files      = '';
  $elevation_files = '';
  $gridcro2d_file  = '';
  $metcro3d_files  = '';
  $wwind_files     = '';
  $variables       = '';

  my $hh              = emvl::get_yyyymmddhh1() % 100;
  my $yyyymmdd        = emvl::get_yyyymmdd1();
  my ( $yyyy, $mm, $dd ) = emvl::split_yyyymmdd( $yyyymmdd );
  my $hours = emvl::get_hours();
  my $last_timestep   = $hh + $hours - 1;
  my $days            = int( 1 + $last_timestep / 24 );
  my $isDaily = 0;
  my $isMonthly = 0;
  my $isYearly  = 0;
  my $isDep = 0;
  my $coverage = emvl::get_coverage(); # E.g., EQUATES.CONUS.ACONC.PM25

  if ( index( $coverage, '.ADEP.' ) != -1 ||
       index( $coverage, '.SOILINP.' ) != -1 ) {
    $isYearly = 1;
    $isDep = 1;
  } elsif ( index( $coverage, '.MDEP.' ) != -1 ) {
    $isMonthly = 1;
    $isDep = 1;
  } elsif ( index( $coverage, '.DDEP.' ) != -1 ) {
    $isDaily = 1;
    $isDep = 1;
  } elsif ( index ( $coverage, '.LST' ) != -1 ) {
    $isDaily = 1;
  } elsif ( index ( $coverage, '.AEMIS' ) != -1 ) {
    $isYearly = 1;
  }

  # Set global $variables to be the file variable names from $coverage.
  # E.g., COVERAGE=EQUATES.CONUS.METDOT3D.UWIND,EQUATES.CONUS.METDOT3D.VWIND
  # variables = 'UWIND VWIND'.
  # Multiple variables, if specified, must be in the same data file.

  my @coverage_parts = split( /,/, $coverage );
  my $coverage_parts_count = @coverage_parts;
  my $first_coverage = $coverage_parts[ 0 ];
  my @first_coverage_parts = split( /\./, $first_coverage );
  my $first_coverage_parts_count = @first_coverage_parts;
  my $first_variable = $first_coverage_parts[ $first_coverage_parts_count - 1 ];
  my $match_length = length( $first_coverage ) - length( $first_variable );

  $variables = $first_variable;

  for ( my $c_index = 1; $c_index < $coverage_parts_count; ++$c_index ) {
    my $next_coverage = $coverage_parts[ $c_index ];

    if ( substr( $next_coverage,  0, $match_length ) eq
         substr( $first_coverage, 0, $match_length ) ) {
      my $next_variable = substr( $next_coverage, $match_length );
      $variables .= " $next_variable";
    } else {
      print STDERR "\nInvalid (unmatched) source file for variables.\n";
      return;
    }
  }

  emvl::debug( "variables = '$variables'" );

  # Set directory path above YYYY/YYYYMMDD:
  # Omit file.variable, e.g., ACONC.PM25

  my $parts_count_2 = $first_coverage_parts_count - 2;
  my $directory = $data_directory;

  for ( my $part_index = 0; $part_index < $parts_count_2; ++$part_index ) {
    $directory .= '/';
    $directory .= $first_coverage_parts[ $part_index ];
  }

  emvl::debug( "directory = '$directory'" );

  #----------------------------------------------------------------------------
  # UGLY.
  # Per CMAQ Team on 2021-09-13:
  # 2002-2017 EQUATES METDOT3D has UWIND, VWIND but the corresponding METCRO3D
  # file is missing WWIND!
  # Instead the WWIND.ncf files here are pre-process/extracted from
  # CCTM_CONC and contain W_VEL - a derived vertical wind (computed by CMAQ).
  # Daily WWIND.ncf files contain 25 timesteps of W_VEL.
  # (Hour 0 to hour 0 of the next day.)
  # However the first timestep of each file has BADVAL3 for W_VEL!
  # But the previous day file timestep 25 is the same as the next day file
  # timestep 0 but with valid W_VEL values.
  # Therefore, if we prepend the previous WWIND.ncf file it should yield
  # valid W_VEL values over multiple days (with the new CMAQSubset).
  # There is no file for 20011231 so 20020101 timestep 0 is BADVAL3.
  # The new CMAQSubset will check for and convert these BADVAL3 values to 0
  # (when specified in -wwind option, but not as scalar data in -files option).

  my $yyyymmdd_1 = emvl::decrement_date( $yyyymmdd );
  my ( $yyyy_1, $mm_1, $dd_1 ) = emvl::split_yyyymmdd( $yyyymmdd_1 );
  my $full_directory_1 =
    sprintf("$directory/%04d/%04d%02d%02d", $yyyy_1, $yyyy_1, $mm_1, $dd_1 );
  my $previous_wwind_file = "$full_directory_1/WWIND.ncf";
  my $coverage_metadata_reference = cmaq::get_coverage_metadata_reference();
  my $coverage_index = emvl::get_coverage_index();
  my $data_file = $coverage_metadata_reference->[ $coverage_index ]->{ data_file };

  if ( -f $previous_wwind_file ) {
    $wwind_files = $previous_wwind_file;

    # If selected data file is WWIND.ncf then include previous file too:

    if ( $data_file eq 'WWIND.ncf' ) {
      $data_files = $previous_wwind_file;
    }
  }

  #----------------------------------------------------------------------------

  my $yyyymmdd2 = emvl::get_yyyymmdd2();

  while ( $yyyymmdd <= $yyyymmdd2 ) {
    my ( $yyyy, $mm0, $dd0 ) = emvl::split_yyyymmdd( $yyyymmdd );

    if ( $isYearly ) {
      $mm0 = 1;
      $dd0 = 1;
    } elsif ( $isMonthly ) {
      $dd0 = 1;
    }

    my $full_directory =
      sprintf( "$directory/%04d/%04d%02d%02d", $yyyy, $yyyy, $mm0, $dd0 );
    my $next_data_file = "$full_directory/$data_file";

    if ( -f $next_data_file ) {
      my $next_elevation_file = "$full_directory/cro_elevation.ncf";
      my $next_gridcro2d_file = "$full_directory/GRIDCRO2D";
      my $next_metcro3d_file  = "$full_directory/METCRO3D";
      my $next_wwind_file     = "$full_directory/WWIND.ncf";

      if ( index( $data_files, $next_data_file ) == -1 ) {
        $data_files .= " $next_data_file";
      }

      if ( ! $isYearly && ! $isDep && ! $isDaily && -f $next_elevation_file &&
           index( $elevation_files, $next_elevation_file ) == -1 ) {
        $elevation_files .= " $next_elevation_file";
      }

      if ( ! $isDep && ! $isDaily && $gridcro2d_file eq '' && -f $next_gridcro2d_file ) {
        $gridcro2d_file = $next_gridcro2d_file;
      }

      if ( ! $isYearly && ! $isDep && ! $isDaily && -f $next_metcro3d_file &&
           index( $metcro3d_files, $next_metcro3d_file ) == -1 &&
           index( $directory, 'DISCOVER' ) == -1 ) { # METCRO3D lacks ZH/ZF!
        $metcro3d_files .= " $next_metcro3d_file";
      }

      if ( ! $isYearly && ! $isDep && ! $isDaily && -f $next_wwind_file &&
           index( $wwind_files, $next_wwind_file ) == -1 ) {
        $wwind_files .= " $next_wwind_file";
      }
    }

    $yyyymmdd = emvl::increment_date( $yyyymmdd );
  }

  emvl::debug( "data_files = $data_files" );
  emvl::debug( "elevation_files = $elevation_files" );
  emvl::debug( "$gridcro2d_file = $gridcro2d_file" );
  emvl::debug( "$metcro3d_files = $metcro3d_files" );
  emvl::debug( "$wwind_files = $wwind_files" );
}



# Construct command.

sub construct_command {
  my $command = '';
  my $ok = 1;
  my $format = emvl::get_format();

  if ( $format eq 'original' ) {
    $command = "$tar $data_files $elevation_files $metcro3d_files" .
               "$gridcro2d_file $wwind_files";
  } else {
    my $yyyymmddhh1 = emvl::get_yyyymmddhh1();
    my $first_timestep = $yyyymmddhh1 % 100;
    my $hours = emvl::get_hours();
    my $last_timestep  = $first_timestep + $hours - 1;
    my $coverage = emvl::get_coverage();

    if ( index( $coverage, '.DDEP.' ) != -1 ) {
      my $yyyymmdd = emvl::get_yyyymmdd1();
      my $dd = $yyyymmdd % 100 - 1;
      my $days0 = int( $hours / 24 );
      my $days = $days0 > 0 ? $days0 : 0;
      $first_timestep = $dd;
      $last_timestep  = $first_timestep + $days;
    }

    # Set time option unless monthly or yearly files:

    my $time_option = '';

    if ( index( $coverage, '.MDEP.' ) == -1 &&
         index( $coverage, '.ADEP.' ) == -1 &&
         index( $coverage, '.SOILINP.' ) == -1 ) {
      my $yyyymmddhh2 = emvl::get_yyyymmddhh2();
      $time_option = " -time $yyyymmddhh1 $yyyymmddhh2 ";
    }

    my @parts = split( /-/, $format );
    my $parts_count = @parts;
    my $last = $parts[ $parts_count - 1 ];
    my $format_option = "-format $last";
    my $my_compressor = emvl::get_compress() ? " | $compressor" : '';

    my $lonlats_option = $nolonlats eq '1' ? '' : '-lonlat';
    my $corners_option = $corners eq '1' ? '-corners' : '';
    my $aggregate_option = '';

    if ( $time_option ne '' && $aggregate ne '' && $aggregate ne 'none' ) {

      if ( $aggregate eq 'all' ) {
        $aggregate_option = " -aggregate sum ";
      } else {
        $aggregate_option = " -aggregate $aggregate ";
      }
    }

    my $layer_option = '';
    my $lower = emvl::get_lower();
    my $coverage_index = emvl::get_coverage_index();
    my $coverage_metadata_reference = cmaq::get_coverage_metadata_reference();
    my $layers = $coverage_metadata_reference->[ $coverage_index ]->{ layers };

    emvl::debug( "layers = $layers, lower = $lower" );

    if ( $lower ne '' ) {
      $lower = int( $lower );

      if ( ! emvl::in_range( $lower, 1, $layers ) ) {
        print STDERR "\nInvalid lower layer\n";
        $ok = 0;
      }

      my $upper = emvl::get_upper();

      if ( $upper ne '' ) {
        $upper = int( $upper );

        if ( ! emvl::in_range( $upper, $lower, $layers ) ) {
          print STDERR "\nInvalid upper layer\n";
          $ok = 0;
        }
      }

      if ( $ok ) {
        $layer_option = "-layer $lower $upper";
      }
    }

    emvl::debug( "layer_option = $layer_option" );

    # Output ELEVATION by default (if NOELEVATIONS option is omitted).
    # New CMAQSubset requires -elevation to do so.
    # -elevation = compute from vglvls[] if no ht/zf files are available.

    my $elevation_option = '-elevation';

    if ( $noelevation eq '1' ) {
      $elevation_option = ''; # Omit option so no ELEVATION output.
    }

    if ( $elevation_option ne '' ) {

      if ( $gridcro2d_file ne '' ) {
        $elevation_option .= " -ht $gridcro2d_file ";
      }

      if ( $metcro3d_files ne '' ) {
        $elevation_option .= " -zf $metcro3d_files ";
      }
    }

    my $integrate_or_wwind_option = '';

    if ( index( $coverage, '.METDOT3D.WIND' ) > 0 ) {

      # METCRO3D.WWIND is not present but CCTM_CONC has W_VEL which are
      # available on maple as WWIND.ncf.

      my $is_equates = index( $coverage, 'EQUATES.' ) == 0;

      if ( ! $is_equates ) {
        $integrate_or_wwind_option = " -wwind $metcro3d_files ";
      } else {

        if ( "$wwind_files" ne '' ) {
          $integrate_or_wwind_option = " -wwind $wwind_files ";
        }
      }

      $variables = 'UWIND VWIND'; # WWIND implicit from -wwind metcro3d.

    } elsif ( $integrate eq '1' && $layers > 1 ) {

      if ( $metcro3d_files ne '' ) { # Requires -zf files.
        $integrate_or_wwind_option = " -integrate_layers ";

        if ( index( $elevation_option, ' -zf ' ) == -1 ) { # Not already -zf
          $integrate_or_wwind_option .= " -zf $metcro3d_files ";
        }
      }
    }

    my $west_south_east_north = emvl::get_west_south_east_north();
    my $bounds_option = "-bounds $west_south_east_north";
    my $files_option = "-tmpdir $temp_directory -files $data_files";

    if ( $ok ) {
      $command =
        "$subsetter" .
        " $files_option" .
        " $elevation_option " .
        " $integrate_or_wwind_option " .
        " $format_option " .
        " -desc $desc " .
        " -ellipsoid $ellipsoid " .
        " $lonlats_option " .
        " $corners_option " .
        " -variable $variables " .
        " $aggregate_option " .
        " $time_option " .
        " $layer_option " .
        " $bounds_option " .
        " $my_compressor";
    }
  }

  return $command;
}



# Execute command and echo its output to STDOUT.
# E.g., execute_command( '/bin/ls' );

sub execute_command {
  my $command = shift;
  my $result = 0;
  my $the_pipe = 0;

  # -T flag requires untainting $command by matching a minimal regex needed for
  # system commands used by this program.

  if ( $command =~ m#^(/[\w-]+/[\w -/.:,'@|]+)$# )
  {
    $command = $1; # Re-assign first match, which is enough to satisfy -T.
    emvl::debug( "$0 executing command = $command" );
    %ENV = (); # Unset all environment variables prior to popen.
    # Complicated, supposedly safer way to open a readable pipe to command:
    my $pid = open( the_pipe, "-|" );

    if ( ! defined( $pid ) ) {
      die "Couldn't open pipe to subprocess";
    } elsif ( $pid ) { # Parent process.

      while ( <the_pipe> ) {
        print;
      }

      close( the_pipe );
      $result = ! $?;
    } else { # Child process.
      exec( $command ) or die "can't exec program: $!";
    }
  } else {
    print STDERR "\n$0: command contains invalid characters.\n";
  }

  return $result;
}


