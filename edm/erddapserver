#!/usr/bin/perl -wT

##############################################################################
# PURPOSE: erddapserver - Serve a NOAA ERDDAP water data, subsetted by
#          longitude-latitude box, in binary or ASCII format for use by
#          EstuaryDataMapper (via curl).
#
# NOTES:   Server is WCS-compliant:
#          https://www.opengeospatial.org/standards/wcs
#          https://datafed.net/xs/OpenGIS/wcs/1.0.0/
#          and modeled after a similar webserver application:
#          https://webapps.datafed.net/ogc_EPA.wsfl
#
#          Connects to a subset of external web services listed here:
#          https://coastwatch.pfeg.noaa.gov/erddap/info/index.html
#
#          Example usage:
#
#          curl -k --silent --retry 0 'https://ofmpub.epa.gov/rsig/rsigserver?\
#          SERVICE=wcs&\
#          VERSION=1.0.0&\
#          REQUEST=GetCoverage&\
#          COVERAGE=erddap.modis.chlorophyll&\
#          TIME=2006-07-18T00:00:00Z/2006-07-18T23:59:59Z&\
#          BBOX=-80,30,-60,50&\
#          FORMAT=bin'
#
# HISTORY: 2012-08-22 plessel.todd@epa.gov
#
# STATUS:  unreviewed, tested.
##############################################################################

use strict;
#BEGIN { push @INC, '/Users/plessel/projects/rsig/code/perl'; }
BEGIN { push @INC, '/data/Apache/cgi-bin'; }
use emvl; # Local OGC-WCS query string parsing and printing utility functions.
use erddap; # Use my $coverage_metadata_reference = erddap::get_coverage_metadata_reference();
pop @INC;

package main;
$| = 1; # Turn off output buffering so messages appear in correct order.
alarm( 3600 ); # Kill process after 1 hour. Legitimate usage could be an hour!
# Restrict PATH and ENV. (But before popen, ENV is cleared!)
delete @ENV{ 'PATH', 'IFS', 'CDPATH', 'ENV', 'BASH_ENV' };

############################## TUNABLE CONSTANTS #############################

emvl::set_debugging( 0 ); # 1 = print debug messages to STDERR logs/error_log

my $data_product = 'ERDDAP';
my $temp_directory = '/data/tmp';
my $temp_file_name = "$temp_directory/erddap_temp.$$";
my $bindir = '/rsig/current/code/bin/Linux.x86_64';
my $dods2bin = "$bindir/dods2bin";
my $tar = '/usr/bin/tar -zcO';
my $curl_command = '/usr/bin/curl -k -g --silent --max-time 3600 --retry 0 -L --max-redirs 10 --tcp-nodelay ';



# Output messages when REQUEST=GetMetadata.
# Print this message first:

my $metadata_content = '
NOAA Environmental Research Division Data Access Program water data accessed using RSIG.
NOAA: https://coastwatch.pfeg.noaa.gov/erddap/info/index.html
RSIG: https://www.epa.gov/rsig
';

# If FORMAT=original then print this message second:

my $metadata_content_original = '
The list of original data files are shown below.

';

# Else FORMAT!=original then print this message second:

my $metadata_content_processed = '
Data processing was done using the RSIG programs erddapserver and dods2bin
used to retrieve and subset (by variable, lon-lat box and time range)
and reorganize/reformat and filter the data.
Processed data files and the RSIG command used to process them
are shown below.

';


################################## VARIABLES #################################

my $depth = '';
my $remote_query = '';

################################## ROUTINES ##################################


main();


sub main {
  my $result = 0;

  # Before calling emvl::parse_url(), specify various options so the default
  # functions work:

  emvl::set_source( $data_product );
  emvl::set_coverage_metadata( erddap::get_coverage_metadata_reference() );
  emvl::append_content_type( 'bin', 'application/octet-stream' );
  emvl::set_required_options_specified( \&required_options_specified );

  if ( ! emvl::parse_url() ) {
    print "Content-type: text/plain; charset=iso-8859-1\n\n"; # For webserver
  } else {
    my $request = emvl::get_request();
    my $format = emvl::get_format();
    my $coverage = emvl::get_coverage();

    if ( $request eq 'getcapabilities' ) {
      print "Content-type: text/xml; charset=iso-8859-1\n\n"; # For webserver
      emvl::print_capabilities();
      $result = 1;
    } elsif ( $request eq 'describecoverage' ) {
      print "Content-type: text/xml; charset=iso-8859-1\n\n"; # For webserver
      emvl::print_coverage_description();
      $result = 1;
    } elsif ( $request eq 'getmetadata' || $request eq 'getcoverage' ) {
      my $command = '';

      if ( $request eq 'getmetadata' ) {
        print "Content-type: text/plain; charset=iso-8859-1\n\n"; # For webserver
        print $metadata_content;
        my $coverage_index = emvl::get_coverage_index();
        my $coverage_metadata_reference =
          erddap::get_coverage_metadata_reference();
        my $coverage_info = $coverage_metadata_reference->[ $coverage_index ];
        $command = construct_command( $coverage_info );
        $result = ( $command ne '' );
      } else {
        my $header = emvl::get_content_type_header(); # Based on parsed FORMAT.
        print "$header\n\n";
        $result = execute_remote_query();
      }

      if ( $result ) {

        if ( $format eq 'original' ) {

          if ( $request eq 'getmetadata' ) {
            print $metadata_content_original;
            print "\n$command\n";
            print "$tar $temp_file_name\n";
          } else {
            $result = execute_command( "$tar $temp_file_name" );
          }
        } else {

          if ( $request eq 'getmetadata' ) {
            print $metadata_content_processed;
            print "\n$remote_query\n";
          }
        }

        if ( ! emvl::get_debugging() ) {

          if ( -f $temp_file_name) {
            emvl::debug( "unlink( $temp_file_name )" );
            unlink( $temp_file_name );
          }
        }
      }
    }
  }

  $result = 1 - $result; # UNIX: zero is success, non-zero is failure.
  emvl::debug( "exit result = $result" );

  # Must return some bytes to avoid 30 second timeout delay when unsuccessful:

  if ( $result != 0 ) {
    print STDOUT "\nFAILED\n";
  }

  exit $result;
}



# Check that all required 'options' have been specified and check/set depth:

sub required_options_specified {
  my $result = emvl::required_options_specified();

  # Also check for valid depth:

  if ( $result ) {
    my @bounds = emvl::get_bounds();
    my $bounds_count = @bounds;

    if ( $bounds_count == 6 ) {
      $result = $bounds[ 4 ] eq $bounds[ 5 ] &&
        emvl::parse_option( $depth, $bounds[ 4 ], 'BBOX(depth)',
                            '0 -10 -20 -30 -50 -75 -100 ' .
                            '-125 -150 -200 -250 -300 -400 -500' );
    } else {
      $depth = 0;
      $result = 1;
    }

    # Also check that format is valid for the coverage:

    if ( $result ) {
      my $format = emvl::get_format();
      my $coverage_lc = lc( emvl::get_coverage() );

      if ( $format eq 'ascii' ) {
        $result =
          index( $coverage_lc, 'gtspp' ) == 0 ||
          index( $coverage_lc, 'ndbc' ) == 0 ||
          index( $coverage_lc, 'neracoossos' ) == 0;
      } elsif ( $format eq 'bin' ) {
        $result =
          index( $coverage_lc, 'gtspp' ) == -1 &&
          index( $coverage_lc, 'ndbc' ) == -1 &&
          index( $coverage_lc, 'neracoossos' ) == -1;
      }
    }
  }

  return $result;
}


# Execute query of remote web service:

sub execute_remote_query {
  my $result = 0;
  my $time_option = emvl::get_time();
  my $start_timestamp = uc( substr( $time_option, 0, 20 ) );
  my $end_timestamp =
    length( $time_option ) == 41 ? uc( substr( $time_option, 21, 20 ) )
    : $start_timestamp;
  my $coverage_index = emvl::get_coverage_index();
  my $coverage_metadata_reference = erddap::get_coverage_metadata_reference();
  my $coverage_info = $coverage_metadata_reference->[ $coverage_index ];
  my $short_name = last_name( $coverage_info->{ name } );
  my $units = $coverage_info->{ units };
  my $min = $coverage_info->{ min };
  my $max = $coverage_info->{ max };
  my $negative_lon = $coverage_info->{ negative_lon };
  my $is_gridded = $coverage_info->{ file_format } eq 'dods';
  my $header_lines = $is_gridded ? -1 : $coverage_info->{ header_lines };
  my $factor =
    exists( $coverage_info->{ factor } ) ? $coverage_info->{ factor } : 1.0;
  my $fields          = $is_gridded ? -1 : $coverage_info->{ fields };
  my $timestamp_index = $is_gridded ? -1 : $coverage_info->{ timestamp };
  my $longitude_index = $is_gridded ? -1 : $coverage_info->{ longitude };
  my $latitude_index  = $is_gridded ? -1 : $coverage_info->{ latitude };
  my $depth_index     = $is_gridded ? -1 : $coverage_info->{ depth };
  my $id_index        = $is_gridded ? -1 : $coverage_info->{ id };
  my $sid_index       = $is_gridded ? -1 : $coverage_info->{ sid };
  my $value_index     = $is_gridded ? -1 : $coverage_info->{ value };
  my $is_wind = $short_name eq 'wind';
  my $is_current = $short_name eq 'current';
  my $is_vector = $is_wind || $is_current;
  my $is_all  = $short_name eq 'all';
  my $is_altitude = index( $coverage_info->{ query }, ',altitude,' ) != -1;
  my $the_pipe = 0;
  my $request = emvl::get_request();
  my $format = emvl::get_format();
  my $coverage = emvl::get_coverage();
  my $command = construct_command( $coverage_info );

  # Untaint command (match expression is arbitrary as far as -T is concerned):

  if ( $command =~ m#^(/[\w-]+/[\w -/.,':?=&<>\[\]\(\)|]+)$# )
  {
    $command = $1; # Re-assign first match, which is enough to satisfy -T.
    emvl::debug( "$0 executing command = $command" );
    %ENV = (); # Unset all environment variables prior to popen.
    # Complicated, supposedly safer way to open a readable pipe to command:
    my $pid = open( the_pipe, "-|" );

    if ( ! defined( $pid ) ) {
      die "Couldn't open pipe to subprocess";
    } elsif ( $pid ) { # Parent process.
      $remote_query .= "$command\n";
      emvl::debug( "reading result of query to remote webservice..." );
      my $line = <the_pipe>; # Read and skip header line.

      if ( defined( $line ) ) { # If remote web service returned a line.
        my $lines_read = 1;
        my $ok = 0;
        emvl::debug( "first line = '$line'" );
        my $temp_file = undef;

        if ( $request eq 'getcoverage' && $format eq 'original' ) {
          open $temp_file, '>', $temp_file_name
            or die "Can't create $temp_file_name: $!";
          emvl::debug( "$temp_file_name = $temp_file_name, temp_file = $temp_file" );
        }

        if ( $is_gridded ) {

          if ( defined( $temp_file ) ) {
            print $temp_file $line;
          } else {
            print $line;
          }

          while ( defined( $line = <the_pipe> ) ) {

            if ( defined( $temp_file ) ) {
              print $temp_file $line;
            } else {
              print $line;
            }
          }

          $result = 1;
        } else { # Read and process point data:
          my @output = ();

          # Read the csv ASCII header for point data:

          $ok = index( $line, ',' ) > 0;
          emvl::debug( "reading csv header ok = $ok" );

          for ( my $i = 1; $ok && $i < $header_lines; ++$i ) {
            $ok = defined( $line = <the_pipe> ) && index( $line, ',' ) != -1;
            emvl::debug( "read header line '$line'" );
          }

          # Read the csv ASCII point data:

          my $previous_longitude = -9999.0;
          my $previous_latitude  = -9999.0;

          while ( defined( $line = <the_pipe> ) ) {

            if ( defined( $temp_file ) ) {
              print $temp_file "$line\n";
            }

            my @values = split( /,/, $line );
            my $count = @values;
            $ok = $count == $fields;

            if ( @output < 5 ) {
              emvl::debug( "read data line = @values ($count), ok = $ok" );
            }

            if ( $ok ) {
              my $longitude = $values[ $longitude_index ];
              my $latitude  = $values[ $latitude_index ];

              if ( $negative_lon == 0 ) {

                if ( $longitude > 180.0 ) {
                  $longitude -= 360.0;
                }
              }

              $ok = emvl::in_range( $longitude, -180.0, 180.0 ) &&
                    emvl::in_range( $latitude, -90.0, 90.0 );

              if ( $ok &&
                   $short_name ne 'station' ||
                   ( ( $longitude != $previous_longitude ||
                       $latitude  != $previous_latitude ) &&
                       ! found_text( sprintf( "\t%12.6f\t%12.6f",
                                     $longitude, $latitude ), \@output ) ) ) {
                $previous_longitude = $longitude;
                $previous_latitude  = $latitude;
                my $timestamp =
                  $timestamp_index == -1 ? -1 : $values[ $timestamp_index ];
                my $id = $id_index == -1 ? -1 : $values[ $id_index ];
                my $sid = $sid_index == -1 ? -1 : $values[ $sid_index ];
                my $depth = $depth_index == -1 ? -1 : $values[ $depth_index ];

                if ( lc( $values[ $depth_index ] ) eq 'nan' ) {
                  $depth = 0.0;
                }

                my $value = $value_index == -1 ? -1 : $values[ $value_index ];
                my $value2 = $is_vector ? $values[ $value_index + 1 ] : -1;

                if ( $is_all ) {
                  $ok = 0;

                  for ( my $i = $value_index; $i < $fields; ++$i ) {
                    my $v = $values[ $i ];

                    if ( $v eq '' || index( $v, 'a' ) != -1 ) {
                      $v = '-9999';
                    } else {
                      my $f = $coverage_info->{ factors }[ $i ];
                      $v *= $f;
                      my $minimum = $coverage_info->{ minimums }[ $i ];
                      my $maximum = $coverage_info->{ maximums }[ $i ];

                      if ( ! emvl::in_range( $v, $minimum, $maximum ) ) {
                        $v = '-9999';
                      } else {
                        $ok = 1;
                      }
                    }

                    $values[ $i ] = $v;
                  }

                } elsif ( $min ne '' ) {
                  $ok = 0;

                  if ( $value eq '' || index( $value, 'a' ) != -1 ) {
                    $value = -9999.0;
                  } else {
                    $value *= $factor;

                    if ( ! emvl::in_range( $value, $min, $max ) ) {
                      $value = -9999.0;
                    } else {
                      $ok = 1;
                    }

                    if ( $ok && $is_wind &&
                         lc( $coverage ) eq 'neracoossos.wind' ) {
                      $ok = 0;

                      if ( $value2 eq '' || index( $value2, 'a' ) != -1 ) {
                        $value2 = -9999.0;
                      } else {

                        if ( ! emvl::in_range( $value2, 0.0, 360.0 ) ) {
                          $value2 = -9999.0;
                        } else {
                          my ( $u, $v ) =
                            emvl::speed_bering_to_u_v( $value, $value2 );
                          $value  = $u;
                          $value2 = $v;
                          $ok = 1;
                        }
                      }
                    } elsif ( $ok && $is_wind ) {
                      $ok = 0;

                      if ( $value2 eq '' || index( $value2, 'a' ) != -1 ) {
                        $value2 = -9999.0;
                      } else {
                        $value2 *= $factor;

                        if ( ! emvl::in_range( $value2, $min, $max ) ) {
                          $value2 = -9999.0;
                        } else {
                          $ok = 1;
                        }
                      }
                    } elsif ( $ok && $is_current ) {
                      $ok = 0;

                      if ( $value2 eq '' || index( $value2, 'a' ) != -1 ) {
                        $value2 = -9999.0;
                      } else {

                        if ( ! emvl::in_range( $value2, 0.0, 360.0 ) ) {
                          $value2 = -9999.0;
                        } else { # Convert (speed, angle) to (u, v):
                          my ( $u, $v ) = speed_angle_to_u_v( $value, $value2 );
                          $value = $u;
                          $value2 = $v;
                          $ok = 1;
                        }
                      }
                    }
                  }
                }

                if ( $ok ) {
                  my $output_line = '';

                  if ( $timestamp_index != -1 ) {
                    $ok = ( $timestamp ge $start_timestamp &&
                            $timestamp le $end_timestamp );

                    if ( $ok ) {
                      $output_line .= "$timestamp\t";
                    }
                  }

                  if ( $ok ) {

                    if ( $id_index != -1 ) {
                      $output_line .= sprintf( "%010d\t", $id );
                    }

                    if ( $sid_index != -1 ) {
                      $output_line .= sprintf( "%10s\t", $sid );
                    }

                    $output_line .= sprintf( "%12.6f\t", $longitude );
                    $output_line .= sprintf( "%12.6f", $latitude );

                    if ( $depth_index != -1 ) {

                      if ( $is_altitude ) {
                        $output_line .= sprintf( "\t%12.6f", $depth );
                      } else {
                        $output_line .= sprintf( "\t%12.6f", -$depth );
                      }
                    }

                    if ( $is_all ) {

                      for ( my $i = $value_index; $i < $fields; ++$i ) {
                        $output_line .= sprintf( "\t%12.6f", $values[ $i ] );
                      }

                    } elsif ( $value_index != -1 ) {
                      $output_line .= sprintf( "\t%12.6f", $value );

                      if ( $is_wind || $is_current ) {
                        $output_line .= sprintf( "\t%12.6f", $value2 );
                      }
                    }

                    push( @output, $output_line );
                  }
                }
              }
            }
          } # End of read loop on pipe.

          my $output_count = @output;

          if ( $output_count && $request eq 'getcoverage' ) {

            if ( $format eq 'original' ) {
              print $temp_file @output;
              $result = 1;
            } else {

              # Write ASCII header and data lines:

              print "$output_count\n"; # Output number of data lines.
              my $header_line = '';

              if ( $timestamp_index != -1 ) {
                $header_line .= "timestamp(UTC)\t";
              }

              if ( $id_index != -1 ) {
                $header_line .= "station_id(-)\t";
              }

              if ( $sid_index != -1 ) {
                $header_line .= "station_name(-)\t";
              }

              $header_line .= "longitude(deg)\tlatitude(deg)";

              if ( $depth_index != -1 ) {

                if ( $is_altitude ) {
                  $header_line .= "\televation(m)";
                } else {
                  $header_line .= "\tdepth(m)";
                }
              }

              if ( $value_index != -1 ) {

                if ( $is_wind ) {
                  $header_line .= "\twind_u($units)\twind_v($units)";
                } elsif ( $is_current ) {
                  $header_line .= "\tcurrent_u($units)\tcurrent_v($units)";
                } elsif ( $is_all ) {
                  $header_line .= $coverage_info->{ output_header };
                } else {
                  $header_line .= "\t$short_name($units)";
                }
              }

              print "$header_line\n";

              for ( my $i = 0; $i < $output_count; ++$i ) {
                print "$output[ $i ]\n";
              }

              $result = 1;
            }
          }
        }

        if ( defined( $temp_file ) ) {
          close( $temp_file );
          $result = 1;
        }
      }

      close( the_pipe );
    } else { # Child process.
      exec( $command ) or die "can't exec program: $!";
    }
  } else {
    print STDERR "\n$0: command contains invalid characters.\n";
  }

  return $result;
}



# Construct a command to query a remote web service:
# my $command = construct_command( $coverage_info );

sub construct_command {
  my ( $coverage_info ) = @_;
  my $name = last_name( $coverage_info->{ name } );
  my $units = $coverage_info->{ units };
  my $min = $coverage_info->{ min };
  my $max = $coverage_info->{ max };
  my $query = $coverage_info->{ query };
  my $negative_lon = $coverage_info->{ negative_lon };
  my $swap_rows =
    exists( $coverage_info->{ swap_rows } ) ? $coverage_info->{ swap_rows } : 0;

  my $format = $coverage_info->{ file_format };
  my $result = "$curl_command '$query'";

  if ( $format eq 'dods' ) {
    $result .= " | $dods2bin $name $units $min $max $swap_rows";
  }

  my $time_option = emvl::get_time();
  my $start_time  = uc( substr( $time_option, 0, 20 ) );
  my $end_time =
    length( $time_option ) == 41 ? uc( substr( $time_option, 21, 20 ) )
    : $start_time;
  my $yyyy1  = substr( $start_time, 0, 4 );
  my $mm1    = substr( $start_time, 5, 2 );
  my $dd1    = substr( $start_time, 8, 2 );
  my $yyyy2  = substr( $end_time, 0, 4 );
  my $mm2    = substr( $end_time, 5, 2 );
  my $dd2    = substr( $end_time, 8, 2 );
  my $min_lon = emvl::get_west();
  my $min_lat = emvl::get_south();
  my $max_lon = emvl::get_east();
  my $max_lat = emvl::get_north();

  if ( $negative_lon == 0 ) { # Convert from [-180, 180] to [0, 360]:

    if ( $min_lon < 0.0 ) {
      $min_lon += 360.0;
    }

    if ( $max_lon < 0.0 ) {
      $max_lon += 360.0;
    }

    if ( $min_lon > $max_lon ) {
      my $swap_temp = $min_lon;
      $min_lon = $max_lon;
      $max_lon = $swap_temp;
    }
  }

  my $previous_day =
    exists( $coverage_info->{ previous_day } ) ?
      $coverage_info->{ previous_day }
    : 0;

  if ( $previous_day == 1 ) {
    emvl::decrement_date_day( $yyyy1, $mm1, $dd1 );
    emvl::decrement_date_day( $yyyy2, $mm2, $dd2 );
    $mm1 = sprintf( "%02d", $mm1 );
    $mm2 = sprintf( "%02d", $mm2 );
    $dd1 = sprintf( "%02d", $dd1 );
    $dd2 = sprintf( "%02d", $dd2 );
  }

  $result =~ s/START_TIME/$start_time/;
  $result =~ s/END_TIME/$end_time/;
  $result =~ s/YYYY1-/$yyyy1-/;
  $result =~ s/YYYY2-/$yyyy2-/;
  $result =~ s/-MM1-/-$mm1-/;
  $result =~ s/-MM2-/-$mm2-/;
  $result =~ s/-DD1/-$dd1/;
  $result =~ s/-DD2/-$dd2/;
  $result =~ s/MIN_LON/$min_lon/;
  $result =~ s/MAX_LON/$max_lon/;
  $result =~ s/MIN_LAT/$min_lat/;
  $result =~ s/MAX_LAT/$max_lat/;

  my $d = $depth < 0 ? -1 * $depth : 0;
  $result =~ s/DEPTH/$d/g;

  # Encode problematic characters:

  $result =~ s/\[/%5B/g;
  $result =~ s/\]/%5D/g;

  return $result;
}



# Parse gridded array variable line which looks like this:
# "     Float32 chlorophyll[time = 2][altitude = 1][latitude = 11][longitude = 22];\n"
# or
# "     Float32 sst[time = 3][latitude = 11][longitude = 11];\n"
# my $ok =
#   parse_data_array_line( $line, $timesteps, $rows, $columns );

sub parse_data_array_line {
  my ( $line, $timesteps, $rows, $columns ) = @_;
  emvl::debug( "read data line: $line" );
  my $result = 0;

  if ( index( $line, '      Float32 ' ) == 0 ||
       index( $line, '      Float64 ' ) == 0 ) {

    $line =~ s/\D/ /g; # Replace non-digits with spaces.
    my @dimensions = split( /\s+/, $line ); # Split line into space-delimited.
    emvl::debug( "dimensions = @dimensions" );
    my $count = @dimensions;
    my $layers = 1;
    my $unused1 = '';
    my $unused2 = '';
    my $bits = 0;

    if ( $count == 5 || $count == 6 ) {
      $bits = $dimensions[ 1 ];
      $timesteps = $dimensions[ 2 ];
      my $next = 3;

      if ( $count == 6 ) {
        $layers = $dimensions[ 3 ];
        $next = 4;
      }

      $rows = $dimensions[ $next ];
      $columns = $dimensions[ $next + 1 ];
      $result = $layers == 1 && $timesteps > 0 && $rows > 0 && $columns > 0;
      emvl::debug( "bits = $bits timesteps = $timesteps layers = $layers " .
             "rows = $rows columns = $columns result = $result" );
    }
  }

  if ( $result == 0 ) {
    $timesteps = $rows = $columns = 0;
  }

  $_[1] = $timesteps;
  $_[2] = $rows;
  $_[3] = $columns;
  return $result;
}



# Last part of dotted name:
# my $name = last_name( 'modis.atlantic.attenuation_coefficient' );
# $name is 'attenuation_coefficient'

sub last_name {
  my $name = shift;
  my @parts = split( /\./, $name );
  my $count = @parts;
  my $label = $parts[ $count - 1 ];
  return $label;
}




# Is text in array of strings?
# my $found = found_text( $text, \@array );

sub found_text {
  my ( $text, $array ) = @_;
  my $count = @$array;
  my $result = 0;

  for ( my $i = $count - 1; $result == 0 && $i >= 0; --$i ) {
    $result = index( $array->[ $i ], $text ) != -1;
  }

  return $result;
}



# Execute command and echo its output to STDOUT.
# E.g., execute_command( '/bin/ls' );

sub execute_command {
  my $command = shift;
  my $result = 0;
  my $the_pipe = 0;

  # -T flag requires untainting $command by matching a minimal regex needed for
  # system commands used by this program.

  if ( $command =~ m#^(/[\w-]+/[\w -/.,':?=&<>\[\]\(\)|]+)$# )
  {
    $command = $1; # Re-assign first match, which is enough to satisfy -T.
    emvl::debug( "$0 executing command = $command" );
    %ENV = (); # Unset all environment variables prior to popen.
    # Complicated, supposedly safer way to open a readable pipe to command:
    my $pid = open( the_pipe, "-|" );

    if ( ! defined( $pid ) ) {
      die "Couldn't open pipe to subprocess";
    } elsif ( $pid ) { # Parent process.

      while ( <the_pipe> ) {
        print;
      }

      close( the_pipe );
      $result = ! $?;
    } else { # Child process.
      exec( $command ) or die "can't exec program: $!";
    }
  } else {
    print STDERR "\n$0: command contains invalid characters.\n";
  }

  return $result;
}
