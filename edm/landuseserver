delete @ENV{ 'PATH', 'IFS', 'CDPATH', 'ENV', 'BASH_ENV' };

############################## TUNABLE CONSTANTS #############################

emvl::set_debugging( 0 ); # 1 = print debug messages to STDERR logs/error_log

my $data_source = 'landuse';
my $temp_directory = '/data/tmp';
my $temp_subdirectory = "$temp_directory/$$";
my $data_directory = '/data/land_use';
my $bindir       = '/rsig/current/code/bin/Linux.x86_64';
my $subsetter    = "$bindir/GridSubset";
my $shapesubset  = "$bindir/ShapeSubset";
my $subsetcsv    = "$bindir/subsetcsv";
my $xdrconvert   = "$bindir/XDRConvert";
my $compressor   = '/usr/bin/gzip -c -1';
my $zip          = '/usr/bin/zip -q -j';
#my $tar          = '/usr/bin/tar -zcO';
my $cat          = '/bin/cat';
my $cp           = '/bin/cp';
my $rm           = '/bin/rm';
my $head         = '/bin/head';
my $grep         = '/bin/grep';
my $awk          = '/bin/awk';

# Output messages when EQUEST=GetMetadata.
# Print this message first:

my $metadata_content = '
US EPA data for US coastal land, water and air accessed using RSIG.
https://www.epa.gov/greeningepa/atlantic-coastal-environmental-sciences-division-acesd-laboratory
EstuaryDataMapper: https://www.epa.gov/edm
