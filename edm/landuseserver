sub main {
  my $result = 0;

  # Before calling emvl::parse_url(), specify various options so the default
  # functions work:

  emvl::set_source( $data_source );
  emvl::set_coverage_metadata( landuse::get_coverage_metadata_reference() );
  emvl::append_content_type( 'bin', 'application/octet-stream' );
  emvl::append_parser( 'aggregate', \&parse_aggregate_option );
  emvl::append_parser( 'mindist', \&parse_mindist_option );
  emvl::append_parser( 'huc', \&parse_huc_option );
  emvl::append_parser( 'hrus', \&parse_hrus_option );
  emvl::append_parser( 'estcode', \&parse_estcode_option );
  emvl::append_parser( 'watershed', \&parse_watershed_option );
  emvl::append_parser( 'comid', \&parse_comid_option );
  emvl::append_parser( 'layer', \&parse_layer_option );
  emvl::set_required_options_specified( \&required_options_specified );
  emvl::set_parse_coverage_option( \&parse_coverage_option );

  if ( ! emvl::parse_url() ) {
    print "Content-type: text/plain; charset=iso-8859-1\n\n"; # For webserver
  } else {
    my $request = emvl::get_request();

    if ( $request eq 'getcapabilities' ) {
      print "Content-type: text/xml; charset=iso-8859-1\n\n"; # For webserver
      emvl::print_capabilities( \&print_coverage_offering_brief );
      $result = 1;
    } elsif ( $request eq 'describecoverage' ) {
      print "Content-type: text/xml; charset=iso-8859-1\n\n"; # For webserver
      emvl::print_coverage_description( \&print_coverage_offering );
      $result = 1;
    } elsif ( $request eq 'getcoverage' ) {
      my $coverage = emvl::get_coverage();

      if ( index( $coverage, '.csv' ) > 0 ) {
        print "Content-type: text/plain; charset=iso-8859-1; \n\n";

        # Stream entire or comid-filtered csv file:

        if ( $comid ne '' ) {
          $command =
            "$head -1 $data_directory/$coverage ; " .
            "$grep '^$comid,' $data_directory/$coverage";
        } else {
          $command = "$cat $data_directory/$coverage";
        }

        $commands .= "$command\n";
        $result = execute_command( $command );
      } else {
        my $header = emvl::get_content_type_header(); # Based on parsed FORMAT.
        print "$header\n\n";
        emvl::debug( "mkdir $temp_subdirectory" );
        mkdir $temp_subdirectory, 0775;
        chmod 0775, $temp_subdirectory; # So they can be removed by staff.

        if ( -d $temp_subdirectory ) {
          $result = construct_command();
          $result = $result && execute_command( $command );

          if ( ! emvl::get_debugging() ) {
            execute_command( "$rm -rf $temp_subdirectory" );
          }
        }
      }
    } elsif ( $request eq 'getmetadata' ) {
      print "Content-type: text/plain; charset=iso-8859-1\n\n"; # For webserver
      my $format = emvl::get_format();
      $result = construct_command();

      if ( $commands ne '' ) {
        print $metadata_content;

        if ( $format eq 'original' ) {
          print $metadata_content_original;
          print "\n$commands\n";
          print "\n";
        } else {
          print $metadata_content_processed;
          print "\n$commands\n\n";
        }
      }
    }
  }

  $result = 1 - $result; # UNIX: zero is success, non-zero is failure.
  emvl::debug( "exit result = $result" );

  # Must return some bytes to avoid 30 second timeout delay when unsuccessful:

  if ( $result != 0 ) {
    print STDOUT "\nFAILED\n";
  }

  exit $result;
}



# Print web server coverage offering brief metadata with layer information.
# Called by emvl::print_capabilities();

sub print_coverage_offering_brief {
  my $coverage_metadata_reference = landuse::get_coverage_metadata_reference();
  my $region_metadata_reference = landuse::get_region_metadata_reference();
  my @regions = landuse::get_regions();
  my $variable_count = scalar @$coverage_metadata_reference;

  foreach my $region ( @regions ) {
    my $region_metadata = $region_metadata_reference->{ $region };

    for ( my $variable_index = 0; $variable_index < $variable_count;
          ++$variable_index ) {

      my $this_entry = $coverage_metadata_reference->[ $variable_index ];
      my $this_variable = $this_entry->{ name };
      my $this_units = $this_entry->{ units };
      my $this_description = $this_entry->{ description };
      my $full_variable = "$region.$this_variable";

      if ( index( $this_variable, 'elevation_' ) == 0 ||
           index( $this_variable, 'gi_bmp_' ) == 0 ||
           index( $this_variable, 'impervious_' ) == 0 ||
           index( $this_variable, 'land_change_20' ) == 0 ||
           index( $this_variable, 'stream_temperature_' ) == 0 ||
           index( $this_variable, 'meris_weekly_cyanobacteria_' ) == 0 ||
           index( $this_variable, 'sentinel_weekly_cyanobacteria_' ) == 0 ||
           index( $this_variable, 'hspf_' ) == 0 ||
           index( $this_variable, 'swat_' ) == 0 ||
           index( $this_variable, 'swmm_' ) == 0 ||
           index( $this_variable, 'greenspace_housing' ) == 0 ) {
        $full_variable = $this_variable; # Non-region dataset.
      }

      if ( exists( $region_metadata->{ $this_variable } ) ) {
        my $variable_metadata = $region_metadata->{ $this_variable };
        my $this_west_bound  = $variable_metadata->{ west_bound };
        my $this_east_bound  = $variable_metadata->{ east_bound };
        my $this_south_bound = $variable_metadata->{ south_bound };
        my $this_north_bound = $variable_metadata->{ north_bound };

        print "        <CoverageOfferingBrief>\n";
        print "            <name>$data_source.$full_variable</name>\n";
        print "            <label>$this_variable($this_units)</label>\n";
        print "            <description>$this_description</description>\n";
        print '            <lonLatEnvelope srsName="WGS84(DD)">' . "\n";
        print "                <gml:pos>$this_west_bound $this_south_bound</gml:pos>\n";
        print "                <gml:pos>$this_east_bound $this_north_bound</gml:pos>\n";
        print "            </lonLatEnvelope>\n";
        print "        </CoverageOfferingBrief>\n";
      }
    }
  }
}



