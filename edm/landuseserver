# Custom parse coverage option. UGLY.
# Called by emvl::parse_coverage().
# Must return matched coverage string or '' if not found.

sub parse_coverage_option {
  my $value = shift;
  my $result = '';
  my $ok = 0;

  if ( index( $value, '.iclus_' ) != -1 ) {
    my @parts = split( /\./, $value );
    my $count = @parts;
    my $empty = '';

    if ( $count != 2 ||
      ! emvl::parse_option( $empty, $parts[0], 'COVERAGE',
                            'atlantic gulf pacific alaska hawaii' ) ) {
      print STDERR "\nInvalid COVERAGE option: '$value'\n";
    } else {
      my $rest = $parts[1];
      @parts = split( /_/, $rest );
      $count = @parts;

      if ( $count != 3 ) {
        print STDERR "\nInvalid COVERAGE option: '$value'\n";
      } else {
        my $type     = $parts[0];
        my $scenario = $parts[1];
        my $year     = $parts[2];
        $empty = '';
        $ok = emvl::parse_option($empty, $type, 'COVERAGE', 'iclus population');
        $empty = '';
        $ok = $ok &&
          emvl::parse_option( $empty, $scenario, 'COVERAGE','a1 a2 b1 b2 bc' );
        $empty = '';
        $ok = $ok &&
          emvl::parse_option( $empty, $year, 'COVERAGE',
                              '2000 ' .
                              '2010 2020 2030 2040 2050 2060 2070 ' .
                              '2080 2090 2100' );
      }

      if ( $ok ) {
        $result = $value;
      }
    }
  } else {
    my $coverages_reference = landuse::get_coverages_reference();
    my $count = scalar @$coverages_reference;

    for ( my $i = 0; $i < $count; ++$i ) {
      my $c = $coverages_reference->[ $i ];

      if ( $value eq lc( $c ) ) {
        $result = $c;
        $ok = 1;
        $i = $count;
      }
    }
  }

  return $result;
}



# Parse mindist option.

sub parse_mindist_option {
  my $value = shift;
  my $result = 0;

  if ( $mindist ne '' ) {
    print STDERR "\nRedundant MINDIST option: '$value'\n";
  } else {
    $mindist = $value;
    my $is_valid = emvl::in_range( $mindist, 0.0, 1.0 );

    if ( ! $is_valid ) {
      print STDERR "\nInvalid MINDIST option: '$value'\n";
    } else {
      $result = 1;
    }
  }

  return $result;
}



# Parse huc option.

sub parse_huc_option {
  my $value = shift;
  my $result = 0;

  if ( $huc ne '' ) {
    print STDERR "\nRedundant HUC option: '$value'\n";
  } else {
    $huc = int( $value );
    my $is_valid = emvl::in_range( $huc, 0, 9e12 );

    if ( ! $is_valid ) {
      print STDERR "\nInvalid HUC option: '$value'\n";
    } else {
      $result = 1;
    }
  }

  return $result;
}



# Parse hrus option.

sub parse_hrus_option {
  my $value = shift;
  my $result = 0;

  if ( $hrus ne '' ) {
    print STDERR "\nRedundant HRUS option: '$value'\n";
  } else {
    $hrus = int( $value );
    my $is_valid = $hrus == 0 || $hrus == 1;

    if ( ! $is_valid ) {
      print STDERR "\nInvalid HRUS option: '$value'\n";
    } else {
      $result = 1;
    }
  }

  return $result;
}



# Parse estcode option.

sub parse_estcode_option {
  $_ = uc( shift );
  my $result = 0;

  if ( $estcode ne '' ) {
    print STDERR "\nRedundant ESTCODE/WATERSHED option: '$_'\n";
  } else {
    s/[^A-Z0-9]/_/go;
    my $value = $_;
    my $len = length( $value );

    if ( $len == 4 || $len == 5 ) {

      if ( $value =~ m#^([A-Z]+[A-Z0-9]+)$# )
      {
        $estcode = $1;
        $result = 1;
      }
    }

    if ( $result == 0 ) {
      print STDERR "\nInvalid ESTCODE option: '$_'\n";
    }
  }

  return $result;
}



# Parse watershed option (store in $estcode).

sub parse_watershed_option {
  $_ = uc( shift );
  my $result = 0;

  if ( $estcode ne '' ) {
    print STDERR "\nRedundant ESTCODE/WATERSHED option: '$_'\n";
  } else {
    s/[^A-Z0-9_\/]/_/go;
    my $value = $_;
    emvl::debug( "parse_watershed_option filtered value = '$value'" );

    if ( $value =~ m#^([A-Z]+[A-Z0-9_\/]+)$# )
    {
        $estcode = $1;
        $result = 1;
    }

    if ( $result == 0 ) {
      print STDERR "\nInvalid WATERSHED option: '$_'\n";
    }
  }

  return $result;
}




# Parse comid option.

sub parse_comid_option {
  $_ = shift;
  my $result = 0;

  if ( $comid ne '' ) {
    print STDERR "\nRedundant COMID option: '$_'\n";
  } else {
    s/[^0-9]/_/go;
    my $value = $_;
    my $len = length( $value );

    if ( $len > 0 ) {

      if ( $value =~ m#^([0-9]+[0-9]+)$# )
      {

        if ( $value > 0 ) {
          $comid = $1;
          $result = 1;
        }
      }
    }

    if ( $result == 0 ) {
      print STDERR "\nInvalid COMID option: '$_'\n";
    }
  }

  return $result;
}



# Parse aggregate option.

sub parse_aggregate_option {
  my $value = shift;
  my $result = 0;

  if ( $aggregate_method ne '' ) {
    print STDERR "\nRedundant AGGREGATE option: '$value'\n";
  } else {
    my @parts = split( /,/, $value );
    my $count = @parts;

    if ( $count == 2 && $parts[ 0 ] > 0 &&
         ( $parts[ 1 ] eq 'mean' || $parts[ 1 ] eq 'mode' ) ) {
      $aggregate_size = $parts[ 0 ];
      $aggregate_method = $parts[ 1 ];
      $result = 1;
    } else {
      print STDERR "\nInvalid AGGREGATE option: '$value'\n";
    }
  }

  return $result;
}




# Parse layer option.

sub parse_layer_option {
  my $value = shift;
  my $result =
    emvl::parse_option( $layer, $value, 'LAYER', 'surface middle bottom' );

  if ( $result == 1 ) { # Capitalize first letter to match csv file content:
    $layer = uc( substr( $layer, 0, 1 ) ) . substr( $layer, 1 );
  }

  return $result;
}




# Check that all required 'options' have been specified:

sub required_options_specified {
  my $result = 0;

  if ( emvl::get_service() eq '' ) {
    print STDERR "\nMissing option: 'SERVICE'\n";
  } elsif ( emvl::get_version() eq '' ) {
    print STDERR "\nMissing option: 'VERSION'\n";
  } elsif ( emvl::get_request() eq '' ) {
    print STDERR "\nMissing option: 'REQUEST'\n";
  } elsif ( emvl::get_request() eq 'getcoverage' ) {
    my $coverage = emvl::get_coverage();

    if ( $coverage eq '' ) {
      print STDERR "\nMissing option: 'COVERAGE'\n";
    } elsif ( index( $coverage, '.csv' ) > 0 ) {
      #$format = 'ascii';
      $result = 1;
    } elsif ( emvl::get_format() eq '' ) {
      print STDERR "\nMissing option: 'FORMAT'\n";
    } elsif ( emvl::get_time() eq '' ) {
      print STDERR "\nMissing option: 'TIME'\n";
    } elsif ( emvl::get_bbox() eq '' &&
              index( $coverage, 'hspf_' ) == -1 &&
              index( $coverage, 'swat_' ) == -1 &&
              index( $coverage, 'swmm_' ) == -1 &&
              index( $coverage, 'greenspace_housing' ) == -1 ) {
      print STDERR "\nMissing option: 'BBOX'\n";
    } elsif ( emvl::get_format() eq 'zip' &&
              index( $coverage, 'hspf_' ) == -1 &&
              index( $coverage, 'swat_' ) == -1 &&
              index( $coverage, 'swmm_' ) == -1 &&
              index( $coverage, 'greenspace_housing' ) == -1 &&
              index( $coverage, 'flowlines' ) == -1 ) {
      print STDERR "\nFORMAT=zip is only valid with COVERAGE=hspf_... or " .
                   "COVERAGE=swat_... or COVERAGE=swmm_... or " .
                   "COVERAGE=greenspace_housing... or " .
                   "COVERAGE=flowlines...\n";
    } elsif ( $huc ne '' &&
              index( $coverage, 'hspf_' ) == -1 &&
              index( $coverage, 'swat_' ) == -1 &&
              index( $coverage, 'swmm_' ) == -1 &&
              index( $coverage, 'greenspace_housing' ) == -1 ) {
      print STDERR "\nHUC option is only valid with COVERAGE=hspf_... or " .
                   "COVERAGE=swat_... or COVERAGE=swmm_..." .
                   "or COVERAGE=greenspace_housing...\n";
    } elsif ( $hrus ne '' &&
              index( $coverage, 'hspf_' ) == -1 &&
              index( $coverage, 'swat_' ) == -1 &&
              index( $coverage, 'swmm_' ) == -1 ) {
      print STDERR "\nHRUS option is only valid with COVERAGE=hspf_... or " .
                   "COVERAGE=swat_... or COVERAGE=swmm_...\n";
    } elsif ( $comid ne '' &&
              index( $coverage, 'flowlines' ) == -1 ) {
      print STDERR "\nCOMID option is only valid with COVERAGE=flowlines...\n";
    } else {
      $result = 1;
    }
  } else {
    $result = 1;
  }

  return $result;
}



# Construct command. UGLY.

sub construct_command {
  my $result = 1;
  my $format = emvl::get_format();
  my $coverage = emvl::get_coverage();
  my @parts = split( /\./, $coverage );
  my $region = $parts[ 0 ];
  my $variable = $coverage;
  $variable =~ s/$region\.//;
  $variable =~ s/\.estuary_cmaq/_estuary_cmaq/;
  $variable =~ s/\.subestuary_cmaq/_subestuary_cmaq/;
  $variable =~ s/\.source_watershed_cmaq/_source_watershed_cmaq/;
  $variable =~ s/nitrogen./nitrogen_/;
  $variable =~ s/no3\./no3_/;
  $variable =~ s/nh4\./nh4_/;
  $variable =~ s/phosphorus\./phosphorus_/;
  emvl::debug( "variable = $variable" );
  my $is_sediment = ( substr( $variable, 0, 9 ) eq 'sediment_' );
  my $is_sediment_nca = ( substr( $variable, 0, 13 ) eq 'sediment_nca_' );
  my $is_sediment_gridded =
    ( $is_sediment && index( $variable, '_gridded' ) != -1 );
  my $is_esat1 = index( $coverage, 'esat1_water_quality' ) != -1;
  my $is_esat2 = index( $coverage, 'esat2_water_quality' ) != -1;
  my $is_shapeFile =
    $is_esat1 || $is_esat2 ||
    $variable eq 'wetlands' ||
    substr( $variable, 0, 10 ) eq 'population' ||
    ( $is_sediment && ! $is_sediment_gridded ) ||
    $variable eq 'states' ||
    $variable eq 'provinces' ||
    $variable eq 'counties' ||
    $variable eq 'cities' ||
    $variable eq 'roads' ||
    $variable eq 'tributaries' ||
    $variable eq 'hucs' ||
    index( $variable, 'watershed' ) != -1 ||
    index( $variable, 'estuar' ) != -1 ||
    index( $variable, 'catchment' ) != -1 ||
    $variable eq 'lakes' ||
    $variable eq 'coastal_zone_management_areas' ||
    $variable eq 'legislative_districts' ||
    $variable eq 'soil' ||
    $variable eq 'coastal_vulnerability' ||
    $variable eq 'gi_bmp_installations_new_england' ||
    $variable eq 'land_change_2020_current_chesapeake' ||
    $variable eq 'land_change_2030_current_chesapeake' ||
    $variable eq 'land_change_2040_current_chesapeake' ||
    $variable eq 'land_change_2020_deregulation_chesapeake' ||
    $variable eq 'land_change_2030_deregulation_chesapeake' ||
    $variable eq 'land_change_2040_deregulation_chesapeake' ||
    $variable eq 'land_change_2020_redevelopment_chesapeake' ||
    $variable eq 'land_change_2030_redevelopment_chesapeake' ||
    $variable eq 'land_change_2040_redevelopment_chesapeake' ||
    $variable eq 'land_change_2020_conservation_chesapeake' ||
    $variable eq 'land_change_2030_conservation_chesapeake' ||
    $variable eq 'land_change_2040_conservation_chesapeake' ||
    $variable eq 'impervious_nhdplus_new_england' ||
    index( $variable, 'stream_temperature_point_' ) != -1 ||
    index( $variable, 'stream_temperature_line_' ) != -1 ||
    index( $variable, 'stream_shade_line_' ) != -1 ||
    index( $coverage, 'hspf_' ) != -1 ||
    index( $coverage, 'swat_' ) != -1 ||
    index( $coverage, 'swmm_' ) != -1 ||
    index( $coverage, 'greenspace_housing' ) != -1 ||
    index( $coverage, 'stream_discharge_' ) != -1 ||
    index( $coverage, 'tide_point' ) != -1 ||
    index( $coverage, 'tide_current' ) != -1 ||
    index( $coverage, 'longshore_current' ) != -1 ||
    index( $coverage, 'estuary_flushing' ) != -1 ||
    index( $coverage, 'salinity_point' ) != -1 ||
    index( $coverage, 'seagrass_point' ) != -1 ||
    index( $coverage, 'seagrass_polygon' ) != -1 ||
    index( $coverage, 'flowlines_' ) != -1 ||
    index( $coverage, 'discharge_points_' ) != -1;

  my $my_compressor = '';
  my $compress = emvl::get_compress();

  if ( $compress ne '' && $compress == 1 && $format ne 'zip' ) {
    $my_compressor = " | $compressor";
  }

  # HACK for grid file elevation_kennebec_river_estuary_me_mllw:

  if ( $is_shapeFile == 1 && index( $variable, 'elevation' ) == 0 ) {
    $is_shapeFile = 0;
  }

  if ( $is_shapeFile ) {
    my $subset_option = '';

    if ( $huc ne '' ) {
      $subset_option = " -huc $huc";
    } elsif ( $comid ne '' ) {
      $subset_option = " -comid $comid";
    } else {
      my $west_south_east_north = emvl::get_west_south_east_north();
      $subset_option =  " -subset $west_south_east_north";

      if ( $estcode ne '' ) {
        $subset_option .= " -estcode $estcode";
      }
    }

    my $is_wsm =
      index( $coverage, 'hspf_' ) != -1 ||
      index( $coverage, 'swat_' ) != -1 ||
      index( $coverage, 'swmm_' ) != -1;

    my $is_seagrass = index( $coverage, '.seagrass_' ) != -1;

    my $has_csv =
      $is_wsm ||
      index( $coverage, '.stream_discharge_' ) != -1 ||
      index( $coverage, '.tide_point'        ) != -1 ||
      index( $coverage, '.tide_current'      ) != -1 ||
      index( $coverage, '.longshore_current' ) != -1 ||
      index( $coverage, '.estuary_flushing'  ) != -1 ||
      index( $coverage, '.seagrass_polygon'  ) != -1 ||
      index( $coverage, '.seagrass_point2'   ) != -1 ||
      index( $coverage, 'esat1_water_quality') != -1 ||
      index( $coverage, 'esat2_water_quality') != -1 ||
      index( $coverage, 'flowlines_' ) == 0;

    if ( $has_csv ) { # Time-subset csv file:
      my @parts = split( /\./, $coverage );
      my $part_count = @parts;
      my $shp_base = '';
      my $csv_var  = '';
      my $region = '';
      my $aggregation = '';
      my $method = '';
      my $csv_subdirectory = '';
      emvl::debug( "part_count = $part_count" );

      if ( $part_count == 1 ) {
        $shp_base = $variable; # flowlines_upper_ct_river
      } elsif ( $is_seagrass ) { # Seagrass files are not time-stamped:
        $region = $parts[ 0 ]; # pacific
        $shp_base = $parts[ 1 ]; # seagrass_polygon.
      } elsif ( $is_wsm && $part_count == 2 ) { # WSM files are time-stamped:
        $shp_base = $parts[ 0 ];
        $csv_var  = $parts[ 1 ];
        my $i = index( $shp_base, '_huc' );

        if ( $i != -1 ) {
          my $name = substr( $shp_base, 0, $i );
          my $model = $name;
          $model =~ tr/[0-9]//dc; # Remove non-digits;
          my $csv_name = $name . '_' . $csv_var;
          my $csv_file = $csv_name;
          my $csv_start = 1960;
          my $csv_end   = 2015;
          emvl::debug( "name = $name, csv_var = $csv_var, model = $model" );

          # Adjust $csv_start:

          if ( $model >= 34 && $model <= 73 ) {
            $csv_start = 1975;
          } elsif ( index( $name, '_charles' ) != -1 ||
                    index( $name, '_ipswich' ) != -1 ) {
            $csv_start = 1961;
          } elsif ( index( $name, '_farmington' ) != -1 ) {
            $csv_start = 1970;
          }

          # Adjust $csv_end:

          if ( $model >= 34 && $model <= 73 ) {
            $csv_end = 2004;
          } elsif ( index( $name, 'hspf_farmington' ) != -1 ) {
            $csv_end = 2005;
          } elsif ( index( $name, 'hspf_charles'    ) != -1 ||
                    index( $name, 'hspf_blackstone' ) != -1 ||
                    index( $name, 'hspf_sudbury'    ) != -1 ||
                    index( $name, 'hspf_taunton'    ) != -1 ||
                    index( $name, 'hspf_ipswich'    ) != -1 ||
                    ( index( $name, 'hspf_pawcatuck' ) != -1 &&
                      $csv_var eq 'recharge_adjustment' ) ) {
            $csv_end = 2009;
          } elsif ( index( $name, 'hspf_pawcatuck' ) != -1 &&
                    $csv_var eq 'hydrology' ) {
            $csv_end = 1999;
          }

          my $yyyy1 = int( emvl::get_yyyymmdd1() / 100 );
          my $yyyy2 = int( emvl::get_yyyymmdd2() / 100 );
          my $outside = $yyyy2 < $csv_start || $yyyy1 > $csv_end ? 1 : 0;

          if ( ! $outside ) {
            $csv_file .= '_' . $csv_start . '_' . $csv_end . '.csv';

            my $pathed_csv_file = "$data_directory/$csv_file";
            $tmp_csv_file = "$temp_subdirectory/$shp_base" . "_$csv_var.csv";

            my $filter_hru_columns = 0;

            if ( $hrus eq '0' ) {
              $filter_hru_columns = 1;
            }

            $result =
              subset_csv_file( $pathed_csv_file,
                               emvl::get_yyyymmddhh1(),
                               emvl::get_yyyymmddhh2(),
                               $filter_hru_columns, 0, 0, $tmp_csv_file );
          }
        }
      } elsif ( $is_esat1 || $is_esat2 ) { # esat1/2 files are time-stamped:
        $result = 0;
        my $csv_start = $is_esat1 ? 1984 : 2018;
        my $csv_end   = $is_esat1 ? 2021 : 2020;
        my $yyyy1 = int( emvl::get_yyyymmdd1() / 100 );
        my $yyyy2 = int( emvl::get_yyyymmdd2() / 100 );
        my $outside = $yyyy2 < $csv_start || $yyyy1 > $csv_end ? 1 : 0;

        emvl::debug("is_esat1 = $is_esat1, is_esat2 = $is_esat2, outside = $outside");

        if ( ! $outside ) {
          $region = $parts[ 0 ];
          $shp_base = $parts[ 1 ] . "_$csv_start-$csv_end";
          my $csv_file = $shp_base . "_$region.csv";
          my $pathed_csv_file = "$data_directory/$csv_file";
          $tmp_csv_file = "$temp_subdirectory/$parts[1].csv";
          my $match_layer = 0;

          if ( $layer ne '' ) {
            $match_layer = 1;
          }

          $result =
            subset_csv_file( $pathed_csv_file,
                             emvl::get_yyyymmddhh1(), emvl::get_yyyymmddhh2(),
                             0, 1, $match_layer, $tmp_csv_file );
        }

        if ( $result == 0 ) {
          return 0;
        }

      } elsif ( $part_count == 3 ) { # atlantic.monthly.stream_discharge_nhd_line
        $region      = $parts[ 0 ]; # atlantic
        $aggregation = $parts[ 1 ]; # monthly
        $shp_base    = $parts[ 2 ]; # stream_discharge_nhd_line
        my @parts = split( /_/, $shp_base );
        my $part_count = @parts;

        if ( $part_count > 3 ) {
          $csv_subdirectory = $parts[0] . '_' . $parts[1]; # stream_discharge
        } elsif ( $part_count == 3 ) { # estuary_flushing_ffm
          $shp_base = $parts[0] . '_' . $parts[1]; # estuary_flushing
          $csv_subdirectory = $shp_base;
          $method = $parts[ 2 ]; # ffm
        } else {
          $csv_subdirectory = $shp_base; # tide_point
        }

        $result = 1;
      }

      if ( $result ) {
        my $is_point =
          $is_esat1 || $is_esat2 ||
          index( $shp_base, '_point' ) != -1 ||
          index( $coverage, '.stream_discharge_usgs_' ) != -1;

        emvl::debug("shp_base = '$shp_base', is_point = $is_point");

        my $mindist_option = '';
        my $dbf_option = '';

        if ( $is_point && $format eq 'bin' ) {
          $dbf_option = '-dbf_only';
        }

        if ( $dbf_option eq '' && $mindist ne '' && $mindist != 0.0 ) {
          $mindist_option = "-mindist $mindist";
        }

        my $no_stream_option = '';

        if ( $format eq 'zip' ) {
          $no_stream_option = '-no_stream';
        }

        my $pathed_shp_base =
          $region ne '' ? "$data_directory/$shp_base" . "_$region"
          : "$data_directory/$shp_base";
        my $tmp_base =
          $csv_var ne '' ? "$temp_subdirectory/$shp_base" . "_$csv_var"
          : $aggregation ne '' ? "$temp_subdirectory/$aggregation" . "_$shp_base"
          : $is_esat1 ? $tmp_csv_file = "$temp_subdirectory/$parts[1]"
          : $is_esat2 ? $tmp_csv_file = "$temp_subdirectory/$parts[1]"
          : "$temp_subdirectory/$shp_base";

        if ( $method ne '' ) {
          $tmp_base .= "_$method";
        }

        emvl::debug( "pathed_shp_base = $pathed_shp_base" );
        emvl::debug( "tmp_base = $tmp_base" );

        my $input_csv = '';
        my $time_option = '';

        if ( index( $coverage, 'flowlines_' ) == 0 ) {
          $input_csv    = "$data_directory/$shp_base.csv";
          $tmp_csv_file = "$temp_subdirectory/$shp_base.csv";

          # If flowlines watershed_name_value was specified (in $estcode) then
          # extract all csv lines with 2nd column matching the specified estcode
          # (watershed_name) after converting spaces to underscores:

          if ( $comid eq '' && $estcode ne '' &&
               $coverage eq 'flowlines_puget_sound_watershed' ) {

            $command =
              "$head -1 $input_csv > $tmp_csv_file ; " .
              "$awk -F, -v w=$estcode 'BEGIN { w = tolower( w ); w_len = length( w ) } { if ( NR > 1 && length( \$2 ) == w_len ) { v = tolower( \$2 ); m = 1; for ( i = 1; m == 1 && i <= w_len; ++i ) { wc = substr( w, i, 1 ); vc = substr( v, i, 1 ); m = ( vc == wc || vc == \" \" && wc == \"_\" ) } if ( m == 1 ) print } }' < $input_csv >> $tmp_csv_file";

            $commands .= "$command\n";
            emvl::debug( "csv extract command = $command\n" );
            my $ok = execute_command( $command );
            $input_csv = $tmp_csv_file;
            emvl::debug( "$input_csv, ok = $ok\n" );
          }
        } elsif ( index( $coverage, ".seagrass_polygon" ) != -1 ||
                  index( $coverage, ".seagrass_point2" ) != -1 ||
                  index( $coverage, ".csv" ) != -1 ) {

          # Extract all csv lines that begin with the specified estcode:

          $input_csv    = "$pathed_shp_base.csv";
          $tmp_csv_file = "$temp_directory/$shp_base.csv";
          my $continue_without_csv = 0;
          my $remove_csv_file_if_empty = '';

          if ( $continue_without_csv ) {
            $remove_csv_file_if_empty =
              " ; if [ $? != 0 ] ; then $rm $tmp_csv_file ; fi";
          }

          $command =
              "$head -1 $input_csv > $tmp_csv_file ; " .
              "$grep '^$estcode,' $input_csv >> $tmp_csv_file" .
              $remove_csv_file_if_empty;

          $commands .= "$command\n";
          emvl::debug( "csv extract command = $command\n" );
          my $ok = execute_command( $command );
          $input_csv = $tmp_csv_file;
          emvl::debug( "$input_csv, ok = $ok\n" );
        } elsif ( $is_esat1 || $is_esat2 ) {
          $input_csv    = "$tmp_base.csv";
          $tmp_csv_file = "$temp_directory/$shp_base.csv";
        } elsif ( $csv_subdirectory eq '' ) {
          $input_csv = $tmp_csv_file; # Set to created subset csv output file.
        } else { # Set to input directory of csv files:

          if ( $method ne '' ) {
            $input_csv =
              "$data_directory/$csv_subdirectory/$aggregation/$method/$region";
            $tmp_csv_file =
              "$temp_subdirectory/$aggregation" . "_$method" . "_$shp_base.csv";
          } else {
            $input_csv = "$data_directory/$csv_subdirectory/$aggregation/$region";
            $tmp_csv_file = "$temp_subdirectory/$aggregation" . "_$shp_base.csv";
          }

          my $yyyymmdd1 = emvl::get_yyyymmdd1();
          my $yyyymmdd2 = emvl::get_yyyymmdd2();
          $time_option = " -time $yyyymmdd1 $yyyymmdd2";
        }

        my $csv_option = '';

        if ( -f $input_csv || -d $input_csv ) {
          $csv_option = " -csv $input_csv ";
        }

        $command =
          "$shapesubset -input $pathed_shp_base $subset_option $dbf_option " .
          "$mindist_option " .
          "$time_option $csv_option -output $tmp_base $no_stream_option" .
          "$my_compressor";

        $commands .= "$command\n";

        if ( $format eq 'zip' ) { # Called by SWMM for zip file:
          my $prj_file     = "$data_directory/$shp_base.prj";
          my $xml_file     = "$data_directory/$shp_base.xml";
          my $iso_xml_file = "$data_directory/$shp_base" . "_iso.xml";
          my $txt_file     = $is_wsm ? "$data_directory/wsm_metadata.txt" : '';
          my $tmp_zip_file     = $tmp_base . '.zip';
          my $tmp_shx_file     = $tmp_base . '.shx';
          my $tmp_shp_file     = $tmp_base . '.shp';
          my $tmp_dbf_file     = $tmp_base . '.dbf';
          my $tmp_prj_file     = $tmp_base . '.prj';
          my $tmp_xml_file     = $tmp_base . '.xml';
          my $tmp_iso_xml_file = $tmp_base . '_iso.xml';
          my $tmp_txt_file = $is_wsm ? "$temp_subdirectory/wsm_metadata.txt" : '';
          my $cp_tmp_iso_xml_file =
            " ; $cp -p $iso_xml_file $tmp_iso_xml_file ";
          my $cp_tmp_txt_file =
            " ; $cp -p $txt_file $tmp_txt_file ";

          if ( ! -f $iso_xml_file ) {
            $tmp_iso_xml_file = '';
            $cp_tmp_iso_xml_file = '';
          }

          if ( ! -f $txt_file ) {
            $txt_file = '';
            $cp_tmp_txt_file = '';
          }

          $command .=
            " ; $cp -p $prj_file $tmp_prj_file " .
            " ; $cp -p $xml_file $tmp_xml_file " .
            $cp_tmp_iso_xml_file .
            $cp_tmp_txt_file .
            " ; $zip $tmp_zip_file " .
            "        $tmp_shx_file $tmp_shp_file $tmp_dbf_file " .
            "        $tmp_prj_file $tmp_xml_file $tmp_iso_xml_file " .
            "        $tmp_csv_file " .
            "        $tmp_txt_file " .
            " ; $cat $tmp_zip_file";

          $commands .= "$command\n";
        }
      }

    } else { # Call ShapeSubset to process shapefiles:
      my $my_variable = $variable;
      my $data_file = $data_directory . '/';
      my $my_extra_options = '';
      my $my_mindist = '-mindist 0';

      if ( $variable eq 'wetlands' && $region eq 'atlantic' ) {

        if ( emvl::get_north() < 37.0 ) { # Maximum latitude is below NC
          $data_file .= 'wetlands_south-atlantic';
        } elsif ( emvl::get_south() > 36.0 ) { # Minimum latitude is above NC
          $data_file .= 'wetlands_north-atlantic';
        } else { # Must process two input files for NC coast.
          $data_file .= 'wetlands_south-atlantic';
          $data_file .= " $data_directory/wetlands_north-atlantic";
        }
      } elsif ( index( $variable, 'gi_bmp' ) != -1 ||
                index( $variable, 'stream_temperature_point' ) != -1 ) {
        $data_file .= $my_variable;
        $my_extra_options = '-dbf_only';
      } elsif ( index( $variable, 'land_change_' ) != -1 ||
                index( $variable, 'impervious_nhdplus_' ) != -1 ||
                index( $variable, 'stream_temperature_line_' ) != -1 ||
                index( $variable, 'stream_shade_line_' ) != -1 ||
                index( $variable, 'greenspace_housing' ) != -1 ) {
        $data_file .= $my_variable;
      } elsif ( $region ne $my_variable ) {
        $data_file .= $my_variable . '_' . $region;
      } else {
        $data_file .= $my_variable;
      }

      if ( $variable eq 'salinity_point' || $is_sediment_nca ) {
        my $yyyymmdd1 = emvl::get_yyyymmdd1();
        my $yyyymmdd2 = emvl::get_yyyymmdd2();
        $my_extra_options = "-time $yyyymmdd1 $yyyymmdd2";
        $my_extra_options .= ' -dbf_only';
      } elsif ( ( $is_sediment && $variable ne 'sediment_kriged' ) ||
                index( $coverage, '.seagrass_point' ) != -1 ||
                index( $coverage, 'discharge_point' ) != -1 ) {
        $my_extra_options = '-dbf_only';
      } elsif ( $mindist ne '' ) {
        $my_mindist = "-mindist $mindist";
      }

      $command =
        "$shapesubset -input $data_file $subset_option" .
        " $my_extra_options $my_mindist -output $temp_subdirectory/$my_variable" .
        " $my_compressor";

      $commands .= "$command\n";
    }

  } else { # Gridded files:
    my $time_subset_option = '';
    my $my_variable = $variable;
    my $is_nadp_gridded = index( $variable, 'nadp.gridded' ) != -1;
    my $is_nadpcmaq_gridded = index( $variable, 'nadpcmaq.gridded' ) != -1;
    $my_variable =~ s/nadp.gridded.annual_/annual_nadp_/;
    $my_variable =~ s/nadpcmaq.gridded.annual_/annual_nadpcmaq_/;
    $my_variable =~ s/source_gridded.//;

    if ( $variable eq 'monthly_precipitation_mean' ||
         $variable eq 'monthly_temperature_minimum' ||
         $variable eq 'monthly_temperature_maximum' ) {
      $my_variable .= "_01_12";
    } elsif ( $variable eq 'precipitation_mean' || # Old
         $variable eq 'temperature_minimum' ||
         $variable eq 'temperature_maximum' ) {
           my $mm = substr( emvl::get_time(), 5, 2 );
      $my_variable .= "_$mm";
    } elsif ( $variable eq 'annual_temperature_minimum' ) {
      $my_variable = 'temperature_minimum_00';
    } elsif ( $variable eq 'annual_temperature_maximum' ) {
      $my_variable = 'temperature_maximum_00';
    } elsif ( $variable eq 'annual_precipitation_mean' ) {
      $my_variable = 'precipitation_mean_00';
    } elsif ( $variable eq 'seagrass' ) {

      if ( $region eq 'atlantic' ) {

        if ( emvl::get_north() < 37.53 ) { # Max lat is below VA:
          $region = 'south-atlantic';
        } else {
          $region = 'north-atlantic';
        }

      } elsif ( $region eq 'pacific' ) {

        if ( emvl::get_north() < 43.0 ) {
          $region = 'south-pacific';
        } else {
          $region = 'north-pacific';
        }
      }
    } elsif ( $is_sediment_gridded ) {
      $my_variable =~ s/_gridded//;
    }

    my $my_format = $format;
    my $my_xdrconvert = '';
    my $aggregate_option = '';

    emvl::debug( "is-gridded: $variable" );

    # Use multi-timestep grid file for NADP and NADP+CMAQ gridded data:

    if ( $is_nadp_gridded || $is_nadpcmaq_gridded ) {
      my $yyyy1 = int( emvl::get_yyyymmdd1() / 100 );
      my $yyyy2 = int( emvl::get_yyyymmdd2() / 100 );
      my $dataStartYear = $is_nadp_gridded ? 1985 : 2000;
      my $dataEndYear = 2014;
      my $outside = $yyyy2 < $dataStartYear || $yyyy1 > $dataEndYear ? 1 : 0;

      if ( ! $outside ) {
        $my_variable .= "_$dataStartYear" . "_$dataEndYear";

        # Compute new time-subset range option for GridSubset:

        my $t1 = $yyyy1 - $dataStartYear;
        my $first = $t1 < 0 ? 0 : $t1;
        my $t2 = $yyyy2 - $dataStartYear;
        my $dataYearsDifference = $dataEndYear - $dataStartYear;
        my $last = $t2 > $dataYearsDifference ? $dataYearsDifference : $t2;
        $time_subset_option = " -time $first $last ";

      } else {
        return 0;
      }
    } elsif ( index( $my_variable, 'weekly_cyanobacteria_' ) != -1 ) {
      my $data_start = 0;
      my $data_end   = 0;

      if ( index( $my_variable, 'meris_weekly_cyanobacteria_' ) == 0 ) {
        $data_start = 20020521;
        $data_end   = 20120401;
      } elsif ( index( $my_variable, 'sentinel_weekly_cyanobacteria_' ) == 0 ) {
        $data_start = 20170101;
        $data_end   = 20180812;

        if ( index( $my_variable, '_ca' ) != -1 ) {
          $data_end = 20180603;
        } elsif ( index( $my_variable, '_nc' ) != -1 ) {
          $data_end = 20171231;
        } elsif ( index( $my_variable, '_ny' ) != -1 ) {
          $data_end = 20180603;
        } elsif ( index( $my_variable, '_or' ) != -1 ) {
          $data_end = 20180603;
        }
      }

      my $yyyymmdd1 = emvl::get_yyyymmdd1();
      my $yyyymmdd2 = emvl::get_yyyymmdd2();
      my $outside = $yyyymmdd2 < $data_start || $yyyymmdd1 > $data_end ? 1 : 0;
      emvl::debug( "($yyyymmdd1 $yyyymmdd2) [$data_start $data_end] outside = $outside" );

      if ( $outside ) {
        return 0;
      } else {
        my $yyyymmddhh1 = emvl::get_yyyymmddhh1();
        my $yyyymmddhh2 = emvl::get_yyyymmddhh2();
        $my_variable .= "_$data_start" . "_$data_end";
        $time_subset_option = " -time $yyyymmddhh1 $yyyymmddhh2 ";
      }
    }

    my $data_file = $data_directory . '/grid_surface_' . $my_variable;

    if ( $region ne $variable ) {
      $data_file .= '_' . $region;
    }

    $data_file .= '.bin';

    if ( $format eq 'netcdf-coards' ) {
      $my_format = 'xdr';
      $my_xdrconvert = " | $xdrconvert -coards";
    } elsif ( $format eq 'netcdf-ioapi' ) {
      $my_format = 'netcdf';
    }

    if ( $aggregate_method ne '' ) {
      $aggregate_option = " -aggregate $aggregate_size $aggregate_method";
    }

    my $west_south_east_north = emvl::get_west_south_east_north();

    $command =
      "$subsetter" .
      " $data_file" .
      $time_subset_option .
      " -subset $west_south_east_north" .
      $aggregate_option .
      "$my_xdrconvert $my_compressor";

    $commands .= "$command\n";
  }

  return $result;
}



# Subset by date-time, rows of a csv file:

sub subset_csv_file {
  my ( $input_file_name, $yyyymmddhh1, $yyyymmddhh2, $filter_hru_columns,
       $apply_subset, $match_layer, $output_file_name ) = @_;
  my $result = 0;

  if ( $output_file_name =~ m#^(/[\w-]+/[\w\-/.]+)$# )
  {
    $output_file_name = $1; # Untainted to satisfy -T.
    my $extra_options = '';

    if ( $apply_subset ) {
      my $west_south_east_north = emvl::get_west_south_east_north();
      $extra_options = " -subset $west_south_east_north ";
    }

    if ( $match_layer ) {
      $extra_options .= " -layer $layer ";
    }

    emvl::debug( "subset_csv_file( $input_file_name, " .
                                   "$yyyymmddhh1, $yyyymmddhh2, " .
                                   "$filter_hru_columns, " .
                                   "$apply_subset, $match_layer, " .
                                   "$output_file_name )" );

    # Call subsetcsv C program to subset csv file (in under 1 second):

    my $filter_option = '';

    if ( $filter_hru_columns ) {
      $filter_option = '-no_hru_columns';
    }

    $command = "$subsetcsv $input_file_name $yyyymmddhh1 $yyyymmddhh2 " .
               "$filter_option $output_file_name $extra_options";

    $commands .= "$command\n";
    $result = execute_command( $command );
    emvl::debug( "subsetcsv result = $result" );
  }

  return $result;
}



# Execute command and echo its output to STDOUT.
# E.g., execute_command( '/bin/ls' );

sub execute_command {
  my $command = shift;
  my $result = 0;
  my $the_pipe = 0;

  # -T flag requires untainting $command by matching a minimal regex needed for
  # system commands used by this program.

  if ( $command =~ m#^(/[\w-]+/[\w -/.:;,^>|\[\]\$\{\}&'"<?!=]+)$# )
  {
    $command = $1; # Re-assign first match, which is enough to satisfy -T.
    emvl::debug( "$0 executing command = $command" );
    %ENV = (); # Unset all environment variables prior to popen.
    # Complicated, supposedly safer way to open a readable pipe to command:
    my $pid = open( the_pipe, "-|" );

    if ( ! defined( $pid ) ) {
      die "Couldn't open pipe to subprocess";
    } elsif ( $pid ) { # Parent process.

      while ( <the_pipe> ) {
        print;
      }

      close( the_pipe );
      $result = ! $?;
    } else { # Child process.
      exec( $command ) or die "can't exec program: $!";
    }
  } else {
    print STDERR "\n$0: command contains invalid characters.\n";
  }

  return $result;
}


