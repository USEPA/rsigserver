################################## VARIABLES #################################

# Parsed from the URL query string:

my $aggregate_size = ''; # Maximum row/column dimension of returned grid.
my $aggregate_method = ''; # mean or mode.
my $mindist  = ''; # Opt minimal distance between adjacent polygon vertices
my $huc      = ''; # Optional HUC id to subset SWMM datasets.
my $hrus     = ''; # Optional: HRUS=0 omits Ru_* and Re_* columns from SWMM csv
my $estcode  = ''; # Optional ESTCODE to subset discharge datasets.
my $comid    = ''; # Optional COMID to subset flowlines datasets.
my $layer    = ''; # Optional LAYER=Surface,Middle,Bottom to subset csv files.

# Derived from the above parsed values:

