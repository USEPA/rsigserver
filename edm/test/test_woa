#!/bin/csh -f

set FDD = /rsig/current/code/bin/Linux.x86_64/fdd

echo ; echo TEST WOA ; echo

if ( 0 ) then

sleep 2 ; echo ; echo TEST GetCapabilities ; echo
curl --silent --retry 0 'https://maple.hesc.epa.gov/rsig/rsigserver?SERVICE=wcs&VERSION=1.0.0&REQUEST=GetCapabilities' > junk ; head junk ; echo '...' ; grep -i WOA junk

sleep 2 ; echo ; echo TEST DescribeCoverage ; echo
curl --silent --retry 0 'https://maple.hesc.epa.gov/rsig/rsigserver?SERVICE=wcs&VERSION=1.0.0&REQUEST=DescribeCoverage' > junk ; head junk ; echo '...' ; grep -i WOA junk

endif



# DescribeCoverage:

sleep 2 ; echo ; echo TEST DescribeCoverage WOA.monthly_temperature ; echo
curl --silent --retry 0 'https://maple.hesc.epa.gov/rsig/rsigserver?SERVICE=wcs&VERSION=1.0.0&REQUEST=DescribeCoverage&COVERAGE=WOA.monthly_temperature' > junk ; echo $? ; cat junk



# GetMetadata:

sleep 2 ; echo ; echo TEST GetMetadata WOA.monthly_temperature ; echo
curl --silent --retry 0 'https://maple.hesc.epa.gov/rsig/rsigserver?SERVICE=wcs&VERSION=1.0.0&REQUEST=GetMetadata&COVERAGE=WOA.monthly_temperature&FORMAT=bin&TIME=2026-06-01T00:00:00Z/2026-09-30T23:59:59Z&BBOX=-85,28,-84,29,100,100' > junk ; echo $? ; cat junk

sleep 2 ; echo ; echo TEST GetMetadata WOA.monthly_temperature ; echo
curl --silent --retry 0 'https://maple.hesc.epa.gov/rsig/rsigserver?SERVICE=wcs&VERSION=1.0.0&REQUEST=GetMetadata&COVERAGE=WOA.monthly_temperature&FORMAT=original&TIME=2026-06-01T00:00:00Z/2026-09-30T23:59:59Z&BBOX=-85,28,-84,29,100,100' > junk ; echo $? ; cat junk



# Original:

sleep 2 ; echo ; echo TEST WOA.monthly_temperature original ; echo
curl --silent --retry 0 'https://maple.hesc.epa.gov/rsig/rsigserver?SERVICE=wcs&VERSION=1.0.0&REQUEST=GetCoverage&COVERAGE=WOA.monthly_temperature&FORMAT=original&TIME=2026-06-01T00:00:00Z/2026-06-30T23:59:59Z&BBOX=-85,28,-84,29,100,100' > junk ; echo $? ; tar -ztf junk



# bin:

set variables = ( \
nitrate \
oxygen_saturation \
oxygen \
phosphate \
salinity \
silicate \
temperature \
)

foreach variable ( $variables )

  sleep 2 ; echo ; echo TEST bin WOA.yearly_$variable ; echo
  curl --silent --retry 0 "https://maple.hesc.epa.gov/rsig/rsigserver?SERVICE=wcs&VERSION=1.0.0&REQUEST=GetCoverage&COVERAGE=WOA.yearly_$variable&FORMAT=bin&TIME=2026-01-01T00:00:00Z/2027-12-31T23:59:59Z&BBOX=-85,28,-84,29,100,100" > junk ; echo $? ; head -9 junk ; tail +10 junk | $FDD conv=real4-ascii conv=swab4

  sleep 2 ; echo ; echo TEST bin WOA.monthly_$variable ; echo
  curl --silent --retry 0 "https://maple.hesc.epa.gov/rsig/rsigserver?SERVICE=wcs&VERSION=1.0.0&REQUEST=GetCoverage&COVERAGE=WOA.monthly_$variable&FORMAT=bin&TIME=2026-06-01T00:00:00Z/2027-07-31T23:59:59Z&BBOX=-85,28,-84,29,100,100" > junk ; echo $? ; head -21 junk ; tail +22 junk | $FDD conv=real4-ascii conv=swab4

end


/bin/rm -f junk
echo ; echo DONE WOA ; echo
