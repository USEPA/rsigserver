#!/bin/sh

clear

IFLAGS=''
LFLAGS=''

if [ -e /usr/include/tirpc ]
then
  IFLAGS='-I/usr/include/tirpc'
  LFLAGS='-ltirpc'
fi

echo
echo "Compiling Utilities..."
cd Utilities
gcc -m64 -Wall -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -DNDEBUG -DNO_ASSERTIONS -DSERIAL_REGRID -O -I. $IFLAGS -c Utilities.c BasicNumerics.c DateTime.c Failure.c Memory.c Stream.c Projector.c Lambert.c Stereographic.c Mercator.c VoidList.c Grid.c elevation.c RegridQuadrilaterals.c
ls -l *.o
cd ..

echo
echo "Compiling GASPSubset..."
gcc -m64 -Wall -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -DNDEBUG -DNO_ASSERTIONS -O -I./Utilities -I. $IFLAGS -o GASPSubset GASPSubset.c -L. Utilities/*.o $LFLAGS -lz -lm -lc
strip GASPSubset
ls -l GASPSubset
file  GASPSubset
ldd   GASPSubset

echo
echo "Compiling GASPSubset13..."
gcc -m64 -Wall -DGASP_13 -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -DNDEBUG -DNO_ASSERTIONS -O -I./Utilities -I. $IFLAGS -o GASPSubset13 GASPSubset.c -L. Utilities/*.o $LFLAGS -lz -lm -lc
strip GASPSubset13
ls -l GASPSubset13
file  GASPSubset13
ldd   GASPSubset13

echo
echo "Compiling GASPSubset13new..."
gcc -m64 -Wall -DGASP_13NEW -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -DNDEBUG -DNO_ASSERTIONS -O -I./Utilities -I. $IFLAGS -o GASPSubset13new GASPSubset.c -L. Utilities/*.o $LFLAGS -lz -lm -lc
strip GASPSubset13new
ls -l GASPSubset13new
file  GASPSubset13new
ldd   GASPSubset13new

echo
echo "Compiling GASPSubset15..."
gcc -m64 -Wall -DGASP_15 -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -DNDEBUG -DNO_ASSERTIONS -O -I./Utilities -I. $IFLAGS -o GASPSubset15 GASPSubset.c -L. Utilities/*.o $LFLAGS -lz -lm -lc
strip GASPSubset15
ls -l GASPSubset15
file  GASPSubset15
ldd   GASPSubset15


ls -Fsalt | head
echo Done

