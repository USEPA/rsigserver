################################## VARIABLES #################################

# Parsed from the URL query string:

my $corners = ''; # 1 = compute corners otherwise don't (default).
my $aggregate = ''; # 'none', (default) or 'daily'.

################################## ROUTINES ##################################


main();


sub main {
  my $result = 0;

  # Before calling emvl::parse_url(), specify various options so the default
  # functions work:

  emvl::set_source( $data_product );
  emvl::set_coverage_metadata( \@coverage_metadata );
  emvl::set_metadata_begin_date( $begin_date );
  emvl::set_metadata_end_date( $end_date );
  emvl::set_metadata_west_bound( $west_bound );
  emvl::set_metadata_east_bound( $east_bound );
  emvl::set_metadata_south_bound( $south_bound );
  emvl::set_metadata_north_bound( $north_bound );
  emvl::append_parser( 'corners', \&parse_corners_option );
  emvl::append_parser( 'aggregate', \&parse_aggregate_option );

  if ( ! emvl::parse_url() ) {
    print "Content-type: text/plain; charset=iso-8859-1\n\n"; # For webserver
  } else {
    my $request = emvl::get_request();
    my $format = emvl::get_format();

    if ( $request eq 'getcapabilities' ) {
      print "Content-type: text/xml; charset=iso-8859-1\n\n"; # For webserver
      emvl::print_capabilities();
      $result = 1;
    } elsif ( $request eq 'describecoverage' ) {
      print "Content-type: text/xml; charset=iso-8859-1\n\n"; # For webserver
      emvl::print_coverage_description();
      $result = 1;
    } elsif ( $request eq 'getcoverage' ) {
      my $header = emvl::get_content_type_header(); # Based on parsed FORMAT.
      print "$header\n\n";
      my $command = construct_command();

      if ( $command ne '' ) {
        $result = execute_command( $command );

        if ( ! emvl::get_debugging() ) {
          unlink( $temp_file_name );
          execute_command( "/bin/rm -f $temp_file_name" ); # Why unlink fails?
        }
      }
    } elsif ( $request eq 'getmetadata' ) {
      print "Content-type: text/plain; charset=iso-8859-1\n\n"; # For webserver
      my $command = construct_command();

      if ( $command ne '' ) {
        my $i = index( $command, '>' );
        my $list_files_command = substr( $command, 0, $i );
        print $metadata_content;

        if ( $format eq 'original' ) {
          print $metadata_content_original;
          $result = execute_command( $list_files_command );
          print "\n";
        } else {
          print $metadata_content_processed;
          $result = execute_command( $list_files_command );
          print "\n$command\n\n";
        }

        if ( ! emvl::get_debugging() ) {
          unlink( $temp_file_name );
          execute_command( "/bin/rm -f $temp_file_name" ); # Why unlink fails?
        }
      }
    }
  }

  $result = 1 - $result; # UNIX: zero is success, non-zero is failure.
  emvl::debug( "exit result = $result" );

  # Must return some bytes to avoid 30 second timeout delay when unsuccessful:

  if ( $result != 0 ) {
    print STDOUT "\nFAILED\n";
  }

  exit $result;
}



# Parse corners option:

sub parse_corners_option {
  my $value = shift;
  my $result = 0;

  if ( $corners ne '' ) {
    print STDERR "\nRedundant CORNERS option: '$value'\n";
  } else {
    my $is_valid = $value eq '0' || $value eq '1';

    if ( ! $is_valid ) {
      print STDERR "\nInvalid CORNERS option: '$value'\n";
    } else {
      $corners = $value;
      $result = 1;
    }
  }

  return $result;
}



# Parse aggregate option:

sub parse_aggregate_option {
  my $value = shift;
  my $result = 0;

  if ( $aggregate ne '' ) {
    print STDERR "\nRedundant AGGREGATE option: '$value'\n";
  } else {
    my $is_valid = $value eq 'none' || $value eq 'daily';

    if ( ! $is_valid ) {
      print STDERR "\nInvalid AGGREGATE option: '$value'\n";
    } else {
      $aggregate = $value;
      $result = 1;
    }
  }

  return $result;
}



# Construct subsetter command.

sub construct_command {
  my $command = '';
  my $format = emvl::get_format();
  my $coverage = emvl::get_coverage();
  my @parts = split( /\./, $coverage );
  my $instrument = $parts[ 0 ];
  my $variable   = $parts[ 1 ];
  my $yyyymmddhh1 = emvl::get_yyyymmddhh1();
  my $hours = emvl::get_hours();
  my $list_command =
    "$lister $instrument $variable $yyyymmddhh1 $hours > $temp_file_name";

  if ( $format eq 'original' ) {
    $command = "$list_command ; $cat $temp_file_name | $xargs $tar";
  } else {
    my $my_xdrconvert = '';
    my $regrid = emvl::get_regrid();

    if ( $regrid ne '' || $format ne 'xdr' ) {
      my $regrid_args = emvl::xdrconvert_regrid_args( 0 );
      my $xdrconvert_format = emvl::xdrconvert_format();
      $my_xdrconvert = " | $xdrconvert $regrid_args -$xdrconvert_format";
    }

    my $run_parallel_option =
      $run_parallel_tasks > 1 ? "$run_parallel $run_parallel_tasks" : '';
    my $coverage_index = emvl::get_coverage_index();
    my $units = $coverage_metadata[ $coverage_index ]->{ units };
    my $corners_option = $corners eq '1' ? '-corners' : '';
    my $daily_option = $aggregate eq 'daily' ? '-daily' : '';
    my $west_south_east_north = emvl::get_west_south_east_north();
    my $my_compressor = emvl::get_compress() ? " | $compressor" : '';

    $command =
      "$list_command ; $run_parallel_option $subsetter " .
      " -files $temp_file_name " .
      " -desc $desc " .
      " -units $units " .
      " -timestamp $yyyymmddhh1 -hours $hours " .
      " $daily_option " .
      " -domain $west_south_east_north " .
      " $corners_option ".
      " $my_xdrconvert $my_compressor";
  }

  return $command;
}



# Execute command and echo its output to STDOUT.
# E.g., execute_command( '/bin/ls' );

sub execute_command {
  my $command = shift;
  my $result = 0;
  my $the_pipe = 0;

  # -T flag requires untainting $command by matching a minimal regex needed for
  # system commands used by this program.

  if ( $command =~ m#^(/[\w-]+/[\w -/.;:,>'@|]+)$# )
  {
    $command = $1; # Re-assign first match, which is enough to satisfy -T.
    emvl::debug( "$0 executing command = $command" );
    %ENV = (); # Unset all environment variables prior to popen.
    # Complicated, supposedly safer way to open a readable pipe to command:
    my $pid = open( the_pipe, "-|" );

    if ( ! defined( $pid ) ) {
      die "Couldn't open pipe to subprocess";
    } elsif ( $pid ) { # Parent process.

      while ( <the_pipe> ) {
        print;
      }

      close( the_pipe );
      $result = ! $?;
    } else { # Child process.
      exec( $command ) or die "can't exec program: $!";
    }
  } else {
    print STDERR "\n$0: command contains invalid characters.\n";
  }

  return $result;
}


