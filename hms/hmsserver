#!/usr/bin/perl -wT

##############################################################################
# PURPOSE: hmsserver - Serve NOAA HMS (Hazard Mapping System) data,
#          subsetted by date/time range,
#          variable, and longitude-latitude box, in ASCII, XDR, formats for
#          use by other programs.
#
# NOTES:   Server is WCS-compliant:
#          https://www.opengeospatial.org/standards/wcs
#          https://datafed.net/xs/OpenGIS/wcs/1.0.0/
#          and modeled after a similar webserver application:
#          https://webapps.datafed.net/ogc_EPA.wsfl
#
#          Launches the C programs SiteSubset or ShapeSubset which streams
#          data on STDOUT.
#
#          Example usage:
#
#          curl -k --retry 0 \
#          'https://ofmpub.epa.gov/rsig/hmsserver?\
#          SERVICE=wcs&\
#          VERSION=1.0.0&\
#          REQUEST=GetCoverage&\
#          COVERAGE=fire_ecosys&\
#          TIME=2016-10-17T00:00:00Z/2016-10-17T23:59:59Z&\
#          BBOX=-125,25,-85,55,0,0&\
#          FORMAT=ascii'
#
# HISTORY: 2016-10-18 plessel.todd@epa.gov 1-919-541-5500
# STATUS:  unreviewed tested
##############################################################################

use strict;
#BEGIN { push @INC, '/Users/plessel/projects/rsig/code/perl'; }
BEGIN { push @INC, '/data/Apache/cgi-bin'; }
use emvl; # Local OGC-WCS query string parsing and printing utility functions.
pop @INC;

package main;
$| = 1; # Turn off output buffering so messages appear in correct order.
alarm( 3600 ); # Kill process after 1 hour. Legitimate usage could be an hour!
# Restrict PATH and ENV. (But before popen, ENV is cleared!)
delete @ENV{ 'PATH', 'IFS', 'CDPATH', 'ENV', 'BASH_ENV' };

############################## TUNABLE CONSTANTS #############################

emvl::set_debugging( 0 ); # 1 = print debug messages to STDERR logs/error_log

my @pathed_program_parts = split( /\//, $0 );
my $program_name = $pathed_program_parts[ @pathed_program_parts - 1 ];

my $product = 'HMS';
my $desc = "https://www.ospo.noaa.gov/Products/land/hms.html,$program_name";
my $data_directory = "/data/$product/data"; # Contains input data files.
my $temp_directory = '/data/tmp'; # To write transient files.
my $temp_subdir_name    = "$temp_directory/temp_$product" . "_$$";
my $temp_txt_file_name  = "$temp_directory/temp_$product" . "_txt.$$";
my $temp_out_file_name  = "$temp_directory/temp_$product" . "_out.$$";
my $temp_sort_file_name = "$temp_directory/temp_$product" . "_sort.$$";
my $bindir      = '/rsig/current/code/bin/Linux.x86_64';
my $fdd         = "$bindir/fdd";
my $subsetter   = "$bindir/ShapeSubset";
my $xdrconvert  = "$bindir/XDRConvert";
my $printf      = '/usr/bin/printf';
my $cat         = '/bin/cat';
my $cut         = '/bin/cut';
my $sort        = '/bin/sort';
my $compressor  = "/usr/bin/gzip -c -1";
my $zip         = "/bin/zip -q";
my $tar         = '/usr/bin/tar -zcO';
my $rm          = '/bin/rm -rf';
my $geojson_converter = "/bin/ogr2ogr -f GeoJSON";

# Output messages when REQUEST=GetMetadata.
# Print this message first:

my $metadata_content = '
NOAA HMS satellite derived fire data accessed using RSIG.
HMS: https://www.ospo.noaa.gov/Products/land/hms.html
RSIG: https://www.epa.gov/rsig
';

# If FORMAT=original then print this message second:

my $metadata_content_original = '
The list of original data files are shown below.

';

# Else FORMAT!=original then print this message second:

my $metadata_content_processed = '
Data processing was done using the RSIG programs hmsserver, ShapeSubset and
XDRConvert.
ShapeSubset and hmsserver are used to subset (by variable, lon-lat box and
time range) and reorganize/reformat and filter the data.
XDRConvert is optionally used to regrid, aggregate and reformat the data
to other file formats.
The list of original data files and the RSIG command used to process them
are shown below.

';

# All data variables are available within this date range and bounds:

my $begin_date = '2016-10-12';
my $end_date   = '';
my $west_bound = -180;
my $east_bound = 180;
my $south_bound = -90;
my $north_bound = 90;

my @coverage_metadata  = (
  {
    name => 'fire_ecosys',
    units => '-',
    description =>
    'NOAA Hazard Mapping System ecological system classification code [1, 100].'
  },
  {
    name => 'fire_power',
    units => 'MW',
    description => 'NOAA Hazard Mapping System fire power in Megawatts.'
  },
  {
    name => 'smoke',
    units => 'ug/m3',
    description =>
      'NOAA Hazard Mapping System smoke plume area with density in ug/m3.'
  }
);


################################## VARIABLES #################################

my $data_files = ''; # List of pathed names of data files to read.
my $units = '';
my $subset_points = 0;

################################## ROUTINES ##################################


main();


sub main {
  my $result = 0;

  # Before calling emvl::parse_url(), specify various options so the default
  # functions work:

  emvl::set_source( $product );
  emvl::set_coverage_metadata( \@coverage_metadata );
  emvl::set_metadata_begin_date( $begin_date );
  emvl::set_metadata_end_date( $end_date );
  emvl::set_metadata_west_bound( $west_bound );
  emvl::set_metadata_east_bound( $east_bound );
  emvl::set_metadata_south_bound( $south_bound );
  emvl::set_metadata_north_bound( $north_bound );
  emvl::append_content_type( 'shapefile', 'application/zip' );
  emvl::append_content_type( 'geojson', 'application/geo_json' );

  if ( ! emvl::parse_url() ) {
    print "Content-type: text/plain; charset=iso-8859-1\n\n"; # For webserver
  } else {
    my $coverage_index = emvl::get_coverage_index();
    $units = $coverage_metadata[ $coverage_index ]->{ units };
    my $request = emvl::get_request();
    my $format = emvl::get_format();

    if ( $request eq 'getcapabilities' ) {
      print "Content-type: text/xml; charset=iso-8859-1\n\n"; # For webserver
      emvl::print_capabilities();
      $result = 1;
    } elsif ( $request eq 'describecoverage' ) {
      print "Content-type: text/xml; charset=iso-8859-1\n\n"; # For webserver
      emvl::print_coverage_description();
      $result = 1;
    } elsif ( $request eq 'getcoverage' ) {
      my $header = emvl::get_content_type_header(); # Based on parsed FORMAT.
      print "$header\n\n";
      compute_data_files();

      if ( $data_files ne '' ) {

        if ( $format eq 'original' ) {
          $result = execute_command( "$tar $data_files" );
        } else {
          my $coverage = emvl::get_coverage();

          if ( $coverage ne 'smoke' ) {
            $result = process_data_files(); # Read $data_files. Write txt file.
          } else {
            $result = 1;
          }

          if ( $result ) {
            $result = stream_temp_file(); # Write and stream temp out file.
          }

          if ( ! emvl::get_debugging() ) {
            unlink( $temp_txt_file_name );
            unlink( $temp_out_file_name );
            unlink( $temp_sort_file_name );
            rmdir $temp_subdir_name;
            execute_command( "$rm $temp_txt_file_name $temp_out_file_name $temp_sort_file_name $temp_subdir_name" );
          }
        }
      }
    } elsif ( $request eq 'getmetadata' ) {
      print "Content-type: text/plain; charset=iso-8859-1\n\n"; # For webserver
      compute_data_files();

      if ( $data_files ne '' ) {
        print $metadata_content;

        if ( $format eq 'original' ) {
          print $metadata_content_original;
          $data_files =~ tr/ /\n/;
          print "$data_files\n";
        } else {
          print $metadata_content_processed;
          $data_files =~ tr/ /\n/;
          print "$data_files\n";
        }

        $result = 1;
      }
    }
  }

  $result = 1 - $result; # UNIX: zero is success, non-zero is failure.
  emvl::debug( "exit result = $result" );

  # Must return some bytes to avoid 30 second timeout delay when unsuccessful:

  if ( $result != 0 ) {
    print STDOUT "\nFAILED\n";
  }

  exit $result;
}



# Compute list of input data files.
# inputs:  $yyyymmddhhmmss1 = '20110701000000'
#          $yyyymmddhhmmss2 = '20110702235959'
# outputs: $data_files

sub compute_data_files {
  my $format = emvl::get_format();
  my $coverage = emvl::get_coverage();
  my $prefix = ( $coverage eq 'smoke' ? 'hms_smoke' : 'hms_fire' );
  my $suffix = ( $coverage eq 'smoke' ? 'dbf' : 'txt' );
  my $yyyymmdd2 = emvl::get_yyyymmdd2();
  my $yyyymmdd  = emvl::decrement_date( emvl::get_yyyymmdd1() );

  while ( $yyyymmdd <= $yyyymmdd2 ) {
    my $yyyy = int( $yyyymmdd / 10000 );
    my $path = "$data_directory/$yyyy/$prefix$yyyymmdd";
    my $input_file = "$path.$suffix";

    if ( -f $input_file ) {
      $data_files .= "$input_file ";

      if ( $coverage eq 'smoke' && $format eq 'original') {
        $data_files .= "$path.shx ";
        $data_files .= "$path.shp ";
      }
    }

    $yyyymmdd = emvl::increment_date( $yyyymmdd );
  }
}



# Process list of input data files.
# inputs:  $data_files
# returns: 1 if some data was in subset.

sub process_data_files {
  my $result = 0;
  my $format = emvl::get_format();
  my $regrid = emvl::get_regrid();
  my $output_ascii = ( $format eq 'ascii' && $regrid eq '' ) ? 1 : 0;

  if ( open my $temp_txt_file, '>', "$temp_txt_file_name" ) {
    my @input_file_names = split( / /, $data_files );

    foreach my $input_file_name ( @input_file_names ) {

      if ( open my $input_file, '<', $input_file_name ) {
        emvl::debug( "reading data file $input_file_name" );
        my @data_lines = <$input_file>;
        close $input_file;
        my $ok = process_data( $temp_txt_file, $output_ascii, \@data_lines );

        if ( $ok ) {
          $result = 1;
        }
      }
    }

    close ( $temp_txt_file );
  }

  return $result;
}



# Process data file lines.
# inputs:  $data_lines (csv content of an input data file)
#          $yyyymmddhhmmss1 = '20110701000000'
#          $yyyymmddhhmmss2 = '20110702235959'
#          $bbox = -130,29,-65,55
#          $coverage = fire_ecosys or fire_power
# outputs: Writes XDR-format subset data arrays to
#          $temp_timestamp_file, $temp_longitude_file, $temp_latitude_file,
#          $temp_data_file.
# returns: number of data lines in subset.
# note: The input text files are formatted like one of the following two forms
#       and are not sorted by date-time:
# maple> head /data/HMS/data/2016/hms_fire20161012.txt
#     Lon,     Lat, YearDay,    Time,       Satellite, Method of Detect, Ecosys
# -71.157,  43.816, 2016286,    1846,   AVHRR NOAA-19,           FIMMA,  25
# -71.169,  43.820, 2016286,    1846,   AVHRR NOAA-19,           FIMMA,  25
# -76.823,  35.873, 2016286,    1607,     MODIS TERRA,        ANALYSIS,  26
# ...
# maple> head /data/HMS/h data/2018/hms_fire20180724.txt
#     Lon,     Lat, YearDay, Time,       Satellite, Method of Detect, Ecosys, Fire RadPower
# -88.853,  52.820, 2018205, 0828,       SUOMI NPP,            VIIRS,     21,        20.412
# -88.843,  18.182, 2018205, 0650,       SUOMI NPP,         ANALYSIS,     33,      -999.000
# ...

sub process_data {
  my ( $temp_txt_file, $output_ascii, $data_lines ) = @_;
  my $count = @$data_lines;
  my $value_format = ( $units eq '-' ) ? "%g" : "%10.4f";
  my $coverage = emvl::get_coverage();
  my $west = emvl::get_west();
  my $east = emvl::get_east();
  my $south = emvl::get_south();
  my $north = emvl::get_north();
  my $yyyymmddhhmmss1 = emvl::get_yyyymmddhhmmss1();
  my $yyyymmddhhmmss2 = emvl::get_yyyymmddhhmmss2();
  emvl::debug( "data file lines = $count" );

  for ( my $i = 1; $i < $count; ++$i ) {
    my @line = split( /,/, $data_lines->[ $i ] );
    my $columns = @line;

    if ( $columns == 8 || ( $columns == 7 && $coverage eq 'fire_ecosys' ) ) {
      my $longitude = $line[ 0 ];
      my $latitude  = $line[ 1 ];
      my $yyyyddd   = $line[ 2 ];
      my $hhmm      = $line[ 3 ];
      my $value     = -9999.0;

      if ( $columns == 8 && $coverage eq 'fire_ecosys' ) {
        $value = $line[ $columns - 2 ];
      } else {
        $value = $line[ $columns - 1 ];
      }

      if ( $value >= 0.0 &&
           emvl::in_range( $longitude, $west, $east ) &&
           emvl::in_range( $latitude,  $south, $north ) ) {
        my $yyyymmdd = emvl::convert_yyyyddd( $yyyyddd );
        my $hh = int( $hhmm / 100 );
        my $mm = int( $hhmm % 100 );
        my $ss = 0;
        my $yyyymmddhhmmss =
          sprintf( "%d%02d%02d%02d", $yyyymmdd, $hh, $mm, $ss );

        if ( emvl::in_range( $yyyymmddhhmmss, $yyyymmddhhmmss1, $yyyymmddhhmmss2 ) ) {

          if ( $output_ascii ) {
            my $yyyy = int( $yyyymmdd / 10000 );
            my $mo   = int( $yyyymmdd / 100 % 100 );
            my $dd   = int( $yyyymmdd % 100 );
            printf $temp_txt_file
              "%4d-%02d-%02dT%02d:%02d:%02d-0000\t%10.5f\t%10.5f\t$value_format\n",
              $yyyy, $mo, $dd, $hh, $mm, $ss, $longitude, $latitude, $value;
          } else {
            printf $temp_txt_file "%s\t%10.5f\t%10.5f\t$value_format\n",
              $yyyymmddhhmmss, $longitude, $latitude, $value;
          }

          ++$subset_points;
        }
      }
    }
  }

  my $result = $subset_points > 0;
  return $result;
}



# Output XDR header and stream temp files in binary XDR format or shp format.

sub stream_temp_file {
  my $result = 0;
  my $format = emvl::get_format();
  my $regrid = emvl::get_regrid();
  my $my_compressor = emvl::get_compress() ? " | $compressor" : '';
  my $output_ascii = ( $format eq 'ascii' && $regrid eq '' ) ? 1 : 0;
  my $my_xdrconvert = '';

  # Determine if XDRConvert must be used for reformatting and/or regridding:

  if ( $regrid ne '' ||
       $format eq 'netcdf-coards' || $format eq 'netcdf-ioapi' ) {
    my $xdrconvert_format = emvl::xdrconvert_format();
    my $regrid_args = emvl::xdrconvert_regrid_args( 0 );
    $my_xdrconvert = " | $xdrconvert $regrid_args -$xdrconvert_format";
  }

  my $coverage = emvl::get_coverage();

  if ( $coverage eq 'smoke' ) { # Polygon data.

    if ( $format eq 'xdr' || $format eq 'shapefile' || $format eq 'geojson' ) {

      if ( open my $temp_out_file, '>', "$temp_out_file_name" ) {

        if ( $format eq 'xdr' ) {
          my $time = emvl::get_time();
          my $timestamps = $time;
          $timestamps =~ tr/\// /;
          $timestamps =~ tr/t/T/;
          $timestamps =~ s/z/-0000/g;
          printf $temp_out_file
            "Polygon 1.0\n" .
            "%s\n" .
            "%s\n" .
            "# Variable names:\n" .
            "$coverage\n" .
            "# Variable units:\n" .
            "$units\n" .
            "# name shxdatabytes shpdatabytes dbfdatabytes and\n" .
            "# shxfiledata shpfiledata dbffiledata:\n",
            $desc, $timestamps;
        }

        close( $temp_out_file );
        my $yyyymmdd1 = emvl::get_yyyymmdd1();
        my $yyyymmdd2 = emvl::get_yyyymmdd2();
        mkdir $temp_subdir_name, 0775; # This will be used by subsetter.
        my $pre = "$cat $temp_out_file_name $my_compressor ; ";
        my $post = $my_compressor;

        if ( $format eq 'shapefile' ) {
          $pre = '';
          $post =
            ' -no_stream ; ' .
            " cd $temp_subdir_name ; " .
            " $zip hms_smoke.zip hms_smoke.dbf hms_smoke.shx hms_smoke.shp ; " .
            " $cat hms_smoke.zip ";
        } elsif ( $format eq 'geojson' ) {
          $pre = '';
          $post =
            ' -no_stream ; ' .
            " cd $temp_subdir_name ; " .
            " $geojson_converter hms_smoke.geojson hms_smoke.shp ; " .
            " $cat hms_smoke.geojson $my_compressor";
        }

        my $west_south_east_north = emvl::get_west_south_east_north();
        my $command =
          $pre .
          $subsetter .
          " -input $data_files " .
          " -subset $west_south_east_north " .
          " -time $yyyymmdd1 $yyyymmdd2 " .
          " -output $temp_subdir_name/hms_smoke " .
          $post;
          $result = execute_command( $command );
      }
    }
  } else {  # Point data:

    if ( $format eq 'xdr' || $format eq 'ascii' ||
         $format eq 'netcdf-coards' || $format eq 'netcdf-ioapi' ) {

      if ( open my $temp_out_file, '>', "$temp_out_file_name" ) {

        if ( $output_ascii ) {
          printf $temp_out_file
            "Timestamp(UTC)\tLONGITUDE(deg)\tLATITUDE(deg)\t$coverage($units)\n";
          my $command = "$sort $temp_txt_file_name >> $temp_out_file_name";
          $result = execute_command( $command );
          close( $temp_out_file );

          if ( $result ) {
            $command = "$cat $temp_out_file_name$my_compressor";
            $result = execute_command( $command );
          }
        } else { # Output XDR with possible conversion to specified FORMAT.
          my $time = emvl::get_time();
          my $timestamps = $time;
          $timestamps =~ tr/\// /;
          $timestamps =~ tr/t/T/;
          $timestamps =~ s/z/-0000/g;
          printf $temp_out_file
            "Point 1.0\n" .
            "%s\n" .
            "%s\n" .
            "# Dimensions: variables points:\n" .
            "4 %d\n" .
            "# Variable names:\n" .
            "Timestamp Longitude Latitude $coverage\n" .
            "# Variable units:\n" .
            "yyyymmddhhmmss deg deg $units\n" .
            "# IEEE-754 64-bit reals data[variables][points]:\n",
            $desc, $timestamps, $subset_points;
          close( $temp_out_file );

          # Use fdd to convert text temp file values to XDR binary format:

          my $command =
            "$sort $temp_txt_file_name > $temp_sort_file_name ; " .
            "$cut -f 1 $temp_sort_file_name" .
            " | $fdd conv=ascii-real8 conv=swab8 >> $temp_out_file_name ; " .
            "$cut -f 2 $temp_sort_file_name" .
            " | $fdd conv=ascii-real8 conv=swab8 >> $temp_out_file_name ; " .
            "$cut -f 3 $temp_sort_file_name" .
            " | $fdd conv=ascii-real8 conv=swab8 >> $temp_out_file_name ; " .
            "$cut -f 4 $temp_sort_file_name" .
            " | $fdd conv=ascii-real8 conv=swab8 >> $temp_out_file_name";
          $result = execute_command( $command );

          # Stream temp out file (maybe piped through XDRConvert, gzip) to stdout:

          if ( $result ) {
            $command =
              "$cat $temp_out_file_name" .
              "$my_xdrconvert$my_compressor";
            $result = execute_command( $command );
          }
        }
      }
    }
  }

  return $result;
}



# Execute command and echo its output to STDOUT.
# E.g., execute_command( '/bin/ls' );

sub execute_command {
  my $command = shift;
  my $result = 0;
  my $the_pipe = 0;

  # -T flag requires untainting $command by matching a minimal regex needed for
  # system commands used by this program.

  if ( $command =~ m#^(/[\w-]+/[\w -/=>;\\".|]+)$# )
  {
    $command = $1; # Re-assign first match, which is enough to satisfy -T.
    emvl::debug( "$0 executing command = $command" );
    %ENV = (); # Unset all environment variables prior to popen.
    # Complicated, supposedly safer way to open a readable pipe to command:
    my $pid = open( the_pipe, "-|" );

    if ( ! defined( $pid ) ) {
      die "Couldn't open pipe to subprocess";
    } elsif ( $pid ) { # Parent process.

      while ( <the_pipe> ) {
        print;
      }

      close( the_pipe );
      $result = ! $?;
    } else { # Child process.
      exec( $command ) or die "can't exec program: $!";
    }
  } else {
    print STDERR "\n$0: command contains invalid characters.\n";
  }

  return $result;
}


