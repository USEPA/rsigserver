my $cmaq   = ''; # CMAQ=0 for Grid XDR format, 1 = SUBSET CMAQ format.
my $stride = ''; # Stride on row/column index. 1, 2, 10.

################################## ROUTINES ##################################


main();


sub main {
  my $result = 0;

  # Before calling emvl::parse_url(), specify various options so the default
  # functions work:

  emvl::set_source( $data_source );
  emvl::set_coverage_metadata( \@coverage_metadata );
  emvl::append_parser( 'cmaq', \&parse_cmaq_option );
  emvl::append_parser( 'stride', \&parse_stride_option );

  if ( ! emvl::parse_url() ) {
    print "Content-type: text/plain; charset=iso-8859-1\n\n"; # For webserver
  } else {
    my $request = emvl::get_request();
    my $format = emvl::get_format();

    if ( $request eq 'getcapabilities' ) {
      print "Content-type: text/xml; charset=iso-8859-1\n\n"; # For webserver
      emvl::print_capabilities();
      $result = 1;
    } elsif ( $request eq 'describecoverage' ) {
      print "Content-type: text/xml; charset=iso-8859-1\n\n"; # For webserver
      emvl::print_coverage_description();
      $result = 1;
    } elsif ( $request eq 'getcoverage' ) {
      my $header = emvl::get_content_type_header(); # Based on parsed FORMAT.
      print "$header\n\n";
      my $hours = emvl::get_hours();
      my $processes =
        $hours < $maximum_parallel_retrievals ? $hours
        : $maximum_parallel_retrievals;

      $result = retrieve_data( $processes );

      if ( $result ) {
        my $command = construct_subsetter_command();
        $result = execute_command( $command );
      }

      if ( ! emvl::get_debugging() ) {
        execute_command( "$rm $temp_directory" );
      }
    } elsif ( $request eq 'getmetadata' ) {
      print "Content-type: text/plain; charset=iso-8859-1\n\n"; # For webserver
      print $coverage_metadata_content;

      if ( $format eq 'original' ) {
        print $coverage_metadata_content_original;
        $result = retrieve_data( 0 );
        print "\n";
      } else {
        print $coverage_metadata_content_processed;
        $result = retrieve_data( 0 );
        my $command = construct_subsetter_command();
        print "\n$command\n\n";
      }
    }

    if ( ! emvl::get_debugging() ) {
      execute_command( "$rm $temp_directory" );
    }
  }

  $result = 1 - $result; # UNIX: zero is success, non-zero is failure.
  emvl::debug( "exit result = $result" );

  # Must return some bytes to avoid 30 second timeout delay when unsuccessful:

  if ( $result != 0 ) {
    print STDOUT "\nFAILED\n";
  }

  exit $result;
}



# Parse cmaq option.

sub parse_cmaq_option {
  my $value = shift;
  my $result = 0;

  if ( $cmaq ne '' ) {
    print STDERR "\nRedundant CMAQ option\n";
  } else {
    $cmaq = $value;
    my $is_valid = $cmaq == 0 || $cmaq == 1;

    if ( ! $is_valid ) {
      print STDERR "\nInvalid CMAQ option (requires 0 or 1)\n";
    } else {
      $result = 1;
    }
  }

  return $result;
}



# Parse stride option.

sub parse_stride_option {
  my $value = shift;
  my $result = 0;

  if ( $stride ne '' ) {
    print STDERR "\nRedundant STRIDE option\n";
  } else {
    my $ivalue = int( $value );
    $stride = $value;

    if ( $stride > 0 && $stride == $ivalue ) {
      $result = 1;
    } else {
      print STDERR "\nInvalid STRIDE option (requires integer greater than 0)\n";
    }
  }

  return $result;
}



# Retrieve data files from the external web service to $temp_directory.
# If processes is 0 just print command to retrieve data.
# If processes is 1 retrieve each subset data file sequentially.
# If processes is > 1 create and execute a csh program to retrieve each subset
# data file concurrently.

sub retrieve_data {
  my $processes = shift;
  my $p = 0;
  my $result = 1;
  my $hours = emvl::get_hours();
  my $file_list_file = undef;
  my $downloader_file = undef;

  mkdir $temp_directory, 0775;
  open $file_list_file, '>', $temp_file_list or die "Can't create file $!";

  emvl::debug( "retrieve_data() processes = $processes, hours = $hours\n" );

  my $yyyymmddhh = emvl::get_yyyymmddhh1();

  if ( $processes > 1 ) {

    # Create $temp_downloader program to retrieve idx files concurrently
    # then execute the program:

    open $downloader_file, '>', $temp_downloader or die "Can't create file $!";
    print $downloader_file "#!/bin/sh\n";

    for ( my $h = 0; $h < $hours && $result == 1; ++$h ) {
      my $yyyymmdd = int( $yyyymmddhh / 100 );
      my $hh = substr( $yyyymmddhh, 8, 2 );
      my $url = $external_url;
      $url =~ s/YYYYMMDD/$yyyymmdd/g;
      $url =~ s/HH/$hh/g;

      # Retrieve idx file:

      my $url_idx = $url . '.idx';
      my $last_slash = rindex( $url_idx, '/' );
      my $file = substr( $url_idx, $last_slash + 1 );
      my $idx_file_name = "$temp_directory/$yyyymmdd" . "_$file";
      my $command = "$curl '$url_idx' > $idx_file_name";

      emvl::debug("( $command & )\n");
      print $downloader_file "$command &\n";

      ++$p;

      if ( $p == $processes ) {
        emvl::debug( "wait\n" );
        print $downloader_file "wait\n";
        $p = 0;
      }

      $yyyymmddhh = emvl::increment_hour( $yyyymmddhh );
    }

    if ( $p != 0 ) {
      print $downloader_file "wait\n";
    }

    close $downloader_file;
    $downloader_file = undef;
    chmod 0755, $temp_downloader;
    $result = execute_command( "$temp_downloader 2>&1 /dev/null" );
    unlink( $temp_downloader );

    # Recreate $temp_downloader program to retrieve data files concurrently:

    if ( $result ) {
      open $downloader_file, '>', $temp_downloader or die "Can't create file $!";
      print $downloader_file "#!/bin/sh\n";
    }
  }

  $yyyymmddhh = emvl::get_yyyymmddhh1();

  emvl::debug( "result = $result, $yyyymmddhh" );
  my $coverage_index = emvl::get_coverage_index();
  my $tag        = $coverage_metadata[ $coverage_index ]->{ tag };
  my $components = $coverage_metadata[ $coverage_index ]->{ components };

  for ( my $h = 0; $h < $hours && $result == 1; ++$h ) {
    my $yyyymmdd = int( $yyyymmddhh / 100 );
    my $hh = substr( $yyyymmddhh, 8, 2 );
    my $url = $external_url;
    $url =~ s/YYYYMMDD/$yyyymmdd/g;
    $url =~ s/HH/$hh/g;

    # Retrieve idx file:

    my $url_idx = $url . '.idx';
    my $last_slash = rindex( $url_idx, '/' );
    my $file = substr( $url_idx, $last_slash + 1 );
    my $idx_file_name = "$temp_directory/$yyyymmdd" . "_$file";
    my $command = "$curl '$url_idx' > $idx_file_name";

    emvl::debug( "  idx_file_name = $idx_file_name" );

    if ( $processes <= 1 ) {
      $result = execute_command( $command );
      emvl::debug( "    result = $result" );
    }

    emvl::debug( "  result = $result" );

    if ( $result ) {

      # Read idx file into idx_content:

      open my $idx_file, '<', $idx_file_name or die "Can't read file $!";
      read $idx_file, my $idx_content, -s $idx_file;
      close $idx_file;

      # Parse byte start/end for surface wind variables:
      # 59:41289569:d=2018010100:UGRD:10 m above ground:anl
      # 60:42469846:d=2018010100:VGRD:10 m above ground:anl
      # 61:43656673:d=2018010100:WIND:10 m above ground:0-0 day max fcst

      my $start_byte = '';
      my $end_byte = '';
      emvl::debug( "calling parse_bytes( ..., $tag, $components, ..., ... )" );
      parse_bytes( $idx_content, $tag, $components, $start_byte, $end_byte );
      emvl::debug( "after: start_byte = '$start_byte', end_byte = '$end_byte'");

      if ( $start_byte ne '' ) { # Retrieve specified variable:
        $last_slash = rindex( $url, '/' );
        $file = substr( $url, $last_slash + 1 );
        my $data_file_name = "$temp_directory/$yyyymmdd" . "_$file";
        $command =
          "$curl --range $start_byte-$end_byte '$url' > $data_file_name";

        if ( $processes > 1 ) {
          ++$p;

          if ( $p == $processes ) {
            emvl::debug("wait\n");
            print $downloader_file "wait\n";
            $p = 0;
          }

          emvl::debug("$command &\n");
          print $downloader_file "$command &\n";
        } elsif ( $processes == 1 ) {
          $result = execute_command( $command );
        } else {
          print "$command\n";
        }

        print $file_list_file "$data_file_name\n";
      }
    }

    $yyyymmddhh = emvl::increment_hour( $yyyymmddhh );
  }

  if ( $processes > 1 ) {
    print $downloader_file "wait\n";
    close $downloader_file;
    $downloader_file = undef;
    chmod 0755, $temp_downloader;
    $result = execute_command( "$temp_downloader 2>&1 /dev/null" );
  }

  close $file_list_file;

  return $result;
}



# Parse bytes from tag in idx content:
# 59:41289569:d=2018010100:UGRD:10 m above ground:anl
# parse_bytes( $idx_content, ':UGRD:10 m ', 2, $start_byte, $end_byte );
# $start_byte is '41289569', $end_byte = '43656673'

sub parse_bytes {
  my ( $idx_content, $tag, $components, $start_byte, $end_byte ) = @_;
  my $len = length( $idx_content );
  my $end = index( $idx_content, $tag );
  $start_byte = '';
  $end_byte = '';

  if ( $end >= 4 ) {
    --$end;

    while ( $end >= 3 && substr( $idx_content, $end, 1 ) ne ':' ) {
      --$end;
    }

    if ( $end >= 3 ) {
      my $start = $end - 1;

      while ( $start >= 1 && substr( $idx_content, $start, 1 ) ne ':' ) {
        --$start;
      }

      if ( $start >= 1 ) {
        ++$start;
        $start_byte = substr( $idx_content, $start, $end - $start );

        # Skip $component lines then parse $end_byte:

        my $skip = $components;


        while ( $skip-- ) {

          while ( $start < $len && substr( $idx_content, $start, 1 ) ne "\n" ) {
            ++$start;
          }

          ++$start; # Skip newline.
        }

        if ( $start < $len ) {

          while ( $start < $len && substr( $idx_content, $start, 1) ne ':') {
            ++$start;
          }

          if ( $start + 2 < $len ) {
            ++$start; # Skip colon.
            $end = $start;

            while ( $end < $len && substr( $idx_content, $end, 1 ) ne ':' ) {
              ++$end;
            }

            if ( $end < $len ) {
              $end_byte = substr( $idx_content, $start, $end - $start );
            }
          }
        }
      }
    }
  }

  $_[ 3 ] = $start_byte;
  $_[ 4 ] = $end_byte;
}



# Construct subsetter command.

sub construct_subsetter_command {
  my $result = '';
  my $format = emvl::get_format();

  if ( $format eq 'original' ) {
    $result = "$cat $temp_file_list | $xargs $tar";
  } else {
    my $regrid = emvl::get_regrid();
    my $my_xdrconvert = '';

    if ( $regrid ne '' || $format ne 'xdr' ) {
      my $xdrconvert_format = emvl::xdrconvert_format();
      my $regrid_args = emvl::xdrconvert_regrid_args( 0 );
      $my_xdrconvert = " | $xdrconvert $regrid_args -$xdrconvert_format";
    }

    my $west_south_east_north = emvl::get_west_south_east_north();
    my $domain = " -domain $west_south_east_north ";
    my $hours = emvl::get_hours();
    my $yyyymmddhh1 = emvl::get_yyyymmddhh1();
    my $coverage_index = emvl::get_coverage_index();
    my $name       = $coverage_metadata[ $coverage_index ]->{ name };
    my $units      = $coverage_metadata[ $coverage_index ]->{ units };
    my $components = $coverage_metadata[ $coverage_index ]->{ components };
    my $vector_option  = $components > 1 ? ' -is_vector2 ' : '';
    my $cmaq_option = $cmaq eq '1' ? ' -cmaq ' : '';
    my $stride_option = $stride ne '' ? " -stride $stride " : '';
    my $my_compressor = emvl::get_compress() ? " | $compressor" : '';

    $result =
      "$subsetter" .
      " -lonlats $lonlat_file " .
      " -files $temp_file_list -tmpdir $temp_directory " .
      " -desc $desc " .
      " -timestamp $yyyymmddhh1 -hours $hours " .
      " -variable $name " .
      " -units $units " .
      $vector_option .
      $cmaq_option .
      $stride_option .
      $domain .
      "$my_xdrconvert$my_compressor";
  }

  return $result;
}






# Execute command and echo its output to STDOUT.
# E.g., execute_command( '/bin/ls' );

sub execute_command {
  my $command = shift;
  my $result = 0;
  my $the_pipe = 0;

  # -T flag requires untainting $command by matching a minimal regex needed for
  # system commands used by this program.

  if ( $command =~ m#^(/[\w-]+/[\w -/.;:,>&'@|~]+)$# )
  {
    $command = $1; # Re-assign first match, which is enough to satisfy -T.
    emvl::debug( "$0 executing command = $command" );
    %ENV = (); # Unset all environment variables prior to popen.
    # Complicated, supposedly safer way to open a readable pipe to command:
    my $pid = open( the_pipe, "-|" );

    if ( ! defined( $pid ) ) {
      die "Couldn't open pipe to subprocess";
    } elsif ( $pid ) { # Parent process.

      while ( <the_pipe> ) {
        print;
      }

      close( the_pipe );
      $result = ! $?;
    } else { # Child process.
      exec( $command ) or die "can't exec program: $!";
    }
  } else {
    print STDERR "\n$0: command contains invalid characters.\n";
  }

  return $result;
}


