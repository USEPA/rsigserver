#!/bin/sh

clear

IFLAGS=''
LFLAGS=''

if [ -e /usr/include/tirpc ]
then
  IFLAGS='-I/usr/include/tirpc'
  LFLAGS='-ltirpc'
fi

echo
echo "Compiling Utilities..."
cd Utilities
gcc -m64 -Wall -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -DNDEBUG -DNO_ASSERTIONS -DSERIAL_REGRID -O -I. $IFLAGS -c Utilities.c BasicNumerics.c DateTime.c Failure.c Memory.c Stream.c Projector.c Lambert.c Stereographic.c Mercator.c VoidList.c Grid.c elevation.c RegridQuadrilaterals.c
ls -l *.o
cd ..

echo
echo "Compiling MOZAICSubset"
gcc -m64 -Wall -D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -DNDEBUG -DNO_ASSERTIONS -O -I./Utilities -I. $IFLAGS -o MOZAICSubset MOZAICSubset.c -L. Utilities/*.o $LFLAGS -lm -lc
strip MOZAICSubset
ls -l MOZAICSubset
file  MOZAICSubset
ldd   MOZAICSubset

ls -Fsalt | head
echo Done

