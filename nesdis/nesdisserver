sub main {
  my $result = 0;

  # Before calling emvl::parse_url(), specify various options so the default
  # functions work:

  emvl::set_source( $data_source );
  emvl::set_coverage_metadata( \@coverage_metadata );
  emvl::append_parser( 'nolonlats', \&parse_nolonlats_option );

  if ( ! emvl::parse_url() ) {
    print "Content-type: text/plain; charset=iso-8859-1\n\n"; # For webserver
  } else {
    my $request = emvl::get_request();
    my $format = emvl::get_format();

    if ( $request eq 'getcapabilities' ) {
      print "Content-type: text/xml; charset=iso-8859-1\n\n"; # For webserver
      emvl::print_capabilities();
      $result = 1;
    } elsif ( $request eq 'describecoverage' ) {
      print "Content-type: text/xml; charset=iso-8859-1\n\n"; # For webserver
      emvl::print_coverage_description();
      $result = 1;
    } elsif ( $request eq 'getcoverage' ) {
      my $header = emvl::get_content_type_header(); # Based on parsed FORMAT.
      print "$header\n\n";
      compute_data_files(); # Initializes global $data_files.
      my $command = construct_command();
      $result = execute_command( $command );
    } elsif ( $request eq 'getmetadata' ) {
      print "Content-type: text/plain; charset=iso-8859-1\n\n"; # For webserver
      compute_data_files(); # Initializes global $data_files.
      my $command = construct_command();
      print $metadata_content;

      if ( $format eq 'original' ) {
        print $metadata_content_original;
        $data_files =~ tr/ /\n/;
        print "$data_files\n";
      } else {
        print $metadata_content_processed;
        $data_files =~ tr/ /\n/;
        print "$data_files\n";
        print "$command\n\n";
      }

      $result = 1;
    }
  }

  $result = 1 - $result; # UNIX: zero is success, non-zero is failure.
  emvl::debug( "exit result = $result" );

  # Must return some bytes to avoid 30 second timeout delay when unsuccessful:

  if ( $result != 0 ) {
    print STDOUT "\nFAILED\n";
  }

  exit $result;
}



# Parse nolonlats option.

sub parse_nolonlats_option {
  my $value = shift;
  my $result = 0;

  if ( $nolonlats ne '' ) {
    print STDERR "\nRedundant NOLONLATS option\n";
  } else {
    $nolonlats = $value;
    my $is_valid = $nolonlats == 0 || $nolonlats == 1;

    if ( ! $is_valid ) {
      print STDERR "\nInvalid NOLONLATS option\n";
    } else {
      $result = 1;
    }
  }

  return $result;
}



# Compute data_files from directory, coverage and time range.

sub compute_data_files {
  my $coverage = emvl::get_coverage();
  my $variable = lc( $coverage );
  my $path = "$directory/$variable";
  my $file_suffix = ".$variable.txt";
  my $is_gridded = index( $variable, '.' ) != -1;
  my @parts = '';

  emvl::debug( "is_gridded = $is_gridded" );

  if ( $is_gridded ) {
    @parts = split( /\./, $variable );
    $path = "$directory/$parts[ 0 ]";
    $file_suffix = '.ncf';
  }

  my $yyyymmdd = emvl::get_yyyymmdd1();
  my $yyyymmdd2 = emvl::get_yyyymmdd2();

  while ( $yyyymmdd <= $yyyymmdd2 ) {
    my $file_prefix  = $yyyymmdd;

    if ( $is_gridded ) {
      $file_prefix = $parts[ 0 ] . $yyyymmdd;
    }

    my $yyyy = int( $yyyymmdd / 10000 );
    $data_files .= " $path/$yyyy/$file_prefix$file_suffix";
    $yyyymmdd = emvl::increment_date( $yyyymmdd );
  }
}



# Construct command.

sub construct_command {
  my $command = '';
  my $format = emvl::get_format();

  if ( $format eq 'original' ) {
    $command = "$tar $data_files";
  } else {
    my $my_format = $format;
    my $my_xdrconvert = '';
    my $regrid = emvl::get_regrid();
    my $hours = emvl::get_hours();
    my $coverage = emvl::get_coverage();
    my $is_gridded = index( $coverage, '.' ) != -1;

    if ( $regrid ne '' || $format eq 'netcdf-coards' ) {
      $my_format = 'xdr';
      my $xdrconvert_format = emvl::xdrconvert_format();
      my $regrid_args = emvl::xdrconvert_regrid_args( 1 );
      $my_xdrconvert = " | $xdrconvert $regrid_args -$xdrconvert_format";
    }

    my $files_option = "-data $data_files";
    my $my_subsetter = $subsetter;
    my $format_option = "-$my_format";
    my $desc_option = "-desc $desc";
    my $yyyymmddhh1 = emvl::get_yyyymmddhh1();
    my $time_option = "-timestamp $yyyymmddhh1 -hours $hours";
    my $bbox = emvl::get_bbox();
    my $domain_option = "-domain $bbox";
    $domain_option =~ tr/,/ /;
    my $extra_options = '';

    if ( $is_gridded ) {
      $my_xdrconvert = '';
      $my_subsetter = $subsetter2;
      $desc_option =~ s/Site/CMAQ/g;
      $files_option = "-files $data_files";
      $format_option = "-format $format";

      if ( $format eq 'netcdf-coards' ) {
        $format_option = '-format coards';
      } elsif ( $format eq 'netcdf-ioapi' ) {
        $format_option = '-format ioapi';
      }

      my $yyyymmddhh2 = emvl::get_yyyymmddhh2();
      $time_option = "-time $yyyymmddhh1 $yyyymmddhh2";
      $domain_option = "-bounds $bbox";
      $domain_option =~ tr/,/ /;
      my @parts = split( /\./, $coverage );
      my $file_variable = uc( $parts[ 1 ] );
      my $lonlats_option = '-lonlat';

      if ( $nolonlats ne '' ) {

        if ( $nolonlats == 1 ) {
          $lonlats_option = ''; # Omit option so no LONGITUDE, LATITUDE output.
        }
      }

      $extra_options = "-tmpdir $temp_directory" .
                       " -variable $file_variable" .
                       " $lonlats_option" .
                       " -ellipsoid 6370000 6370000";
    }

    my $my_compressor = emvl::get_compress() ? " | $compressor" : '';

    $command =
      $my_subsetter .
      " $files_option " .
      " $format_option " .
      " $desc_option " .
      " $time_option " .
      " $domain_option " .
      " $extra_options " .
      "$my_xdrconvert$my_compressor";
  }

  return $command;
}



# Execute command and echo its output to STDOUT.
# E.g., execute_command( '/bin/ls' );

sub execute_command {
  my $command = shift;
  my $result = 0;
  my $the_pipe = 0;

  # -T flag requires untainting $command by matching a minimal regex needed for
  # system commands used by this program.

  if ( $command =~ m#^(/[\w-]+/[\w -/.:,'@|]+)$# )
  {
    $command = $1; # Re-assign first match, which is enough to satisfy -T.
    emvl::debug( "$0 executing command = $command" );
    %ENV = (); # Unset all environment variables prior to popen.
    # Complicated, supposedly safer way to open a readable pipe to command:
    my $pid = open( the_pipe, "-|" );

    if ( ! defined( $pid ) ) {
      die "Couldn't open pipe to subprocess";
    } elsif ( $pid ) { # Parent process.

      while ( <the_pipe> ) {
        print;
      }

      close( the_pipe );
      $result = ! $?;
    } else { # Child process.
      exec( $command ) or die "can't exec program: $!";
    }
  } else {
    print STDERR "\n$0: command contains invalid characters.\n";
  }

  return $result;
}


