#!/usr/bin/perl -wT

##############################################################################
# PURPOSE: omibehrioapiserver - Serve OMI BEHR data (OMI-BEHR satellite-
#          measured NO2 regridded to NetCDF-IOAPI grid),
#          subsetted by date/time range, variable, and longitude-latitude box,
#          in ASCII, XDR, NetCDF-COARDS, NetCDF-IOAPI and original formats
#          for use by other programs (e.g., via wget).
#
# NOTES:   Server is WCS-compliant:
#          https://www.opengeospatial.org/standards/wcs
#          https://datafed.net/xs/OpenGIS/wcs/1.0.0/
#          and modeled after a similar webserver application:
#          https://webapps.datafed.net/ogc_EPA.wsfl
#
#          Launches the C program CMAQSubset which streams the data on STDOUT.
#
#          Example usage:
#
#          curl -k --silent --retry 0 'https://ofmpub.epa.gov/rsig/rsigserver?\
#          SERVICE=wcs&\
#          VERSION=1.0.0&\
#          REQUEST=GetCoverage&\
#          COVERAGE=OMIBEHRIOAPI.NO2&\
#          TIME=2011-01-01T00:00:00Z/2011-01-01T23:59:59Z&\
#          BBOX=-90,28,-80,32,1,1&\
#          FORMAT=ascii'
#
# HISTORY: 2016-06-23 plessel.todd@epa.gov 1-919-541-5500
#
# STATUS:  unreviewed tested
##############################################################################


use strict;
#BEGIN { push @INC, '/Users/plessel/projects/rsig/code/perl'; }
BEGIN { push @INC, '/data/Apache/cgi-bin'; }
use emvl; # Local OGC-WCS query string parsing and printing utility functions.
pop @INC;

package main;
$| = 1; # Turn off output buffering so messages appear in correct order.
alarm( 3600 ); # Kill process after 1 hour. Legitimate usage could be an hour!
# Restrict PATH and ENV. (But before popen, ENV is cleared!)
delete @ENV{ 'PATH', 'IFS', 'CDPATH', 'ENV', 'BASH_ENV' };

############################## TUNABLE CONSTANTS #############################

emvl::set_debugging( 0 ); # 1 = print debug messages to STDERR logs/error_log

my $product = 'OMIBEHRIOAPI';
my $desc =
  'https://behr.cchem.berkeley.edu/berkeley-high-resolution-no2-product/,CMAQSubset';
my $data_directory = '/data/BEHR/data/ioapi';
my $temp_directory = '/data/tmp';
my $bindir     = '/rsig/current/code/bin/Linux.x86_64';
my $subsetter  = "$bindir/CMAQSubset";
my $xdrconvert = "$bindir/XDRConvert";
my $compressor = "/usr/bin/gzip -c -1";
my $tar        = '/usr/bin/tar -zcO';

# Output messages when REQUEST=GetMetadata.
# Print this message first:

my $metadata_content = '
BEHR gridded global satellite measured atmospheric data accessed using RSIG.
https://behr.cchem.berkeley.edu/berkeley-high-resolution-no2-product/
https://behr.cchem.berkeley.edu/download-behr-data/
RSIG: https://www.epa.gov/rsig
';

# If FORMAT=original then print this message second:

my $metadata_content_original = '
The list of original data files are shown below.

';

# Else FORMAT!=original then print this message second:

my $metadata_content_processed = '
Data processing was done using the RSIG programs CMAQSubset and XDRConvert.
CMAQSubset is used to subset (by variable, lon-lat box and time range)
and reorganize/reformat and filter the data.
XDRConvert is optionally used to regrid, aggregate and reformat the data
to other file formats.
The list of original data files and the RSIG command used to process them
are shown below.

';


my @coverage_metadata  = (
  {
    name          => 'NO2',
    units         => 'molecules/cm2',
    description   => 'IOAPI lonlat regridded OMI-BEHR satellite-measured total column NO2.',
    begin_date    => '2011-01-01',
    end_date      => '2015-12-31',
    west_bound    => -125,
    east_bound    => -65,
    south_bound   => 25,
    north_bound   => 50
  }
);


################################## VARIABLES #################################

# Parsed from the URL query string:

my $nolonlats = ''; # 1 = omit lonlat variables in XDR output. 0 is default.
my $aggregate = ''; # NONE, DAILY_MEAN, DAILY_MAX, DAILY_MAX8. NONE is default.

# Derived from values parsed from the WCS query string:

my $data_files = ''; # Pathed set of data files.

################################## ROUTINES ##################################


main();


sub main {
  my $result = 0;

  # Before calling emvl::parse_url(), specify various options so the default
  # functions work:

  emvl::set_source( $product );
  emvl::set_coverage_metadata( \@coverage_metadata );
  emvl::append_parser( 'nolonlats', \&parse_nolonlats_option );
  emvl::append_parser( 'aggregate', \&parse_aggregate_option );

  if ( ! emvl::parse_url() ) {
    print "Content-type: text/plain; charset=iso-8859-1\n\n"; # For webserver
  } else {
    my $request = emvl::get_request();
    my $format = emvl::get_format();

    if ( $request eq 'getcapabilities' ) {
      print "Content-type: text/xml; charset=iso-8859-1\n\n"; # For webserver
      emvl::print_capabilities();
      $result = 1;
    } elsif ( $request eq 'describecoverage' ) {
      print "Content-type: text/xml; charset=iso-8859-1\n\n"; # For webserver
      emvl::print_coverage_description();
      $result = 1;
    } elsif ( $request eq 'getcoverage' ) {
      my $header = emvl::get_content_type_header(); # Based on parsed FORMAT.
      print "$header\n\n";
      compute_input_files();

      if ( $data_files ne '' ) {
        my $command = construct_command();

        if ( $command ne '' ) {
          $result = execute_command( $command );
        }
      }
    } elsif ( $request eq 'getmetadata' ) {
      print "Content-type: text/plain; charset=iso-8859-1\n\n"; # For webserver
      compute_input_files();

      if ( $data_files ne '' ) {
        my $command = construct_command();

        if ( $command ne '' ) {
          print $metadata_content;
          $data_files =~ tr/ /\n/;

          if ( $format eq 'original' ) {
            print $metadata_content_original;
            print "$data_files\n";
            print "\n";
          } else {
            print $metadata_content_processed;
            print "$data_files\n";
            print "\n$command\n\n";
          }

          $result = 1;
        }
      }
    }
  }

  $result = 1 - $result; # UNIX: zero is success, non-zero is failure.
  emvl::debug( "exit result = $result" );

  # Must return some bytes to avoid 30 second timeout delay when unsuccessful:

  if ( $result != 0 ) {
    print STDOUT "\nFAILED\n";
  }

  exit $result;
}



# Parse nolonlats option.

sub parse_nolonlats_option {
  my $value = shift;
  my $result = 0;

  if ( $nolonlats ne '' ) {
    print STDERR "\nRedundant NOLONLATS option\n";
  } else {
    my $is_valid = $value eq '0' || $value eq '1';

    if ( ! $is_valid ) {
      print STDERR "\nInvalid NOLONLATS option\n";
    } else {
      $nolonlats = int( $value );
      $result = 1;
    }
  }

  return $result;
}



# Parse aggregate option.

sub parse_aggregate_option {
  my $value = shift;
  my $result =
    emvl::parse_option( $aggregate, $value, 'AGGREGATE',
                        'none daily_mean daily_max daily_max8' );
}



# Compute list of input data files.

sub compute_input_files {
  my $yyyymmdd = emvl::get_yyyymmdd1();
  my $yyyymmdd2 = emvl::get_yyyymmdd2();
  my $coverage = emvl::get_coverage();
  $data_files = '';

  while ( $yyyymmdd <= $yyyymmdd2 ) {
    my ( $yyyy, $mm, $dd ) = emvl::split_yyyymmdd( $yyyymmdd );
    my $data_file =
      sprintf( "$data_directory/%04d/OMI_BEHR_%s_%04d%02d%02d.ncf",
               $yyyy, $coverage, $yyyy, $mm, $dd );

    if ( -f $data_file ) {
      $data_files .= "$data_file ";
    }

    $yyyymmdd = emvl::increment_date( $yyyymmdd );
  }
}



# Construct command.

sub construct_command {
  my $command = '';
  my $format = emvl::get_format();

  if ( $format eq 'original' ) {
    $command = "$tar $data_files";
  } else {
    my $format_option = "-format $format";

    if ( $format eq 'netcdf-coards' ) {
      $format_option = '-format coards';
    } elsif ( $format eq 'netcdf-ioapi' ) {
      $format_option = '-format ioapi';
    }

    my $coverage = emvl::get_coverage();
    my $lonlats_option = $nolonlats eq '1' ? '' : '-lonlat';
    my $aggregate_option =
    ($aggregate ne '' && $aggregate ne 'none') ? " -aggregate $aggregate " : '';
    my $yyyymmddhh1 = emvl::get_yyyymmddhh1();
    my $yyyymmddhh2 = emvl::get_yyyymmddhh2();
    my $west_south_east_north = emvl::get_west_south_east_north();
    my $my_compressor = emvl::get_compress() ? " | $compressor" : '';

    $command =
      "$subsetter" .
      " -desc $desc " .
      " -tmpdir $temp_directory " .
      " -files $data_files " .
      " -time $yyyymmddhh1 $yyyymmddhh2 " .
      " -bounds $west_south_east_north " .
      " -variable $coverage " .
      " $format_option " .
      " $aggregate_option " .
      " $lonlats_option " .
      " -elevation " .
      " $my_compressor";
  }

  return $command;
}



# Execute command and echo its output to STDOUT.
# E.g., execute_command( '/bin/ls' );

sub execute_command {
  my $command = shift;
  my $result = 0;
  my $the_pipe = 0;

  # -T flag requires untainting $command by matching a minimal regex needed for
  # system commands used by this program.

  if ( $command =~ m#^(/[\w-]+/[\w -/.:,'@|]+)$# )
  {
    $command = $1; # Re-assign first match, which is enough to satisfy -T.
    emvl::debug( "$0 executing command = $command" );
    %ENV = (); # Unset all environment variables prior to popen.
    # Complicated, supposedly safer way to open a readable pipe to command:
    my $pid = open( the_pipe, "-|" );

    if ( ! defined( $pid ) ) {
      die "Couldn't open pipe to subprocess";
    } elsif ( $pid ) { # Parent process.

      while ( <the_pipe> ) {
        print;
      }

      close( the_pipe );
      $result = ! $?;
    } else { # Child process.
      exec( $command ) or die "can't exec program: $!";
    }
  } else {
    print STDERR "\n$0: command contains invalid characters.\n";
  }

  return $result;
}


