#!/bin/csh -f

###############################################################################
# PURPOSE: update_location_info2 - Update data/location_info2 file.
# NOTES:   Like update_location_info but creates a second info file from the
#          list of sites that aws has but OpenAQ does not.
#          The list is generated by manuall running check_sites.
#          This requires reading all data files from 30,000 sites and
#          so is too slow to run often.
# HISTORY: 2026-06-29 plessel.todd@epa.gov
###############################################################################

# Tunable variables:

set directory = /data/OpenAQ
set temp_directory = /data/tmp
set data_directory = $directory/data
set temp_file_list = $temp_directory/update_location_info2.temp.$$
set location_info2_file = $data_directory/location_info2
set location_info2_file_temp = $location_info2_file.temp
set missing_sites_file = $directory/missing_openaq_sites
set bindir = /rsig/current/code/bin/Linux.x86_64
set subsetter = $bindir/OpenAQSubset


###############################################################################

date -u
printf "locationid\tlongitude\tlatitude\tfirst_yyyymmdd\tlast_yyyymmdd\tvariables\tdescription\n" > $location_info2_file_temp
set missing_ids = `cat $missing_sites_file`

foreach id ( $missing_ids )

  # It is too slow to read all data files so just read the first and last file
  # to get the date range and hope the variable list is not changing over time.

  ls -1 $data_directory/locationid=$id/year=????/month=??/location-$id-????????.csv.gz | head -1 >  $temp_file_list
  ls -1 $data_directory/locationid=$id/year=????/month=??/location-$id-????????.csv.gz | tail -1 >> $temp_file_list
  $subsetter -info $temp_file_list >> $location_info2_file_temp
end

# Update the info file only if it is not smaller (because something failed):

@ file_size = `ls -l $location_info2_file | awk '{ print $5 }'`

@ file_size_temp = `ls -l $location_info2_file_temp | awk '{ print $5 }'`
echo "Info file sizes: existing = $file_size updated = $file_size_temp"

if ( $file_size_temp > 2000000 ) then
 cp -p $location_info2_file $location_info2_file.bak
 mv    $location_info2_file_temp $location_info2_file
endif

ls -l $location_info2_file
wc -l $location_info2_file
date -u
echo "DONE"

