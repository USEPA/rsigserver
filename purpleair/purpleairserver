# Validate key by calling external webservice:

sub is_valid_key {
  my $result = 0;

  if ( $enforce_valid_key == 0 || $key eq 'EPA' ) { # HACK backdoor!
    $result = 1;
  } else {

    if ( $key ne '' ) {
      my $check_key_command =
        "$curl $curl_options --header 'X-API-Key:$key' '$key_url'" .
        " > $temp_key_check_file";
      emvl::debug( "$check_key_command" );
      $result = execute_command( $check_key_command );
      emvl::debug( "result = $result" );

      if ( $result ) {
        open my $file, "< $temp_key_check_file"
          or die "Can't open file for reading: $!";

        while ( my $line = <$file> ) {

          if ( index( $line, 'error' ) != -1 ) {
            $result = 0;
          } elsif ( index ( $line, 'api_key_type' ) != -1 ) {
            $result = index ( $line, 'READ' ) != -1;
          }
        }

        close $file or die "Can't close file: $!";
      }

      unlink( $temp_key_check_file );
    }
  }

  emvl::debug( "is_valid_key result = $result" );
  return $result;
}



# Check that all required 'options' have been specified.
# Check for key usage, otherwise call the default implementation.

sub required_options_specified {
  my $result = 0;
  my $request = emvl::get_request();

  if ( $just_check_key ) {
    $result = 1; # Key was verified during custom parsing.
  } elsif ( ( $request eq 'getcoverage' || $request eq 'getmetadata' ) &&
            $enforce_valid_key && $key eq '' ) {
    print STDERR "\nMissing option: 'KEY'\n";
  } else {
    $result = emvl::required_options_specified();
  }

  return $result;
}



# Compute time-sorted list of input data files within TIME range and
# Write it to temp_list_file and return number of files in the list.

sub compute_input_file_list {
  my $file_count = 0;
  open my $temp_file, '>', $temp_list_file;
  emvl::debug( "creating $temp_list_file" );

  if ( $temp_file >= 0 ) {
    emvl::debug( "temp_file = $temp_file" );
    my $coverage = emvl::get_coverage();

    if ( index( $coverage, '_hourly' ) != -1 ||
         index( $coverage, '_daily' ) != -1 ) {
      my $yyyymmdd  = emvl::get_yyyymmdd1();
      my $yyyymmdd2 = emvl::get_yyyymmdd2();

      while ( $yyyymmdd <= $yyyymmdd2 ) {
        my $yyyy = int( $yyyymmdd / 10000 );
        my $data_file = "$data_directory/$yyyy/$yyyymmdd/$coverage.xdr";

        if ( -f $data_file ) {
          emvl::debug( "$data_file" );
          print $temp_file "$data_file\n";
          ++$file_count;
        }

        $yyyymmdd = emvl::increment_date( $yyyymmdd );
      }

    } else {
      my $yyyymmddhhmmss  = emvl::get_yyyymmddhhmmss1();
      my $yyyymmddhhmmss2 = emvl::get_yyyymmddhhmmss2();

      while ( $yyyymmddhhmmss le $yyyymmddhhmmss2 ) {
        my $yyyy = int( substr( $yyyymmddhhmmss, 0, 4 ) );
        my $yyyymmdd = int( substr( $yyyymmddhhmmss, 0, 8 ) );
        my $hhmmss = substr( $yyyymmddhhmmss, 8, 6 );
        my $data_file = "$data_directory/$yyyy/$yyyymmdd/purpleair_$hhmmss.json";

        if ( -f $data_file ) {
          emvl::debug( "$data_file" );
          print $temp_file "$data_file\n";
          ++$file_count;
        }

        $yyyymmddhhmmss  = emvl::increment_second( $yyyymmddhhmmss );
      }
    }

    close $temp_file;
  }

  return $file_count;
}



# Construct subsetter command.

sub construct_command {
  my $command = '';
  my $coverage = emvl::get_coverage();
  my $format = emvl::get_format();

  if ( $format eq 'original' ) {

    if ( $coverage eq 'locations' ) {
      $command = "$lister > $temp_list_file ; $tar $temp_list_file";
    } else {
      $command = "$cat $temp_list_file | $xargs $tar";
    }
  } else {
    my $subsetter_format = $format;
    my $my_xdrconvert = '';
    my $is_preaggregated = ( index( $coverage, '_hourly' ) != -1 ||
                             index( $coverage, '_daily'   ) != -1 );

    emvl::debug( "is_preaggregated = $is_preaggregated" );

    # Unlike other subset programs, PurpleAirSubset supports -format ascii.

    my $regrid = emvl::get_regrid();

    if ( $regrid ne '' || $is_preaggregated || $coverage eq 'locations' ||
         ( $format ne 'xdr' && $format ne 'ascii' ) ) {
      $subsetter_format = 'xdr';
      my $xdrconvert_format = emvl::xdrconvert_format();

      if ( $xdrconvert_format eq '' ) {
        $xdrconvert_format = $format;
        my @format_parts = split( /-/, $format );
        my $format_parts_count = @format_parts;

        if ( $format_parts_count == 2 ) {
          $xdrconvert_format = $format_parts[ 1 ];
        }
      }

      my $regrid_args = emvl::xdrconvert_regrid_args( 0 );
      $my_xdrconvert = " | $xdrconvert $regrid_args -$xdrconvert_format";

      if ( $coverage eq 'locations' && $format eq 'xdr' ) {
        $my_xdrconvert = '';
      }
    }

    my $west_south_east_north = emvl::get_west_south_east_north();
    my $domain_option = " -bounds $west_south_east_north ";
    my $sensor_option = '';

    if ( $sensor ne '' ) {
      $sensor_option = " -sensor $sensor ";
    }

    my $yyyymmddhhmmss1 = emvl::get_yyyymmddhhmmss1();
    my $yyyymmddhhmmss2 = emvl::get_yyyymmddhhmmss2();
    my $my_compressor = emvl::get_compress() ? " | $compressor" : '';

    if ( $is_preaggregated ) {
      $command =
      "$preaggregated_subsetter" .
        " -files $temp_list_file" .
        " -tmpdir $temp_directory" .
        " -timerange $yyyymmddhhmmss1 $yyyymmddhhmmss2 " .
        $domain_option .
        $sensor_option .
        "$my_xdrconvert$my_compressor";
    } elsif ( $coverage eq 'locations' ) {

      $command =
        "$site_subsetter " .
          " -desc $desc " .
          " -timerange $yyyymmddhhmmss1 $yyyymmddhhmmss2 " .
          $domain_option .
          "$my_xdrconvert$my_compressor";
    } else {
      my $aggregate_option = '';

      if ( $aggregate ne '' ) {
        $aggregate_option = " -aggregate $aggregate ";
      }

      my $out_in_flag_option = '';

      if ( $out_in_flag ne '' ) {
        $out_in_flag_option = " -out_in_flag $out_in_flag ";
      }

      my $maximum_difference_option = '';

      if ( $maximum_difference ne '' ) {
        $maximum_difference_option = " -maximum_difference $maximum_difference ";
      }

      my $maximum_ratio_option = '';

      if ( $maximum_ratio ne '' ) {
        $maximum_ratio_option = " -maximum_ratio $maximum_ratio ";
      }

      my $minimum_aggregation_count_percentage_option = '';

      if ( $minimum_aggregation_count_percentage ne '' ) {
        $minimum_aggregation_count_percentage_option =
          " -minimum_aggregation_count_percentage " .
          "$minimum_aggregation_count_percentage ";
      }

      my $default_humidity_option = '';

      if ( $default_humidity ne '' ) {
        $default_humidity_option = " -default_humidity $default_humidity ";
      }

      my $run_parallel_option = '';

      if ( $run_parallel_tasks > 1 ) {
        $run_parallel_option = "$run_parallel $run_parallel_tasks "
      }

      $command =
        "$run_parallel_option".
        "$subsetter" .
        " -files $temp_list_file" .
        " -tmpdir $temp_directory" .
        " -desc $desc " .
        " -timerange $yyyymmddhhmmss1 $yyyymmddhhmmss2 " .
        " -variable $coverage " .
        " -format $subsetter_format " .
        $domain_option .
        $sensor_option .
        $out_in_flag_option .
        $maximum_difference_option .
        $maximum_ratio_option .
        $minimum_aggregation_count_percentage_option .
        $default_humidity_option .
        $aggregate_option .
        "$my_xdrconvert$my_compressor";
    }
  }

  return $command;
}



# Execute command and echo its output to STDOUT.
# E.g., execute_command( '/bin/ls' );

sub execute_command {
  my $command = shift;
  my $result = 0;
  my $the_pipe = 0;

  # -T flag requires untainting $command by matching a minimal regex needed for
  # system commands used by this program.

  if ( $command =~ m#^(/[\w-]+/[\w /.;:,>'@|?=&_\-]+)$# )
  {
    $command = $1; # Re-assign first match, which is enough to satisfy -T.
    emvl::debug( "$0 executing command = $command" );
    %ENV = (); # Unset all environment variables prior to popen.
    # Complicated, supposedly safer way to open a readable pipe to command:
    my $pid = open( the_pipe, "-|" );

    if ( ! defined( $pid ) ) {
      die "Couldn't open pipe to subprocess";
    } elsif ( $pid ) { # Parent process.

      while ( <the_pipe> ) {
        print;
      }

      close( the_pipe );
      $result = ! $?;
    } else { # Child process.
      exec( $command ) or die "can't exec program: $!";
    }
  } else {
    print STDERR "\n$0: command contains invalid characters.\n";
  }

  return $result;
}


