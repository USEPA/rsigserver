sub main {
  my $result = 0;

  # Before calling emvl::parse_url(), specify various options so the default
  # functions work:

  emvl::set_source( $data_source );
  emvl::set_coverage_metadata( \@coverage_metadata );
  emvl::set_metadata_west_bound( $west_bound );
  emvl::set_metadata_east_bound( $east_bound );
  emvl::set_metadata_south_bound( $south_bound );
  emvl::set_metadata_north_bound( $north_bound );
  emvl::append_parser( 'aggregate', \&parse_aggregate_option );
  emvl::append_parser( 'out_in_flag', \&parse_out_in_flag_option );
  emvl::append_parser( 'minimum_confidence', \&parse_minimum_confidence_option);
  emvl::append_parser( 'maximum_difference', \&parse_maximum_difference_option);
  emvl::append_parser( 'maximum_ratio', \&parse_maximum_ratio_option );
  emvl::append_parser( 'minimum_aggregation_count_percentage',
                       \&parse_minimum_aggregation_count_percentage_option );
  emvl::append_parser( 'default_humidity', \&parse_default_humidity_option );
  emvl::append_parser( 'sensor', \&parse_sensor_option );
  emvl::append_parser( 'key', \&parse_key_option );
  emvl::append_parser( 'check_key', \&parse_check_key_option );
  emvl::set_required_options_specified( \&required_options_specified );

  if ( ! emvl::parse_url() ) {
    print "Content-type: text/plain; charset=iso-8859-1\n\n"; # For webserver

    if ( $just_check_key ) {
      print "0\n"; # 0 indicates failed to validate key.
    }
  } elsif ( $just_check_key ) {
    print "Content-type: text/plain; charset=iso-8859-1\n\n"; # For webserver
    print "1\n"; # 1 indicates validated key.
    $result = 1;
  } else {
    my $request = emvl::get_request();
    my $format = emvl::get_format();

    if ( $request eq 'getcapabilities' ) {
      print "Content-type: text/xml; charset=iso-8859-1\n\n"; # For webserver
      emvl::print_capabilities();
      $result = 1;
    } elsif ( $request eq 'describecoverage' ) {
      print "Content-type: text/xml; charset=iso-8859-1\n\n"; # For webserver
      emvl::print_coverage_description();
      $result = 1;
    } elsif ( $request eq 'getcoverage' ) {
      my $header = emvl::get_content_type_header(); # Based on parsed FORMAT.
      print "$header\n\n";
      my $coverage = '';
      my $file_count = 0;

      if ( $coverage ne 'sites' && $coverage ne 'locations' ) {
        $file_count = compute_input_file_list();
      }

      if ($file_count > 0 || $coverage eq 'sites' || $coverage eq 'locations') {
        my $command = construct_command();
        $result = execute_command( $command );
      }
    } elsif ( $request eq 'getmetadata' ) {
      print "Content-type: text/plain; charset=iso-8859-1\n\n"; # For webserver
      my $file_count = compute_input_file_list();

      if ( $file_count > 0 ) {
        my $command = construct_command();
        my $list_files_command = "$cat $temp_list_file";
        print $metadata_content;

        if ( $format eq 'original' ) {
          print $metadata_content_original;
          $result = execute_command( $list_files_command );
          print "\n";
        } else {
          print $metadata_content_processed;
          $result = execute_command( $list_files_command );
          print "\n$command\n\n";
        }
      }
    }
  }

  unlink( $temp_list_file );

  $result = 1 - $result; # UNIX: zero is success, non-zero is failure.
  emvl::debug( "exit result = $result" );

  # Must return some bytes to avoid 30 second timeout delay when unsuccessful:

  if ( $result != 0 ) {
    print STDOUT "\nFAILED\n";
  }

  exit $result;
}



