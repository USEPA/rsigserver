# Parse coverage option.
# Called by emvl::parse_url().
# It must return the valid coverage string or else ''.

sub parse_coverage_option {
  my $value = shift;
  $coverage = $value;
  my $ok = 0;
  my @parts = split( /-/, $value );
  my $count = @parts;

  if ( $count != 3 ) {
    print STDERR "\nInvalid COVERAGE option: '$value'\n";
  } else {
    $data_coverage = $parts[ 0 ];
    $cmaq_coverage = $parts[ 1 ];
    $operator      = $parts[ 2 ];

    if ( index( ' diff abs_diff percent_diff ratio replace convert ',
                "$operator" ) == -1 ) {
      print STDERR "\nInvalid COVERAGE option: '$value'\n";
    } else {
      $ok = 1;
    }
  }

  my $result = $ok ? $value : '';
  return $result;
}



# Parse corners option:

sub parse_corners_option {
  my $value = shift;
  my $result = 0;

  if ( $corners ne '' ) {
    print STDERR "\nRedundant CORNERS option: '$value'\n";
  } else {
    my $is_valid = $value eq '0' || $value eq '1';

    if ( ! $is_valid ) {
      print STDERR "\nInvalid CORNERS option: '$value'\n";
    } else {
      $corners = int( $value );
      $result = 1;
    }
  }

  return $result;
}



# Parse minimum_quality option.

sub parse_minimum_quality_option {
  my $value = shift;
  my $result = emvl::parse_option( $minimum_quality, $value, 'MINIMUM_QUALITY',
                                   'normal suspect bad' );
  return $result;
}



# Parse minimum_cad option.

sub parse_minimum_cad_option {
  my $value = shift;
  my $result = 0;

  if ( $minimum_cad ne '' ) {
    print STDERR "\nRedundant MINIMUM_CAD option: '$value'\n";
  } else {
    my $is_valid = emvl::in_range( $value, 0.0, 100.0 );

    if ( ! $is_valid ) {
      print STDERR "\nInvalid MINIMUM_CAD option: '$value'\n";
    } else {
      $minimum_cad = $value;
      $result = 1;
    }
  }

  return $result;
}



