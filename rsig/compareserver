sub main {
  my $result = 0;

  # Before calling emvl::parse_url(), specify various options so the default
  # functions work:

  emvl::set_source( $data_source );
  emvl::append_parser( 'corners', \&parse_corners_option );
  emvl::append_parser( '$minimum_cad', \&parse_minimum_cad_option );
  emvl::append_parser( '$maximum_uncertainty', \&parse_maximum_uncertainty_option );
  emvl::append_parser( 'minimum_quality', \&parse_minimum_quality_option );
  emvl::append_parser( 'maximum_cloud_fraction', \&parse_maximum_cloud_fraction_option );
  emvl::append_parser( 'maximum_solar_zenith_angle', \&parse_maximum_solar_zenith_angle_option );
  emvl::append_parser( 'allow_negative_counts', \&parse_allow_negative_counts_option );
  emvl::set_parse_coverage_option( \&parse_coverage_option );
  emvl::set_required_options_specified( \&required_options_specified );

  if ( ! emvl::parse_url() ) {
    print "Content-type: text/plain; charset=iso-8859-1\n\n"; # For webserver
  } else {
    my $request = emvl::get_request();
    my $format = emvl::get_format();

    if ( $request eq 'getcapabilities' ) {
      print "Content-type: text/xml; charset=iso-8859-1\n\n"; # For webserver
      emvl::print_capabilities( \&print_coverage_offering_brief );
      $result = 1;
    } elsif ( $request eq 'describecoverage' ) {
      print "Content-type: text/xml; charset=iso-8859-1\n\n"; # For webserver
      emvl::print_coverage_description( \&print_coverage_offering );
      $result = 1;
    } elsif ( $request eq 'getcoverage' || $request eq 'getmetadata' ) {
      my $header = emvl::get_content_type_header(); # Based on parsed FORMAT.
      print "$header\n\n";
      my $my_cmaq_coverage = $cmaq_coverage;

      # If convert/scale get offset variable too:

      if ( $my_cmaq_coverage eq 'geoschem.scale.conus.aod2pm25.slope' ) {
        $my_cmaq_coverage .= ',geoschem.scale.conus.aod2pm25.offset';
      }

      if ( $my_cmaq_coverage eq 'geoschem.scale.conus4km.aod2pm25.slope' ) {
        $my_cmaq_coverage .= ',geoschem.scale.conus4km.aod2pm25.offset';
      }

      my $my_request =
        $request eq 'getcoverage' ? 'GetCoverage' : 'GetMetadata';
      my $my_output = $request eq 'getcoverage' ? " > $temp_file_name" : '';

      my $bbox = emvl::get_bbox();
      my $time = emvl::get_time();

      my $cmaq_command =
        "$curl_command '$rsigserver_path" .
        "SERVICE=wcs&VERSION=1.0.0&REQUEST=$my_request&" .
        "COVERAGE=$my_cmaq_coverage&BBOX=$bbox&TIME=$time&format=xdr'" .
        $my_output;

      $result = execute_command( $cmaq_command );

      emvl::debug( "compareserver: cmaq_command = $cmaq_command" );
      emvl::debug( "compareserver: result = $result" );

      if ( $result ) { # Run XDRConvert on temporary file (on local host):
        my $compare_command = construct_compare_command();

        if ( $request eq 'getcoverage' ) {
          $result = execute_command( $compare_command );

          if ( ! emvl::get_debugging() ) {
            unlink( $temp_file_name );
          }
        } else {
          print STDOUT "\n$compare_command\n";
        }

        emvl::debug( "compareserver: compare_command = $compare_command" );
        emvl::debug( "compareserver: result = $result" );
      }
    }
  }

  $result = 1 - $result; # UNIX: zero is success, non-zero is failure.
  emvl::debug( "exit result = $result" );

  # Must return some bytes to avoid 30 second timeout delay when unsuccessful:

  if ( $result != 0 ) {
    print STDOUT "\nFAILED\n";
  }

  exit $result;
}



