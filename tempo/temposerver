#!/usr/bin/perl -wT

##############################################################################
# PURPOSE: temposerver - Parses the WCS query then, if, valid, forwards to
#          cain.larc.nasa.gov/cgi-bin/temposerver
#          to serve TEMPO satellite data,
#          subsetted by date/time range, variable, and
#          longitude-latitude box, in ASCII, XDR, NetCDF-COARDS, NetCDF-IOAPI
#          and original formats for use by other programs (e.g., via wget).
#
# NOTES:   Server is WCS-compliant:
#          https://www.opengeospatial.org/standards/wcs
#          https://datafed.net/xs/OpenGIS/wcs/1.0.0/
#          and modeled after a similar webserver application:
#          https://webapps.datafed.net/ogc_EPA.wsfl
#
#          This program validates the WCS query string before forwarding to
#          the remote webservice to avoid forwarding the hundreds of
#          invalid query strings that occur when maple is subject to security
#          testing.
#
#          Example usage:
#
#          curl -k --silent --retry 0 'https://ofmpub.epa.gov/rsig/rsigserver?\
#          SERVICE=wcs&\
#          VERSION=1.0.0&\
#          REQUEST=GetCoverage&\
#          COVERAGE=tempo.l2.aodalh.aod550&\
#          TIME=2023-08-02T00:00:00Z/2023-08-03T23:59:59Z&\
#          BBOX=-77,36,-75,38&\
#          FORMAT=ascii'
#
# HISTORY: 2023-08-02 plessel.todd@epa.gov
# STATUS:  reviewed tested
##############################################################################

use strict;
#BEGIN { push @INC, '/Users/plessel/projects/rsig/code/perl'; }
BEGIN { push @INC, '/data/Apache/cgi-bin'; }
use emvl; # Local OGC-WCS query string parsing and printing utility functions.
use tempo; # Use my $coverage_metadata_reference = tempo::get_coverage_metadata_reference();
pop @INC;

package main;
$| = 1; # Turn off output buffering so messages appear in correct order.
alarm( 3600 ); # Kill process after 1 hour. Legitimate usage could be an hour!
# Restrict PATH and ENV. (But before popen, ENV is cleared!)
delete @ENV{ 'PATH', 'IFS', 'CDPATH', 'ENV', 'BASH_ENV' };

############################## TUNABLE CONSTANTS #############################

emvl::set_debugging( 0 ); # 1 = print debug messages to STDERR logs/error_log
my $valid_key = "TEMPOST"; # PI's chosen key on 2023-10-20.

# override_key:
# 0 = check parsed key (if specified) and forward if it is valid.
# 1 = ignore any parsed key and just always forward the valid key.
# Per 2026-04-02 email from georgina.hayes-crepps@nasa.gov,
# all TEMPO data files that exist on cain are public.
# Therefore, TEMPO key is no longer necessary.

my $override_key = 1;

my $server_path  = 'https://cain.larc.nasa.gov/cgi-bin/temposerver?';

my $curl_command =
  "/usr/bin/curl -4 -k --silent --max-time 3600 --retry 0 -L --tcp-nodelay ";


# Output messages when REQUEST=GetMetadata.
# Print this message first:

my $metadata_content = '
TEMPO global satellite measured pollutant data accessed using RSIG.
TEMPO: https://tempo.si.edu/
RSIG: https://www.epa.gov/rsig

For inquiries about TEMPO data releases, please contact
larc-dl-asdc-tempo@mail.nasa.gov.

';

# If FORMAT=original then print this message second:

my $metadata_content_original = '
The list of original data files are shown below.

';

# Else FORMAT!=original then print this message second:

my $metadata_content_processed = '
Data processing was done using the RSIG programs TEMPOSubset and XDRConvert.
TEMPOSubset is used to subset (by variable, lon-lat box and time range)
and reorganize/reformat and filter the data.
XDRConvert is optionally used to regrid, aggregate and reformat the data
to other file formats.
The list of original data files and the RSIG command used to process them
are shown below.

';


my $begin_date  = '2023-08-02'; # Public access to all data V03 and later.
my $end_date    = '';
my $west_bound  = -165;
my $east_bound  = -20;
my $south_bound = 16;
my $north_bound = 65;


################################## VARIABLES #################################

# Parsed from the URL query string:

my $layer = ''; # E.g., 1 or 24.
my $corners = ''; # 1 = compute corners otherwise don't (default).
my $minimum_quality = ''; # 'normal', 'suspect', 'bad'. Default is 'normal'.
my $maximum_cloud_fraction = ''; # Max accepted cloud fraction [0,1] Def. 1.
my $maximum_solar_zenith_angle = ''; # Max accepted SLA [0, 90] Default 90.
my $allow_negative_counts = ''; # 1 = Allow negative molecules/cm2? (Default 0).
my $just_check_key = 0;  # Just check key and output one line result: 0 or 1.
my $key = ''; # Key required for retrieval of non-proxy data.

################################## ROUTINES ##################################


main();


sub main {
  my $result = 0;

  # Before calling emvl::parse_url(), specify various options so the default
  # functions work:

  emvl::set_source( 'TEMPO' );
  emvl::set_coverage_metadata( tempo::get_coverage_metadata_reference() );
  emvl::set_metadata_begin_date( $begin_date );
  emvl::set_metadata_end_date( $end_date );
  emvl::set_metadata_west_bound( $west_bound );
  emvl::set_metadata_east_bound( $east_bound );
  emvl::set_metadata_south_bound( $south_bound );
  emvl::set_metadata_north_bound( $north_bound );
  emvl::append_parser( 'key', \&parse_key_option );
  emvl::append_parser( 'check_key', \&parse_check_key_option );
  emvl::append_parser( 'corners', \&parse_corners_option );
  emvl::append_parser( 'layer', \&parse_layer_option );
  emvl::append_parser( 'minimum_quality', \&parse_minimum_quality_option );
  emvl::append_parser( 'maximum_cloud_fraction', \&parse_maximum_cloud_fraction_option );
  emvl::append_parser( 'maximum_solar_zenith_angle', \&parse_maximum_solar_zenith_angle_option );
  emvl::append_parser( 'allow_negative_counts', \&parse_allow_negative_counts_option );
  emvl::set_required_options_specified( \&required_options_specified );

  if ( ! emvl::parse_url() ) {
    print "Content-type: text/plain; charset=iso-8859-1\n\n"; # For webserver

    if ( $just_check_key ) {
      print "0\n"; # 0 indicates failed to validate key.
    }
  } elsif ( $just_check_key ) {
    print "Content-type: text/plain; charset=iso-8859-1\n\n"; # For webserver
    print "1\n"; # 1 indicates validated key.
    $result = 1;
  } else {
    my $request = emvl::get_request();

    if ( $request eq 'getcapabilities' ) {
      print "Content-type: text/xml; charset=iso-8859-1\n\n"; # For webserver
      emvl::print_capabilities();
      $result = 1;
    } elsif ( $request eq 'describecoverage' ) {
      print "Content-type: text/xml; charset=iso-8859-1\n\n"; # For webserver
      emvl::print_coverage_description();
      $result = 1;
    } else { # For getcoverage or getmetadata forward to the remote webservice:
      my $header = emvl::get_content_type_header(); # Based on parsed FORMAT.
      print "$header\n\n"; # For webserver
      my $query_string = emvl::remove_option_from_parsed_query_string('RSIG_ID');

      if ( $override_key ) {
        $query_string = rekeyed_query_string( $query_string );
      }

      my $command = "$curl_command '$server_path$query_string'";
      $result = execute_command( $command );
    }
  }

  $result = 1 - $result; # UNIX: zero is success, non-zero is failure.
  emvl::debug( "exit result = $result" );

  # Must return some bytes to avoid 30 second timeout delay when unsuccessful:

  if ( $result != 0 ) {
    print STDOUT "\nFAILED\n";
  }

  exit $result;
}



# Replace/add KEY=valid_key:

sub rekeyed_query_string {
  my $query_string = shift;
  my $result = '';
  my @parts = split( /&/, $query_string );

  # Append all option=value pairs except KEY=value:

  foreach my $option_value_pair ( @parts ) {

    if ( substr( uc( $option_value_pair ), 0, 4 ) ne 'KEY=' ) {

      if ( $result ne '' ) {
        $result .= '&';
      }

      $result .= $option_value_pair;
    }
  }

  # Append KEY=$valid_key:

  if ( $result ne '' ) {
    $result .= '&';
  }

  $result .= "KEY=$valid_key";

  return $result;
}



# Parse layer option.

sub parse_layer_option {
  my $value = shift;
  my $result = 0;

  if ( $layer ne '' ) {
    print STDERR "\nRedundant LAYER option\n";
  } else {
    my $is_valid = int( $value ) >= 1;

    if ( ! $is_valid ) {
      print STDERR "\nInvalid LAYER option (requires >= 1)\n";
    } else {
      $layer = $value;
      $result = 1;
    }
  }

  return $result;
}



# Parse corners option:

sub parse_corners_option {
  my $value = shift;
  my $result = 0;

  if ( $corners ne '' ) {
    print STDERR "\nRedundant CORNERS option: '$value'\n";
  } else {
    my $is_valid = $value eq '0' || $value eq '1';

    if ( ! $is_valid ) {
      print STDERR "\nInvalid CORNERS option: '$value'\n";
    } else {
      $corners = $value;
      $result = 1;
    }
  }

  return $result;
}



# Parse minimum_quality option.

sub parse_minimum_quality_option {
  my $value = shift;
  my $result = emvl::parse_option( $minimum_quality, $value, 'MINIMUM_QUALITY',
                                   'normal suspect bad' );
  return $result;
}



sub parse_maximum_cloud_fraction_option {
  my $value = shift;
  my $result = 0;

  if ( $maximum_cloud_fraction ne '' ) {
    print STDERR "\nRedundant MAXIMUM_CLOUD_FRACTION option\n";
  } else {
    my $is_valid = emvl::in_range( $value, 0.0, 1.0 );

    if ( ! $is_valid ) {
      print STDERR "\nInvalid MAXIMUM_CLOUD_FRACTION option requires range [0.0, 1.0]\n";
    } else {
      $maximum_cloud_fraction = $value;
      $result = 1;
    }
  }

  return $result;
}



# Parse maximum_solar_zenith_angle option.

sub parse_maximum_solar_zenith_angle_option {
  my $value = shift;
  my $result = 0;

  if ( $maximum_solar_zenith_angle ne '' ) {
    print STDERR "\nRedundant MAXIMUM_SOLAR_ZENITH_ANGLE option\n";
  } else {
    my $is_valid = emvl::in_range( $value, 0.0, 90.0 );

    if ( ! $is_valid ) {
      print STDERR "\nInvalid MAXIMUM_SOLAR_ZENITH_ANGLE option requires range [0.0, 90.0]\n";
    } else {
      $maximum_solar_zenith_angle = $value;
      $result = 1;
    }
  }

  return $result;
}



# Parse allow_negative_counts option:

sub parse_allow_negative_counts_option {
  my $value = shift;
  my $result = 0;

  if ( $allow_negative_counts ne '' ) {
    print STDERR "\nRedundant ALLOW_NEGATIVE_COUNTS option\n";
  } else {
    my $is_valid = $value eq '0' || $value eq '1';

    if ( ! $is_valid ) {
      print STDERR "\nInvalid ALLOW_NEGATIVE_COUNTS option (require 0 or 1)\n";
    } else {
      $allow_negative_counts = $value;
      $result = 1;
    }
  }

  return $result;
}



# Parse key option:

sub parse_key_option {
  my $value = shift;
  my $result = 0;

  if ( $key ne '' ) {
    print STDERR "\nRedundant KEY option\n";
  } else {

    if ( $value =~ m#^([\w-]+)$# )
    {
      $key = uc( $value );
      $result = $key eq $valid_key;
    }

    if ( $override_key ) {
      $key = $valid_key;
      $result = 1;
    }

    if ( ! $result ) {
      print STDERR "\nInvalid KEY option.\n";
      # Ignore invalid key value so Barron's code can use a placeholder value.
      $key = '';
      $result = 1;
    }
  }

  return $result;
}



# Parse check_key option:

sub parse_check_key_option {
  my $value = shift;
  my $result = 0;
  $just_check_key = 1;

  if ( $key ne '' ) {
    print STDERR "\nRedundant CHECK_KEY/KEY option\n";
  } else {

    if ( $value =~ m#^([\w-]+)$# )
    {
      $key = uc( $value );
      $result = $key eq $valid_key;
    }
  }

  return $result;
}



# Check that all required 'options' have been specified:

sub required_options_specified {
  my $result = 0;

  if ( $just_check_key ) {
    $result = 1;
  } else {
    $result = emvl::required_options_specified();
  }

  return $result;
}



# Execute command and echo its output to STDOUT.
# E.g., execute_command( '/bin/ls' );

sub execute_command {
  my $command = shift;
  my $result = 0;
  my $the_pipe = 0;

  # -T flag requires untainting $command by matching a minimal regex needed for
  # system commands used by this program.

  if ( $command =~ m#^(/[\w-]+/[\w \$'\(\)\+,\-\./:;=>&?@\\_`{|}]+)$# )
  {
    $command = $1; # Re-assign first match, which is enough to satisfy -T.
    emvl::debug( "$0 executing command = $command" );
    %ENV = (); # Unset all environment variables prior to popen.
    # Complicated, supposedly safer way to open a readable pipe to command:
    my $pid = open( the_pipe, "-|" );

    if ( ! defined( $pid ) ) {
      die "Couldn't open pipe to subprocess";
    } elsif ( $pid ) { # Parent process.

      while ( <the_pipe> ) {
        print;
      }

      close( the_pipe );
      $result = ! $?;
    } else { # Child process.
      exec( $command ) or die "can't exec program: $!";
    }
  } else {
    print STDERR "\n$0: command contains invalid characters.\n";
  }

  return $result;
}


