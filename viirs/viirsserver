#!/usr/bin/perl -wT

##############################################################################
# PURPOSE: viirsserver - Serve VIIRS satellite AOD data,
#          subsetted by date/time range, variable, and
#          longitude-latitude box, in ASCII, XDR, original, NetCDF-COARDS, and
#          NetCDF-IOAPI formats for use by other programs (e.g., via wget).
# NOTES:   Server is WCS-compliant:
#          https://www.opengeospatial.org/standards/wcs
#          https://datafed.net/xs/OpenGIS/wcs/1.0.0/
#          and modeled after a similar webserver application:
#          https://webapps.datafed.net/ogc_EPA.wsfl
#
#          Launches the C Shell script listfiles and the
#          C program VIIRSSubset which streams the data back on STDOUT.
#
#          Example usage:
#
#          curl -k --silent --retry 0 'https://ofmpub.epa.gov/rsig/rsigserver?\
#          SERVICE=wcs&\
#          VERSION=1.0.0&\
#          REQUEST=GetCoverage&\
#          COVERAGE=viirs.jrraod.AOD50&\
#          TIME=2017-08-15T00:00:00Z/2017-08-15T23:59:59Z&\
#          BBOX=-120,13,-101,17&\
#          FORMAT=ascii'
#
# HISTORY: 2013-01-25 plessel.todd@epa.gov
# STATUS:  reviewed tested
##############################################################################

use strict;
#BEGIN { push @INC, '/Users/plessel/projects/rsig/code/perl'; }
BEGIN { push @INC, '/data/Apache/cgi-bin'; }
use emvl; # Local OGC-WCS query string parsing and printing utility functions.
pop @INC;

package main;
$| = 1; # Turn off output buffering so messages appear in correct order.
alarm( 3600 ); # Kill process after 1 hour. Legitimate usage could be an hour!
# Restrict PATH and ENV. (But before popen, ENV is cleared!)
delete @ENV{ 'PATH', 'IFS', 'CDPATH', 'ENV', 'BASH_ENV' };

############################## TUNABLE CONSTANTS #############################

emvl::set_debugging( 0 ); # 1 = print debug messages to STDERR logs/error_log
my $run_parallel_tasks = 8; # Maximum concurrent Subset tasks. 0 or 1 = serial.

my $data_product = 'VIIRS';
my $desc = 'https://ncc.nesdis.noaa.gov/VIIRS,VIIRSSubset';
my $temp_directory = '/data/tmp'; # To write temporary files.
my $directory = '/data/VIIRS_NOAA'; # Contains yearly data files.
my $lister    = "$directory/listfiles";
my $temp_data_files = "$temp_directory/viirsserver_data.$$";
my $temp_files = '';
my $bindir       = '/rsig/current/code/bin/Linux.x86_64';
my $subsetter    = "$bindir/VIIRS2Subset";
my $xdrconvert   = "$bindir/XDRConvert";
my $run_parallel = "$bindir/run_parallel_swaths";
my $compressor   = "/usr/bin/gzip -c -1";
my $tar          = '/usr/bin/tar -zcO';
my $cat          = '/bin/cat';
my $xargs        = '/usr/bin/xargs';

# Output messages when REQUEST=GetMetadata.
# Print this message first:

my $metadata_content = '
NOAA VIIRS global satellite measured pollutant data accessed using RSIG.
NOAA VIIRS: https://ncc.nesdis.noaa.gov/VIIRS
RSIG: https://www.epa.gov/rsig
';

# If FORMAT=original then print this message second:

my $metadata_content_original = '
The list of original data files are shown below.

';

# Else FORMAT!=original then print this message second:

my $metadata_content_processed = '
Data processing was done using the RSIG programs VIIRS2Subset and XDRConvert.
VIIRS2Subset is used to subset (by variable, lon-lat box and time range)
and reorganize/reformat and filter the data.
XDRConvert is optionally used to regrid, aggregate and reformat the data
to other file formats.
The list of original data files and the RSIG command used to process them
are shown below.

';


my $begin_date  = '2017-07-06';
my $end_date    = '2020-03-26';
my $west_bound  = -180;
my $east_bound  = 180;
my $south_bound = -90;
my $north_bound = 90;

my @coverage_metadata  = (
  {
    name =>        'jrraod.AngsExp1',
    units =>       '-',
    description => 'Angstrom exponent for M4 vs M7 over ocean.'
  },
  {
    name =>        'jrraod.AngsExp2',
    units =>       '-',
    description => 'Angstrom exponent for M7 vs M10 over ocean.'
  },
  {
    name =>        'jrraod.AOD550',
    units =>       '-',
    description => 'Aerosol optical depth at 550 nm.'
  }
);


################################## VARIABLES #################################

# Parsed from the URL query string:

my $corners = ''; # 1 = compute corners otherwise don't (default).
my $minimum_quality = ''; # 'high' (default) or 'medium'.

################################## ROUTINES ##################################


main();


sub main {
  my $result = 0;

  # Before calling emvl::parse_url(), specify various options so the default
  # functions work:

  emvl::set_source( $data_product );
  emvl::set_coverage_metadata( \@coverage_metadata );
  emvl::set_metadata_begin_date( $begin_date );
  emvl::set_metadata_end_date( $end_date );
  emvl::set_metadata_west_bound( $west_bound );
  emvl::set_metadata_east_bound( $east_bound );
  emvl::set_metadata_south_bound( $south_bound );
  emvl::set_metadata_north_bound( $north_bound );
  emvl::append_parser( 'corners', \&parse_corners_option );
  emvl::append_parser( 'minimum_quality', \&parse_minimum_quality_option );

  if ( ! emvl::parse_url() ) {
    print "Content-type: text/plain; charset=iso-8859-1\n\n"; # For webserver
  } else {
    my $request = emvl::get_request();
    my $format = emvl::get_format();

    if ( $request eq 'getcapabilities' ) {
      print "Content-type: text/xml; charset=iso-8859-1\n\n"; # For webserver
      emvl::print_capabilities();
      $result = 1;
    } elsif ( $request eq 'describecoverage' ) {
      print "Content-type: text/xml; charset=iso-8859-1\n\n"; # For webserver
      emvl::print_coverage_description();
      $result = 1;
    } elsif ( $request eq 'getcoverage' ) {
      my $header = emvl::get_content_type_header(); # Based on parsed FORMAT.
      print "$header\n\n";
      my $command = construct_command();

      if ( $command ne '' ) {
        $result = execute_command( $command );

        if ( ! emvl::get_debugging() ) {
          unlink( $temp_files );
        }
      }
    } elsif ( $request eq 'getmetadata' ) {
      print "Content-type: text/plain; charset=iso-8859-1\n\n"; # For webserver
      my $command = construct_command();

      if ( $command ne '' ) {
        my $i = index( $command, '>' );
        my $list_files_command = substr( $command, 0, $i );
        print $metadata_content;

        if ( $format eq 'original' ) {
          print $metadata_content_original;
          $result = execute_command( $list_files_command );
          print "\n";
        } else {
          print $metadata_content_processed;
          $result = execute_command( $list_files_command );
          print "\n$command\n\n";
        }

        if ( ! emvl::get_debugging() ) {
          unlink( $temp_files );
        }
      }
    }
  }

  $result = 1 - $result; # UNIX: zero is success, non-zero is failure.
  emvl::debug( "exit result = $result" );

  # Must return some bytes to avoid 30 second timeout delay when unsuccessful:

  if ( $result != 0 ) {
    print STDOUT "\nFAILED\n";
  }

  exit $result;
}



# Parse corners option:

sub parse_corners_option {
  my $value = shift;
  my $result = 0;

  if ( $corners ne '' ) {
    print STDERR "\nRedundant CORNERS option: '$value'\n";
  } else {
    my $is_valid = $value eq '0' || $value eq '1';

    if ( ! $is_valid ) {
      print STDERR "\nInvalid CORNERS option: '$value'\n";
    } else {
      $corners = $value;
      $result = 1;
    }
  }

  return $result;
}


# Parse minimum_quality option:

sub parse_minimum_quality_option {
  my $value = shift;
  my $result = 0;

  if ( $minimum_quality ne '' ) {
    print STDERR "\nRedundant MINIMUM_QUALITY option\n";
  } else {
    my $is_valid = ( $value eq 'high' || $value eq 'medium' );

    if ( ! $is_valid ) {
      print STDERR "\nInvalid MINIMUM_QUALITY option (require high, medium)\n";
    } else {
      $minimum_quality = $value;
      $result = 1;
    }
  }

  return $result;
}



# Construct subsetter command.

sub construct_command {
  my $command = '';
  my $format = emvl::get_format();
  my $yyyymmddhh1 = emvl::get_yyyymmddhh1();
  my $hours = emvl::get_hours();
  my $west_south_east_north = emvl::get_west_south_east_north();
  my $list_command = "$lister JPSSRR-AOD $yyyymmddhh1 $hours $west_south_east_north > $temp_data_files";

  if ( $format eq 'original' ) {
    $command = "$list_command ; $cat $temp_data_files | $xargs $tar";
  } else {
    my $my_xdrconvert = '';
    my $regrid = emvl::get_regrid();

    if ( $regrid ne '' || $format ne 'xdr' ) {
      my $regrid_args = emvl::xdrconvert_regrid_args( 0 );
      my $xdrconvert_format = emvl::xdrconvert_format();
      $my_xdrconvert = " | $xdrconvert $regrid_args -$xdrconvert_format";
    }

    my $run_parallel_option =
      $run_parallel_tasks > 1 ? "$run_parallel $run_parallel_tasks" : '';
    my $corners_option = $corners eq '1' ? '-corners' : '';
    my $minimum_quality_option =
      $minimum_quality eq '' ? '' : "-minimumQuality $minimum_quality";
    my $coverage = emvl::get_coverage();
    my @parts = split( /\./, $coverage );
    my $variable = $parts[ 1 ];
    my $my_compressor = emvl::get_compress() ? " | $compressor" : '';

    $command =
      "$list_command ; $run_parallel_option $subsetter " .
      " -tmpdir $temp_directory " .
      " -files $temp_data_files " .
      " -desc $desc " .
      " -timestamp $yyyymmddhh1 -hours $hours " .
      " -variable $variable " .
      " -domain $west_south_east_north " .
      " $corners_option " .
      " $minimum_quality_option " .
      " $my_xdrconvert $my_compressor";
  }

  return $command;
}



# Execute command and echo its output to STDOUT.
# E.g., execute_command( '/bin/ls' );

sub execute_command {
  my $command = shift;
  my $result = 0;
  my $the_pipe = 0;

  # -T flag requires untainting $command by matching a minimal regex needed for
  # system commands used by this program.

  if ( $command =~ m#^(/[\w-]+/[\w -/.;:,>'@|]+)$# )
  {
    $command = $1; # Re-assign first match, which is enough to satisfy -T.
    emvl::debug( "$0 executing command = $command" );
    %ENV = (); # Unset all environment variables prior to popen.
    # Complicated, supposedly safer way to open a readable pipe to command:
    my $pid = open( the_pipe, "-|" );

    if ( ! defined( $pid ) ) {
      die "Couldn't open pipe to subprocess";
    } elsif ( $pid ) { # Parent process.

      while ( <the_pipe> ) {
        print;
      }

      close( the_pipe );
      $result = ! $?;
    } else { # Child process.
      exec( $command ) or die "can't exec program: $!";
    }
  } else {
    print STDERR "\n$0: command contains invalid characters.\n";
  }

  return $result;
}


